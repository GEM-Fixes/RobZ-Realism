{game_entity
	(include "/properties/cannon.ext")
	{props "steel" "vehicle" "-with_gun" "transport_tow"}
	{mass 50000}
	("armor_medium" args 1.1)
	{Volume "Vehicle" {able clear}}
	{Volume "roller" {able clear}}
	{Volume "body" {able clear {contact_ground} {select} {touch}}}
	{Volume "select1" {able clear {select} {touch}} {tags "door_lock"}}
	{Volume "select2" {able clear {select} {touch}} {tags "door_lock"}}
	{Chassis "track"
		("car_trace" fx("tracks_sm") step(0.3) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracks_sm") step(0.3) wheell("wlf1") wheelr("wrf1") bonel("FXtraceL2") boner("FXtraceR2"))
		("loco_big")
	}
	{extender "cannon"
		{animation
			{switch "close"}
		}
		{move {workers clear} {obstacle "close"}}
		{attack {workers clear} {obstacle "open"}}
	}
	{placer
		{place "gunner" remove}
		{place "commander" remove}
		{place "vehicle1"
			{linkbone "vehicle1"}
		}
	}
	{Extension "towing_rope.mdl"}
}
