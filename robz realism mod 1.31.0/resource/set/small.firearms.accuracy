;SDL
; distance_1: {spreading {radiusTable}}
;   r1 - {radiusTable row 10}, [?]
;   r2 - {radiusTable row 35}, [?]
;   r3 - {radiusTable row 70}, [?]
;   e.g. ("distance_1" r1(0.385) r2(1.925) r3(4.40))
(define "distance_1"
	{spreading
		{radiusTable {0 0} {10 %r1} {35 %r2} {70 %r3}}
	}
)
; distance_flaer: {spreading {radiusTable}}
;   r1 - {radiusTable row 20}, [?]
;   r2 - {radiusTable row 40}, [?]
;   r3 - {radiusTable row 80}, [?]
;   r4 - {radiusTable row 120}, [?]
;   e.g. ("distance_flaer" r1(1.00) r2(3.00) r3(5.00) r4(7.00))
(define "distance_flaer"
	{spreading
		{radiusTable {0 0} {20 %r1} {40 %r2} {80 %r3} {120 %r4}}
	}
)
; distance_bonic_callin: {spreading {radiusTable}}
;   e.g. ("distance_bonic_callin")
(define "distance_bonic_callin"
	{spreading
		{radiusTable {0 0} {1000 0}}
	}
)
; distance_rifle: {spreading {radiusTable}}
;   r1 - {radiusTable row 15}, [?]
;   r2 - {radiusTable row 35}, [?]
;   r3 - {radiusTable row 70}, [?]
;   r4 - {radiusTable row 100}, [?]
;   r5 - {radiusTable row 130}, [?]
;   e.g. ("distance_rifle" r1(0.35) r2(0.60) r3(1.25) r4(1.75) r5(2.25))
(define "distance_rifle"
	{spreading
		{radiusTable {0 0} {15 %r1} {35 %r2} {70 %r3} {100 %r4} {130 %r5}}
	}
)
; distance_rifle_scope: {spreading {radiusTable}}
;   r1 - {radiusTable row 15}, [?]
;   r2 - {radiusTable row 35}, [?]
;   r3 - {radiusTable row 70}, [?]
;   r4 - {radiusTable row 100}, [?]
;   r5 - {radiusTable row 150}, [?]
;   e.g. ("distance_rifle_scope" r1(0.30) r2(0.45) r3(1.15) r4(1.55) r5(1.85))
(define "distance_rifle_scope"
	{spreading
		{radiusTable {0 0} {15 %r1} {35 %r2} {70 %r3} {100 %r4} {150 %r5}}
	}
)
; distance_mg: {spreading {radiusTable}}
;   r1 - {radiusTable row 20}, [?]
;   r2 - {radiusTable row 40}, [?]
;   r3 - {radiusTable row 75}, [?]
;   r4 - {radiusTable row 110}, [?]
;   r5 - {radiusTable row 130}, [?]
;   r6 - {radiusTable row 150}, [?]
;   e.g. ("distance_mg" r1(0.60) r2(0.96) r3(1.80) r4(2.90) r5(4.25) r6(5.5))
(define "distance_mg"
	{spreading
		{radiusTable {0 0} {20 %r1} {40 %r2} {75 %r3} {110 %r4} {130 %r5} {150 %r6}}
	}
)
; distance_at: {spreading {radiusTable}}
;   r1 - {radiusTable row 20}, [?]
;   r2 - {radiusTable row 40}, [?]
;   r3 - {radiusTable row 80}, [?]
;   r4 - {radiusTable row 120}, [?]
;   e.g. ("distance_at" r1(0.25) r2(0.50) r3(1.00) r4(1.50))
(define "distance_at"
	{spreading
		{radiusTable {0 0} {20 %r1} {40 %r2} {80 %r3} {120 %r4}}
	}
)
; distance_2: {spreading {radiusTable}}
;   r1 - {radiusTable row 15}, [?]
;   r2 - {radiusTable row 40}, [?]
;   r3 - {radiusTable row 80}, [?]
;   e.g. none in the mod (called from vanilla files)
(define "distance_2"
	{spreading
		{radiusTable {0 0} {15 %r1} {40 %r2} {80 %r3}}
	}
)
; distance_3: {spreading {radiusTable}}
;   r1 - {radiusTable row 30}, [?]
;   r2 - {radiusTable row 60}, [?]
;   r3 - {radiusTable row 90}, [?]
;   e.g. ("distance_3" r1(0.10) r2(0.10) r3(0.10))
(define "distance_3"
	{spreading
		{radiusTable {0 0} {30 %r1} {60 %r2} {90 %r3}}
	}
)
; accuracy_flaer: calls "distance_flaer"
;   e.g. none in the mod (called from vanilla files)
(define "accuracy_flaer"
	("distance_flaer" r1(1.00) r2(3.00) r3(5.00) r4(7.00))
)

; accuracy_flaer_240: calls "distance_bonic_callin"
