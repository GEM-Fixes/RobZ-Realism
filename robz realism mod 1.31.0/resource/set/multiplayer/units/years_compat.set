	{"%name(%side)"
   		{charge %c}
		{content "%c2 ( mp/%side/vehicle_supporter:2 )"} ;%c1 ( mp/%side/vehicle_supporter:2 )
		{tags "%side %t"}
		{group "%g"}
		{button "%b"}
		{level %level}
		{cost %cost}
		{fore %f}
		{info %c2}
	}
)
