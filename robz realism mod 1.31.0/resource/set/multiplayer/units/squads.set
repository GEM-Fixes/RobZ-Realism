;----- Squads -----




;같컂eneric같�

; generic_vi: buy-card fields, {charge} {tags "%t"} {group "%g"} {button "%b"}
;   c - {charge}, [?]
;   t - name of {tags}
;   g - name of {group}
;   b - name of {button}
;   e.g. ("generic_vi" c(%c) t(%t %s) g(%g) i(%i) b(%b))
(define "generic_vi"
	{charge %c}
	{tags "%t"}
	{group "%g"}
	{button "%b"}
)

; generic_i_sequence: buy-card fields, {charge} {tags "%t"} {group "%g"} {button "%b"} {icon}
;   c - {charge}, [?]
;   t - name of {tags}
;   g - name of {group}
;   b - name of {button}
;   i - {icon}, [?]
;   e.g. none (not called)
(define "generic_i_sequence"
	{charge %c}
	{tags "%t"}
	{group "%g"}
	{button "%b"}
	{icon %i}
)

;같캫echanized infantry같�
; vb3: {content "%c1 ( mp/%s/ost_jager_sa:%n1 mp/%s/ost_jager_stg:%n2 mp/%s/ost_jager_smg:%n3)"}, calls "generic_vi"
;   c - {charge}, [?] via "generic_vi"
;   t - name of {tags} via "generic_vi"
;   s - name of {tags} via "generic_vi", text in {content}
;   g - name of {group} via "generic_vi"
;   i - i() of "generic_vi"
;   b - name of {button} via "generic_vi"
;   c1 - text in {content}
;   n1 - text in {content}
;   n2 - text in {content}
;   n3 - text in {content}
;   e.g. none in the mod (called from vanilla files)
(define "vb3"
	("generic_vi" c(%c) t(%t %s) g(%g) i(%i) b(%b))
	{content "%c1 ( mp/%s/ost_jager_sa:%n1 mp/%s/ost_jager_stg:%n2 mp/%s/ost_jager_smg:%n3)"}
)

; vb3_usa: {content "%c1 ( mp/%s/usa_ranger_springfield:%n1 mp/%s/usa_ranger_barassist:%n2 mp/%s/usa_ranger_bar:%n3)"}, calls "generic_vi"
;   c - {charge}, [?] via "generic_vi"
;   t - name of {tags} via "generic_vi"
;   s - name of {tags} via "generic_vi", text in {content}
;   g - name of {group} via "generic_vi"
;   i - i() of "generic_vi"
;   b - name of {button} via "generic_vi"
;   c1 - text in {content}
;   n1 - text in {content}
;   n2 - text in {content}
;   n3 - text in {content}
;   e.g. none (not called)
(define "vb3_usa"
	("generic_vi" c(%c) t(%t %s) g(%g) i(%i) b(%b))
	{content "%c1 ( mp/%s/usa_ranger_springfield:%n1 mp/%s/usa_ranger_barassist:%n2 mp/%s/usa_ranger_bar:%n3)"}
)

; vb4: {content "%c1 ( mp/%s/sturmovik:%n1 mp/%s/sturmovik2:%n2 mp/%s/sturmovik3:%n3 mp/%s/sturmovik4:%n4 )"}, calls "generic_vi"
;   c - {charge}, [?] via "generic_vi"
;   t - name of {tags} via "generic_vi"
;   s - name of {tags} via "generic_vi", text in {content}
;   g - name of {group} via "generic_vi"
;   i - i() of "generic_vi"
;   b - name of {button} via "generic_vi"
;   c1 - text in {content}
;   n1 - text in {content}
;   n2 - text in {content}
;   n3 - text in {content}
;   n4 - text in {content}
;   e.g. none in the mod (called from vanilla files)
(define "vb4"
	("generic_vi" c(%c) t(%t %s) g(%g) i(%i) b(%b))
	{content "%c1 ( mp/%s/sturmovik:%n1 mp/%s/sturmovik2:%n2 mp/%s/sturmovik3:%n3 mp/%s/sturmovik4:%n4 )"}
)
; vb6: {content "%c1 ( mp/%s/%n1 mp/%s/%n2 mp/%s/%n3 mp/%s/%n4 mp/%s/%n5 mp/%s/%n6 )"}, calls "generic_vi"
;   c - {charge}, [?] via "generic_vi"
;   t - name of {tags} via "generic_vi"
;   s - name of {tags} via "generic_vi", text in {content}
;   g - name of {group} via "generic_vi"
;   i - i() of "generic_vi"
;   b - name of {button} via "generic_vi"
;   c1 - text in {content}
;   n1 - text in {content}
;   n2 - text in {content}
;   n3 - text in {content}
;   n4 - text in {content}
;   n5 - text in {content}
;   n6 - text in {content}
;   e.g. none (not called)
(define "vb6"
	("generic_vi" c(%c) t(%t %s) g(%g) i(%i) b(%b))
	{content "%c1 ( mp/%s/%n1 mp/%s/%n2 mp/%s/%n3 mp/%s/%n4 mp/%s/%n5 mp/%s/%n6 )"}
)


;같캳quads define같�
; i_seq_with1types: {"%name(%side)" {charge} {content} {tags} {group} ..}
;   name - block name
;   side - block name, text in {content}, text in {tags}
;   c - {charge}, [?]
;   c1 - text in {content}
;   c2 - text in {content}
;   t - text in {tags}
;   g - name of {group}
;   b - name of {button}
;   level - {level}, [?]
;   cost - {cost}, [?]
;   f - {fore}, [?]
;   i - {icon}, [?]
;   e.g. none (not called)
(define "i_seq_with1types"
	{"%name(%side)"
		{charge %c}
		{content "mp/%side/%c1 mp/%side/%c2"}
		{tags "frontline_cp infantry %side %t"}
		{group "%g"}
		{button "%b"}
		{level %level}
		{cost %cost}
		{fore %f}
		{icon %i}
	}
)

