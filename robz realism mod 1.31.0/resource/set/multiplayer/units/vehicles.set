; vs_seq_rom: {content "%v1 ( mp/%s/axm_rom_vehicle_supporter:%n1)"}, calls "generic_v_sequence"
;   c - {charge}, [?] via "generic_v_sequence"
;   sc - {score}, [?] via "generic_v_sequence"
;   t - name of {tags} via "generic_v_sequence"
;   s - name of {tags} via "generic_v_sequence", text in {content}
;   g - name of {group} via "generic_v_sequence"
;   b - name of {button} via "generic_v_sequence"
;   cw - {cw}, [?] via "generic_v_sequence"
;   cp - {cp}, [?] via "generic_v_sequence"
;   i - {icon}, [?] via "generic_v_sequence"
;   v1 - text in {content}
;   n1 - text in {content}
;   e.g. none (not called)
(define "vs_seq_rom"
	("generic_v_sequence" c(%c) sc(%sc) t(%t %s) g(%g) b(%b) cw(%cw) cp(%cp) i(%i))
	{content "%v1 ( mp/%s/axm_rom_vehicle_supporter:%n1)"}
)


