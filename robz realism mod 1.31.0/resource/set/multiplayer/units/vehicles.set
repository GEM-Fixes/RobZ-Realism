;   t - text in {tags}
;   g - name of {group}
;   b - name of {button}
;   level - {level}, [?]
;   cost - {cost}, [?]
;   f - {fore}, [?]
;   e.g. none in the mod (called from vanilla files)
(define "how"
	{"%name"
		{charge %c}
		{content "%c1 ( mp/%side/vehicle_supporter:2 ) %c2 ( mp/%side/vehicle_supporter:2 )"}
		{tags "%side %t"}
		{group "%g"}
		{button "%b"}
		{level %level}
		{cost %cost}
		{fore %f}
	}
)

