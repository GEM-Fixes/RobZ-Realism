; extra unit
; extra: calls "generic_x"
;   sc - {score}, [?] via "generic_x"
;   t - name of {tags} via "generic_x"
;   s - name of {tags} via "generic_x"
;   cw - {cw}, [?] via "generic_x"
;   cp - {cp}, [?] via "generic_x"
;   e.g. ("extra" t() sc(0) cw(0) cp(0))
(define "extra"
	("generic_x" sc(%sc) t(%t %s) cw(%cw) cp(%cp))
)



;같캦owitzer같�


; 1 howitzer italy
; ita_how: {"%name" {charge} {content} {tags} {group} ..}
;   name - block name
;   c - {charge}, [?]
;   c1 - text in {content}
;   side - text in {content}, text in {tags}
;   c2 - text in {content}
;   t - text in {tags}
;   g - name of {group}
;   b - name of {button}
;   level - {level}, [?]
;   cost - {cost}, [?]
;   f - {fore}, [?]
;   e.g. none (not called)
(define "ita_how"
	{"%name"
		{charge %c}
		{content "%c1 ( mp/%side/axm_ita_vehicle_supporter:1 ) %c2 ( mp/%side/axm_ita_vehicle_supporter:2 )"}
		{tags "%side %t"}
		{group "%g"}
		{button "%b"}
		{level %level}
		{cost %cost}
		{fore %f}
	}
)

