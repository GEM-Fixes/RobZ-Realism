;----- Vehicles -----




;같컂eneric같�

; generic_v_sequence: buy-card fields, {charge} {score} {tags "%t"} {group "%g"} {button "%b"} {icon} +2 more
;   c - {charge}, [?]
;   sc - {score}, [?]
;   t - name of {tags}
;   g - name of {group}
;   b - name of {button}
;   i - {icon}, [?]
;   cw - {cw}, [?]
;   cp - {cp}, [?]
;   e.g. ("generic_v_sequence" c(%c) sc(%sc) t(%t %s) g(%g) b(%b) cw(%cw) cp(%cp) i(%i))
(define "generic_v_sequence"
	{charge %c}
	{score %sc}
	{tags "%t"}
	{group "%g"}
	{button "%b"}
	{icon %i}
	{cw %cw}
	{cp %cp}
)

; generic_v: buy-card fields, {charge} {score} {tags "%t"} {group "%g"} {button "%b"} {cw} +1 more
;   c - {charge}, [?]
;   sc - {score}, [?]
;   t - name of {tags}
;   g - name of {group}
;   b - name of {button}
;   cw - {cw}, [?]
;   cp - {cp}, [?]
;   e.g. ("generic_v" c(%c) sc(%sc) t(%t %s) g(%g) b(%b) cw(%cw) cp(%cp))
(define "generic_v"
	{charge %c}
	{score %sc}
	{tags "%t"}
	{group "%g"}
	{button "%b"}
	{cw %cw}
	{cp %cp}
)

; generic_h: buy-card fields, {charge} {tags "%t"} {group "%g"} {button "%b"}
;   c - {charge}, [?]
;   t - name of {tags}
;   g - name of {group}
;   b - name of {button}
;   e.g. ("generic_h" c(%c) t(%t %s) g(%g) b(%b))
(define "generic_h"
	{charge %c}
	{tags "%t"}
	{group "%g"}
	{button "%b"}
)

; generic_x: buy-card fields, {score} {tags "%t"} {cw} {cp}
;   sc - {score}, [?]
;   t - name of {tags}
;   cw - {cw}, [?]
;   cp - {cp}, [?]
;   e.g. ("generic_x" sc(%sc) t(%t %s) cw(%cw) cp(%cp))
(define "generic_x"
	{score %sc}
	{tags "%t"}
	{cw %cw}
	{cp %cp}
)



