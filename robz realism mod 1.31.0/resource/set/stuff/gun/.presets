	)
)



; accuracy_curve_direct_howitz: spread table {radiusTable} per ammo type: x multiplier at 0/50/90/120/150 m, *_acc at the last aimed range +3 m, 60 from +5 m
;   max_dist - last aimed range, m (spread 60 from +5 m)
;   r1 - spread multiplier of the curve (smaller = more accurate)
;   radius_table - value of {50}
;   heat - spread multiplier for HEAT shells
;   ap_acc - spread factor (x the multiplier) at the last aimed range for AP shells
;   fg_acc - spread factor (x the multiplier) at the last aimed range for HE/WP shells
;   e.g. ("accuracy_curve_direct_howitz" max_dist(180) r1(%r1) radius_table(%ap) heat(%heat) ap_acc(2.37) fg_acc(2.9))
(define "accuracy_curve_direct_howitz"
	{spreading
		{radiusTable {0 0} {50 (* 0.45 %radius_table)} {90 (* 1.35 %radius_table)} {120 (* 1.80 %radius_table)} {150 (* 2.25 %radius_table)} {(+ %max_dist 3) (* %ap_acc %radius_table)} {(+ %max_dist 5) 60}}
	}
	{parameters "apc"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %radius_table)} {90 (* 1.35 %radius_table)} {120 (* 1.80 %radius_table)} {150 (* 2.25 %radius_table)} {(+ %max_dist 3) (* %ap_acc %radius_table)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "apcr"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.05 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist 3) (* %fg_acc %r1)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "heat"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %heat)} {90 (* 1.50 %heat)} {120 (* 2.05 %heat)} {150 (* 2.50 %heat)} {(+ %max_dist 3) (* %fg_acc %heat)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "heata"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %heat)} {90 (* 1.50 %heat)} {120 (* 2.05 %heat)} {150 (* 2.50 %heat)} {(+ %max_dist 3) (* %fg_acc %heat)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "heatb"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %heat)} {90 (* 1.50 %heat)} {120 (* 2.05 %heat)} {150 (* 2.50 %heat)} {(+ %max_dist 3) (* %fg_acc %heat)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "heatc"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %heat)} {90 (* 1.50 %heat)} {120 (* 2.05 %heat)} {150 (* 2.50 %heat)} {(+ %max_dist 3) (* %fg_acc %heat)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "fg"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.05 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist 3) (* %fg_acc %r1)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "wp"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.05 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist 3) (* %fg_acc %r1)} {(+ %max_dist 5) 60}}
		}
	}
)

; accuracy_curve_direct_howitz_anti_far: spread table {radiusTable} per ammo type: x multiplier at 0/50/90/120/150 m, *_acc at the last aimed range +3 m, 60 from +5 m; HE/WP/HEAT start at 20 at 0 m (see the table above)
