; accuracy_curve_gun: spread table {radiusTable} per ammo type: x multiplier at 0/50/90/120/150 m, *_acc at the last aimed range +3 m, 40 from +5 m
;   max_dist_ap - last aimed range of AP-type shells, m (spread 40 from +5 m)
;   max_dist_fg - last aimed range of HE/WP shells, m (spread 40 from +5 m)
;   r1 - spread multiplier of the curve (smaller = more accurate)
;   ap_acc - spread factor (x the multiplier) at the last aimed range for AP shells
;   apc_acc - spread factor (x the multiplier) at the last aimed range for APC shells
;   apcbc_acc - spread factor (x the multiplier) at the last aimed range for APBC/APHEBC/APCBC/BR-350 shells
;   hvap_acc - spread factor (x the multiplier) at the last aimed range for HVAP shells
;   apcr_acc - spread factor (x the multiplier) at the last aimed range for APCR shells
;   heat_acc - spread factor (x the multiplier) at the last aimed range for HEAT shells
;   apds_acc - spread factor (x the multiplier) at the last aimed range for APDS shells
;   fg_acc - spread factor (x the multiplier) at the last aimed range for HE/WP shells
;   e.g. ("accuracy_curve_gun" max_dist_ap(270) max_dist_fg(270) r1(%r1) ap_acc(3.16) apc_acc(3.25) apcbc_acc(3.05) hvap_acc(3.00) apcr_acc(3.16) heat_acc(4.14) apds_acc(5.42) fg_acc(3.32))
(define "accuracy_curve_gun"
	{spreading
		{radiusTable {0 0} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.00 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist_ap 3) (* %ap_acc %r1)} {(+ %max_dist_ap 5) 40}}
	}
	{parameters "apc"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.15 %r1)} {150 (* 2.65 %r1)} {(+ %max_dist_ap 3) (* %apc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apbc"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "aphebc"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apcbc"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "br350a"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "br350b"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "br350sp"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apcr"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.00 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist_ap 3) (* %apcr_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "hvap"
		{spreading
			{radiusTable {0 0} {50 (* 0.40 %r1)} {90 (* 1.40 %r1)} {120 (* 1.85 %r1)} {150 (* 2.35 %r1)} {(+ %max_dist_ap 3) (* %hvap_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heat"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heata"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heatb"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heatc"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apds"
		{spreading
			{radiusTable {0 0} {50 (* 0.60 %r1)} {90 (* 1.60 %r1)} {120 (* 2.25 %r1)} {150 (* 2.90 %r1)} {(+ %max_dist_ap 3) (* %apds_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "fg"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.10 %r1)} {150 (* 2.60 %r1)} {(+ %max_dist_fg 3) (* %fg_acc %r1)} {(+ %max_dist_fg 5) 40}}
		}
		{gravity 10}
	}
	{parameters "wp"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.10 %r1)} {150 (* 2.60 %r1)} {(+ %max_dist_fg 3) (* %fg_acc %r1)} {(+ %max_dist_fg 5) 40}}
		}
		{gravity 10}
	}
)

; accuracy_curve_gun_anti_far: spread table {radiusTable} per ammo type: x multiplier at 0/50/90/120/150 m, *_acc at the last aimed range +3 m, 40 from +5 m; HE/WP start at 20 at 0 m (see the table above)
;   max_dist_ap - last aimed range of AP-type shells, m (spread 40 from +5 m)
;   max_dist_fg - last aimed range of HE/WP shells, m (spread 40 from +5 m)
;   r1 - spread multiplier of the curve (smaller = more accurate)
;   ap_acc - spread factor (x the multiplier) at the last aimed range for AP shells
;   apc_acc - spread factor (x the multiplier) at the last aimed range for APC shells
;   apcbc_acc - spread factor (x the multiplier) at the last aimed range for APBC/APHEBC/APCBC/BR-350 shells
;   hvap_acc - spread factor (x the multiplier) at the last aimed range for HVAP shells
;   apcr_acc - spread factor (x the multiplier) at the last aimed range for APCR shells
;   heat_acc - spread factor (x the multiplier) at the last aimed range for HEAT shells
;   apds_acc - spread factor (x the multiplier) at the last aimed range for APDS shells
;   fg_acc - spread factor (x the multiplier) at the last aimed range for HE/WP shells
;   e.g. ("accuracy_curve_gun_anti_far" max_dist_ap(260) max_dist_fg(260) r1(%r1) ap_acc(3.105) apc_acc(3.2) apcbc_acc(3.0) hvap_acc(2.95) apcr_acc(3.105) heat_acc(4.07) apds_acc(5.21) fg_acc(3.14))
(define "accuracy_curve_gun_anti_far"
	{spreading
		{radiusTable {0 0} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.00 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist_ap 3) (* %ap_acc %r1)} {(+ %max_dist_ap 5) 40}}
	}
	{parameters "apc"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.15 %r1)} {150 (* 2.65 %r1)} {(+ %max_dist_ap 3) (* %apc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apbc"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "aphebc"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apcbc"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "br350a"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "br350b"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "br350sp"
		{spreading
			{radiusTable {0 0} {50 (* 0.45 %r1)} {90 (* 1.45 %r1)} {120 (* 1.95 %r1)} {150 (* 2.45 %r1)} {(+ %max_dist_ap 3) (* %apcbc_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apcr"
		{spreading
			{radiusTable {0 0} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.00 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist_ap 3) (* %apcr_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "hvap"
		{spreading
			{radiusTable {0 0} {50 (* 0.40 %r1)} {90 (* 1.40 %r1)} {120 (* 1.85 %r1)} {150 (* 2.35 %r1)} {(+ %max_dist_ap 3) (* %hvap_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heat"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heata"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heatb"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "heatc"
		{spreading
			{radiusTable {0 0} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.20 %r1)} {150 (* 2.80 %r1)} {(+ %max_dist_ap 3) (* %heat_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "apds"
		{spreading
			{radiusTable {0 0} {50 (* 0.60 %r1)} {90 (* 1.60 %r1)} {120 (* 2.25 %r1)} {150 (* 2.90 %r1)} {(+ %max_dist_ap 3) (* %apds_acc %r1)} {(+ %max_dist_ap 5) 40}}
		}
	}
	{parameters "fg"
		{spreading
			{radiusTable {0 20} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.10 %r1)} {150 (* 2.60 %r1)} {(+ %max_dist_fg 3) (* %fg_acc %r1)} {(+ %max_dist_fg 5) 40}}
		}
		{gravity 10}
	}
	{parameters "wp"
		{spreading
			{radiusTable {0 20} {50 (* 0.65 %r1)} {90 (* 1.65 %r1)} {120 (* 2.10 %r1)} {150 (* 2.60 %r1)} {(+ %max_dist_fg 3) (* %fg_acc %r1)} {(+ %max_dist_fg 5) 40}}
		}
		{gravity 10}
	}
)

; accuracy_curve_270m: spread curve "accuracy_curve_gun": AP-type aimed to 270 m, HE to 270 m (row in the accuracy table above)
;   r1 - spread multiplier of the curve (smaller = more accurate)
;   e.g. ("accuracy_curve_270m" r1(0.875))
(define "accuracy_curve_270m"
	("accuracy_curve_gun"
		max_dist_ap(270) max_dist_fg(270) r1(%r1) ap_acc(3.16) apc_acc(3.25) 		;*1.1,,, increase per 10m::: 0.055 ; 0.05
		apcbc_acc(3.05) hvap_acc(3.00) apcr_acc(3.16) heat_acc(4.14) apds_acc(5.42) fg_acc(3.32)	;			0.05 ; 0.055 ; 0.07 ; 0.21 ; 0.06
	)
)
