; range_autocannon: "accuracy_zenite_high"; sets {spreading} {SpreadTolerance} {range} {RelaxationTime} {gravity}
;   e.g. ("range_autocannon") (no call in the mod)
(define "range_autocannon"
	("accuracy_zenite_high")
	{spreading 1
		{SpreadPower	1}
		{BurstAccuracy 100 90 80 70 60 50 35}
	}
	{SpreadTolerance 0.6}

	{range 110 110}

	{RelaxationTime 1}
	{gravity 1.5}
)

; range_zenite: "accuracy_zenite_low"; sets {spreading} {SpreadTolerance} {range} {cursor} {cursorReloading} {RelaxationTime} {gravity}; per-ammo {parameters} fg
;   e.g. ("range_zenite")
(define "range_zenite"
	("accuracy_zenite_low")
	{spreading 1
		{BurstRecoveryTime 0.6}
		{SpreadPower	1}
		{BurstAccuracy 100 90 80 70 60 50 35}
	}
	{SpreadTolerance 0.8}

	{range 160 160}
	{cursor "zenite_on"}
	{cursorReloading "zenite_reload"}
	{parameters "fg"
		{cursor "cannon_on_fg"}
		{cursorReloading "cannon_reload_fg"}
		{range 150 150}
	}

	{RelaxationTime 1}
	{gravity 1.5}
)

