		max_dist_ap(200) max_dist_fg(200) r1(%r1) ap_acc(2.775) apc_acc(2.9) 		;*0.5
		apcbc_acc(2.7) hvap_acc(2.65) apcr_acc(2.775) heat_acc(3.65) apds_acc(3.95) fg_acc(2.90)    	; 150 to 250 is 100. 150 to 180 is 30; 30/100 = 0.3, .50 is the accuracy diff
	)												;0.3*0.50 = fg_acc(3.15)
)												;150 - 175 - 200 - 225 - 250 range
;0.0 - 0.25- 0.5 - 0.75- 1.0 % of range
;3.0 -3.125- 3.25-3.375- 3.5 fg_acc
; accuracy_curve_190m: spread curve "accuracy_curve_gun": AP-type aimed to 190 m, HE to 170 m (row in the accuracy table above)
;   r1 - spread multiplier of the curve (smaller = more accurate)
;   e.g. ("accuracy_curve_190m" r1(1.30))
(define "accuracy_curve_190m"
	("accuracy_curve_gun"
		max_dist_ap(190) max_dist_fg(170) r1(%r1) ap_acc(2.72) apc_acc(2.85) 		;*0.4
		apcbc_acc(2.65) hvap_acc(2.60) apcr_acc(2.72) heat_acc(3.58) apds_acc(3.74) fg_acc(2.72)
	)
)
