{curve "gun_std"}


(include "/properties/robz/weapon.inc")
; speed_lowarc: {speed} = 0.33 x the value (projectile speed)
;   mps - projectile speed, m/s (callers pass the real muzzle velocity)
;   e.g. ("speed_lowarc" mps(472))
(define "speed_lowarc"
	{speed (* 0.33 %mps)}
)

; speed_all: {speed} per ammo type: base and every {parameters} block (AP-type, APCR-type, HEAT, HE/WP)
;   speed - value of {speed}
;   apcr - projectile speed of the APCR/APDS/HVAP shells, m/s
;   fg - projectile speed of the HE/WP shells, m/s
;   heat - projectile speed of the HEAT shells, m/s
;   e.g. ("speed_all" speed(475) apcr(475) fg(472) heat(495))
(define "speed_all"
	{speed (* 1.0 %speed)}
	{parameters "apc"
		{speed (* 1.0 %speed)}
	}
	{parameters "apbc"
		{speed (* 1.0 %speed)}
	}
	{parameters "aphebc"
		{speed (* 1.0 %speed)}
	}
	{parameters "apcbc"
		{speed (* 1.0 %speed)}
	}
	{parameters "br350a"
		{speed (* 1.0 %speed)}
	}
	{parameters "br350b"
		{speed (* 1.0 %speed)}
	}
	{parameters "br350sp"
		{speed (* 1.0 %speed)}
	}
	{parameters "heat_shell"
		{speed (* 1.0 %heat)}
	}
	{parameters "heat"
		{speed (* 1.0 %heat)}
	}
	{parameters "heata"
		{speed (* 1.0 %heat)}
	}
	{parameters "heatb"
		{speed (* 1.0 %heat)}
	}
	{parameters "heatc"
		{speed (* 1.0 %heat)}
	}
	{parameters "apcr"
		{speed (* 1.0 %apcr)}
	}
	{parameters "apds"
		{speed (* 1.0 %apcr)}
	}
	{parameters "hvap"
		{speed (* 1.0 %apcr)}
	}
	{parameters "fg"
		{speed (* 1.0 %fg)}
	}
	{parameters "wp"
		{speed (* 1.0 %fg)}
	}

)



; damage: projectileDamageTable (penetration by range): points at 20/100/170/215/250 m, 0 from 255 m
;   a - damage (penetration) at 20 m
;   b - damage (penetration) at 100 m
;   c - damage (penetration) at 170 m
;   d - damage (penetration) at 215 m
;   e - damage (penetration) at 250 m
;   e.g. ("damage" a(91) b(77) c(66) d(55) e(46))
(define "damage"            ;changed the scale to simulate close range tank combat where penetration remains high at shorter distances
	{projectileDamageTable {20 %a} {100 %b} {170 %c} {215 %d} {250 %e} {255 0} }
;{projectileDamageTable {15 %a} {80 %b} {140 %c} {195 %d} {250 %e} {(* 250 2) (* %e 0.5)} {(* 250 4) (* %e 0)}}

;IRL range:					10m  - 500m  - 1000m - 1500m  - 2000m
;MOW range:		        	0m   - 62.5m - 125m  - 187.5m - 250m
;% of the curve				0%   - 25%   - 50%   - 75%    - 100%
;% of next meter measure:	0%   - 50%   - 66%   - 75%    - 100%
)
; damage_215: projectileDamageTable (penetration by range): points from 20 m to 215 m, the 215 m line read at max m, 0 from max+5 m
;   at20 - damage (penetration) at 20 m
;   at100 - damage (penetration) at 100 m
;   at170 - damage (penetration) at 170 m
;   at215 - damage (penetration) at 215 m
;   at250 - damage at 250 m: the 215-250 m line is read at max m (not a table point)
;   max - range where the table ends, m: damage there interpolated, 0 from max+5 m
;   e.g. ("damage_215" at20(210) at100(188) at170(164) at215(144) at250(126) max(250))
(define "damage_215"            ;changed the scale to simulate close range tank combat where penetration remains high at shorter distances
	{projectileDamageTable {20 %at20} {100 %at100} {170 %at170} {215 %at215} {%max (+ (* (/ (- 250 %max) (- 250 215)) (- %at215 %at250)) %at250)} {(+ %max 5) 0} }
)
; damage_170: projectileDamageTable (penetration by range): points from 20 m to 170 m, the 170 m line read at max m, 0 from max+5 m
;   at20 - damage (penetration) at 20 m
;   at100 - damage (penetration) at 100 m
;   at170 - damage (penetration) at 170 m
;   at215 - damage at 215 m: the 170-215 m line is read at max m (not a table point)
;   at250 - damage (penetration) at 250 m (passed by callers, not used by this body)
;   max - range where the table ends, m: damage there interpolated, 0 from max+5 m
;   e.g. ("damage_170" at20(78) at100(73) at170(67) at215(62) at250(57) max(190))
(define "damage_170"            ;changed the scale to simulate close range tank combat where penetration remains high at shorter distances
	{projectileDamageTable {20 %at20} {100 %at100} {170 %at170} {%max (+ (* (/ (- 215 %max) (- 215 170)) (- %at170 %at215)) %at215)} {(+ %max 5) 0} }
)
; damage_100: projectileDamageTable (penetration by range): points from 20 m to 100 m, the 100 m line read at max m, 0 from max+5 m
;   at20 - damage (penetration) at 20 m
;   at100 - damage (penetration) at 100 m
;   at170 - damage at 170 m: the 100-170 m line is read at max m (not a table point)
;   at215 - damage (penetration) at 215 m (passed by callers, not used by this body)
;   at250 - damage (penetration) at 250 m (passed by callers, not used by this body)
;   max - range where the table ends, m: damage there interpolated, 0 from max+5 m
;   e.g. ("damage_100" at20(46) at100(33) at170(23) at215(15) at250(11) max(160))
(define "damage_100"            ;changed the scale to simulate close range tank combat where penetration remains high at shorter distances
	{projectileDamageTable {20 %at20} {100 %at100} {%max (+ (* (/ (- 170 %max) (- 170 100)) (- %at100 %at170)) %at170)} {(+ %max 5) 0} }
)

; damage_heat: projectileDamageTable (HEAT): the same damage from 0 m to max m, 0 from max+5 m
;   damage - damage (penetration), the same from 0 m to max
;   max - range where the damage ends, m (0 from max+5 m)
;   e.g. ("damage_heat" damage(110) max(200))
(define "damage_heat"
	{projectileDamageTable {0 %damage} {%max %damage} {(+ %max 5) 0}}
)




; ---- accuracy curves (macrostd guns): every accuracy_curve_*, read from the bodies ----
; base curves (spread radius = factor x multiplier at 0/50/90/120/150 m, then *_acc x multiplier at the last aimed range +3 m):
;   accuracy_curve_gun                    guns, one block per ammo type; spread 40 from the last aimed range +5 m
;   accuracy_curve_gun_anti_far           same, but blocks fg wp start at spread 20 at 0 m instead of 0
;   accuracy_curve_direct_howitz          direct-fire howitzers: AP/APC x ap, HEAT x heat, APCR/HE/WP x r1; spread 60 from +5 m
;   accuracy_curve_direct_howitz_anti_far same, but blocks heat heata heatb heatc fg wp start at spread 20 at 0 m
;   accuracy_curve_2 / accuracy_curve_3   fixed tables to 250 m / 800 m, no range cut
; suffixes (R = the <R>m in the name; HE = max_dist_fg, AP = max_dist_ap = R):
;   <R>m           AP-type shells aimed to R m, HE to R / R-20 (as found)
;   _10m_he        HE aimed to R-10
;   _20m_he_elite  HE aimed to R-20, fg_acc as the _10m_he curve [I] elite crews
;   _vet           HE aimed to R (the full range) [I] veteran crews: the name says so, the body only moves the HE range
;   _17pdr         HE aimed to R-10, apds_acc about 1.6x (APDS spread worse at range) [I] 17pdr APDS
;   _anti_far      calls the *_anti_far base (spread 20 at 0 m, see above) [I] the name suggests a far-shooting fix; the body only changes that 0 m spread
;   order in names: accuracy_curve_[direct_howitz_]<R>m[_10m_he|_20m_he_elite|_vet|_17pdr][_anti_far]
; accuracy_<quality>[_<R>m][suffix] below = one curve with a fixed multiplier r1 (zenite_low 1.30 ... max 0.875)
;   curve                                       base                                   AP m  HE m  fg_acc  apds_acc / ap_acc
;   accuracy_curve_gun                          (base)
;   accuracy_curve_gun_anti_far                 (base)
;   accuracy_curve_270m                         accuracy_curve_gun                     270   270   3.32    5.42
;   accuracy_curve_260m                         accuracy_curve_gun                     260   260   3.14    5.21
;   accuracy_curve_260m_anti_far                accuracy_curve_gun_anti_far            260   260   3.14    5.21
;   accuracy_curve_260m_10m_he                  accuracy_curve_gun                     260   250   3.20    5.21
;   accuracy_curve_260m_10m_he_anti_far         accuracy_curve_gun_anti_far            260   250   3.20    5.21
;   accuracy_curve_250m_vet                     accuracy_curve_gun                     250   250   3.20    5.00
;   accuracy_curve_250m_vet_anti_far            accuracy_curve_gun_anti_far            250   250   3.20    5.00
;   accuracy_curve_250m                         accuracy_curve_gun                     250   230   3.08    5.00
;   accuracy_curve_250m_anti_far                accuracy_curve_gun_anti_far            250   230   3.08    5.00
;   accuracy_curve_250m_17pdr                   accuracy_curve_gun                     250   240   3.14    8.00
;   accuracy_curve_250m_10m_he                  accuracy_curve_gun                     250   240   3.14    5.00
;   accuracy_curve_250m_10m_he_anti_far         accuracy_curve_gun_anti_far            250   240   3.14    5.00
;   accuracy_curve_240m                         accuracy_curve_gun                     240   220   3.02    4.79
;   accuracy_curve_240m_17pdr                   accuracy_curve_gun                     240   230   3.08    7.53
;   accuracy_curve_240m_10m_he                  accuracy_curve_gun                     240   230   3.08    4.79
;   accuracy_curve_240m_vet                     accuracy_curve_gun                     240   240   3.14    4.79
;   accuracy_curve_230m                         accuracy_curve_gun                     230   210   2.96    4.58
;   accuracy_curve_230m_17pdr                   accuracy_curve_gun                     230   220   3.02    7.06
;   accuracy_curve_230m_10m_he                  accuracy_curve_gun                     230   220   3.02    4.58
;   accuracy_curve_230m_vet                     accuracy_curve_gun                     230   230   3.08    4.58
;   accuracy_curve_220m                         accuracy_curve_gun                     220   200   2.90    4.37
;   accuracy_curve_220m_10m_he                  accuracy_curve_gun                     220   210   2.96    4.37
;   accuracy_curve_220m_vet                     accuracy_curve_gun                     220   220   3.02    4.37
;   accuracy_curve_210m                         accuracy_curve_gun                     210   190   2.84    4.16
;   accuracy_curve_210m_10m_he                  accuracy_curve_gun                     210   200   2.90    4.16
;   accuracy_curve_210m_20m_he_elite            accuracy_curve_gun                     210   190   2.90    4.16
;   accuracy_curve_210m_vet                     accuracy_curve_gun                     210   210   2.96    4.16
;   accuracy_curve_200m                         accuracy_curve_gun                     200   180   2.78    3.95
;   accuracy_curve_200m_10m_he                  accuracy_curve_gun                     200   190   2.84    3.95
;   accuracy_curve_200m_vet                     accuracy_curve_gun                     200   200   2.90    3.95
;   accuracy_curve_190m                         accuracy_curve_gun                     190   170   2.72    3.74
;   accuracy_curve_190m_10m_he                  accuracy_curve_gun                     190   180   2.78    3.74
;   accuracy_curve_direct_howitz                (base)
;   accuracy_curve_direct_howitz_anti_far       (base)
;   accuracy_curve_direct_howitz_180m           accuracy_curve_direct_howitz           180   180   2.9     2.37
;   accuracy_curve_direct_howitz_180m_anti_far  accuracy_curve_direct_howitz_anti_far  180   180   2.9     2.37
;   accuracy_curve_direct_howitz_190m           accuracy_curve_direct_howitz           190   190   2.95    2.41
;   accuracy_curve_direct_howitz_190m_anti_far  accuracy_curve_direct_howitz_anti_far  190   190   2.95    2.41
;   accuracy_curve_direct_howitz_200m           accuracy_curve_direct_howitz           200   200   3.00    2.45
