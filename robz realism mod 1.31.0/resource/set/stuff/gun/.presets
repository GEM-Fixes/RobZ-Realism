		}
	}
	{parameters "heatb"
		{spreading
			{radiusTable {0 20} {50 (* 0.50 %heat)} {90 (* 1.50 %heat)} {120 (* 2.05 %heat)} {150 (* 2.50 %heat)} {(+ %max_dist 3) (* %fg_acc %heat)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "heatc"
		{spreading
			{radiusTable {0 20} {50 (* 0.50 %heat)} {90 (* 1.50 %heat)} {120 (* 2.05 %heat)} {150 (* 2.50 %heat)} {(+ %max_dist 3) (* %fg_acc %heat)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "fg"
		{spreading
			{radiusTable {0 20} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.05 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist 3) (* %fg_acc %r1)} {(+ %max_dist 5) 60}}
		}
	}
	{parameters "wp"
		{spreading
			{radiusTable {0 20} {50 (* 0.50 %r1)} {90 (* 1.50 %r1)} {120 (* 2.05 %r1)} {150 (* 2.50 %r1)} {(+ %max_dist 3) (* %fg_acc %r1)} {(+ %max_dist 5) 60}}
		}
	}
)

