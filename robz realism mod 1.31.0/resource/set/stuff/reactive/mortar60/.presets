; fg_minimum_v2: {damage {energy} {area}} x2
;   %0 - {energy}, [?], {area}, [?]
;   e.g. none (not called)
(define "fg_minimum_v2"
	; anti-tank
	{damage blastwave
		{energy (* %0 1.15)}
		{area 0.1 0.2}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.2}
		{area (* 0.5 (+ %0 5)) (* 0.9 (+ %0 5))}
	}
)

; fg_v4: {damage {energy} {area}} x2
;   %0 - {energy}, [?], {area}, [?]
;   e.g. none (not called)
(define "fg_v4"
	; anti-tank
	{damage blastwave
		{energy (* %0 1.15)}
		{area 0.4 0.5}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.2}
		{area (* 0.5 (+ %0 5)) (* 0.9 (+ %0 5))}
	}
)

; fg_medium_v4: {damage {energy} {area}} x2
;   %0 - {energy}, [?], {area}, [?]
;   e.g. none (not called)
(define "fg_medium_v4"
	; anti-tank
	{damage blastwave
		{energy (* %0 1.15)}
		{area 0.4 0.5}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.5}
		{area (* 0.7 (+ %0 5)) (* 1.1 (+ %0 5))}
	}
)

; fg_heavy_v3: {damage} x3
;   %0 - {energy}, [?], {area}, [?]
;   e.g. none (not called)
(define "fg_heavy_v3"
	; anti-tank
	{damage blastwave
		{energy %0}
		{area 1 2}
	}
	; anti-apc
	{damage add blastwave
		{energy (* %0 0.2)}
		{area 5.5 6}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.5}
		{area (* 0.65 (+ %0 5)) (* 1.0 (+ %0 5))}
	}
)
