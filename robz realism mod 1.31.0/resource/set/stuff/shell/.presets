; heavy : 4-6, [2-3, 4-6]
; medium: 3-4  [2, 3-4]
; light : 1-2  [1, 2-3]

; _tr: sets {trace}
;   args 0 (positional %0) - tracer size: trace length (and width) scale with it
;   e.g. ("_tr" args (* %0 6))
(define "_tr"
	{trace
		{view "/texture/fx/trace"
			{Light 8}
			{ScaleY 0.4}
		}
		{length (* %0 12)}
	}
)
; _tr2: sets {trace}
;   args 0 (positional %0) - tracer size: trace length (and width) scale with it
;   e.g. ("_tr2" args (* %0 6))
(define "_tr2"
	{trace
		{view "/texture/fx/trace_apcr"
			{Light 8}
			{ScaleY 0.3}
		}
		{length (* %0 12)}
	}
)

; _tr_us: sets {trace}
;   args 0 (positional %0) - tracer size: trace length (and width) scale with it
