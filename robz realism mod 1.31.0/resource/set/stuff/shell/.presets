; fg_minimum_low: HE blast: blastwave damage layers (anti-tank, anti-personnel) scaled by the filler value
;   args 0 (positional %0) - filler value (explosive energy): anti-tank energy and anti-personnel area scale with it
;   e.g. ("fg_minimum_low" args 1.8)
(define "fg_minimum_low"
	; anti-tank
	{damage blastwave
		{energy (* %0 0.8)}
		{area 0.1 0.2}
	}
	; anti-personel
	{damage add blastwave
		{energy 1}
		{area (* 0.4 (+ %0 4)) (* 0.8 (+ %0 4))}
	}
	{damage add blastwave
		{energy 0.1}
		{area (* 1 (+ %0 4)) (* 1 (+ %0 4))}
	}
;("_tr" args (* %0 5))
)

(include "/properties/robz/weapon.inc")

; fg: HE blast: blastwave damage layers (anti-tank, anti-personnel) scaled by the filler value
;   args 0 (positional %0) - filler value (explosive energy): anti-tank energy and anti-personnel area scale with it
;   e.g. ("fg" args 6.5)
(define "fg"
	; anti-tank
	{damage blastwave
		{energy (* %0 1.15)}
		{area 0.4 0.5}
	}
	; anti-personel
	{damage add blastwave
		{energy 3.6}
		{area 1.5 2}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.2}
		{area (* 0.5 (+ %0 5)) (* 0.9 (+ %0 5))}
	}
	{damage add blastwave
		{energy 0.1}
		{area (* 1.2 (+ %0 5)) (* 1.2 (+ %0 5))}
	}
;("_tr" args (* %0 6))
)

; fg_medium: HE blast: blastwave damage layers (anti-tank, anti-personnel) scaled by the filler value
;   args 0 (positional %0) - filler value (explosive energy): anti-tank energy and anti-personnel area scale with it
;   e.g. ("fg_medium" args 6.5)
(define "fg_medium"
	; anti-tank
	{damage blastwave
		{energy (* %0 1.15)}
		{area 0.8 1.0}
	}
	; anti-personel
	{damage add blastwave
		{energy 3.6}
		{area 2.5 3}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.5}
		{area (* 0.7 (+ %0 5)) (* 1.1 (+ %0 5))}
	}
	{damage add blastwave
		{energy 0.1}
		{area (* 1.3 (+ %0 5)) (* 1.3 (+ %0 5))}
	}
;("_tr" args (* %0 6))
)

; fg_heavy: HE blast: blastwave damage layers (anti-tank, anti-personnel) scaled by the filler value
;   args 0 (positional %0) - filler value (explosive energy): anti-tank energy and anti-personnel area scale with it
;   e.g. ("fg_heavy" args 6.5)
(define "fg_heavy"
	; anti-tank
	{damage blastwave
		{energy %0}
		{area 0 2}
	}
	; anti-apc
	{damage add blastwave
		{energy (* %0 0.2)}
		{area 5.5 6}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.5}
		{area (* 0.7 (+ %0 5)) (* 1.1 (+ %0 5))}
	}
	{damage add blastwave
		{energy 0.1}
		{area (* 1.3 (+ %0 5)) (* 1.3 (+ %0 5))}
	}
;("_tr" args (* %0 6))
)

; ---- design table (author, "tings to do.txt" line 695): fg_maximum note, copied as written ----
; fg_maximum max damage = fg_value, area *0,75; 1		mid damage =  %0*0,45

; fg_maximum: HE blast: blastwave damage layers (anti-tank, anti-personnel) scaled by the filler value
;   args 0 (positional %0) - filler value (explosive energy): anti-tank energy and anti-personnel area scale with it
;   e.g. ("fg_maximum" args 21)
(define "fg_maximum"
	; anti-tank
	{damage blastwave
		{energy %0}
		{area 0 2.5}
	}
	; anti-apc
	{damage add blastwave
		{energy (* %0 0.45)}
		{area (* %0 0.3) (* %0 0.5)}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.5}
		{area (* 0.65 (+ %0 5)) (* 0.95 (+ %0 5))}
	}
	{damage add blastwave
		{energy 0.1}
		{area (* 1.2 (+ %0 5)) (* 1.2 (+ %0 5))}
	}
;("_tr" args (* %0 6))
)

; heat_dmg: sets {damage}
;   args 0 (positional %0) - value of {energy}
;   e.g. ("heat_dmg" args 6.5)
(define "heat_dmg"
	; anti-tank
	{damage blastwave
		{energy %0}
		{area 0.1 0.2}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.2}
		{area (* 0.4 (+ %0 5)) (* 0.8 (+ %0 5))}
	}
)

