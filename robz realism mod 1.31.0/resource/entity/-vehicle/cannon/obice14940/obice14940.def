{entity
	(include "/properties/cannon.ext")
	{props "vehicle" "cannon" "wheeled" "round_sandbag2" "vision_cannon_high" "muzzle_large_nodust"}
	("armor_medium")
	{PatherID  "cannon.large"}

	("wheel" args "wheelright")
	("wheel" args "wheelleft")

	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward	{end "pose_m5_gunlayer" 10}}
		}
		{anm "commander"
			{forward	{end "pose_pdr25_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon_right" 10}}
		}
	}

	{extender "inventory"
		{box
			{item "ammo bullet149_ita fg" 20}
			{item "sandbag_kit2"}
		}
	}
	{Weaponry
		{place "gun"
			{weapon "210mm_gun" filling "bullet149_ita fg" 3}
			{charger "gunner"}
			{Rotate}
			("abm_howitzer")
		}
	}
	{mass 1200}
	{Extension "obice14940.mdl"}
	(include "/properties/selection/cannon.inc"  scale(0.7))
	{bone "basis"
		{limits}
		{speed 0.005}
	}
	{bone "turret"
		{limits -10 10}
		{speed 0.0005}
	}
	{bone "gun_rot"
		{limits -45 5}
		{speed 0.0005}
	}
	(mod "mp"
		{brain
			{properties
				{fire_mode hold}
			}
		}
	)


	{extender "cannon"
		{animation
			{switch "close"}
			{move "cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim "cannon_zis3_gunlayer" ""}
			{fire  "Cannon_gunlayer_fire-alert" "Cannon_zis3_charger_fire 0.2"}
			{reload  "" "Cannon_zis3_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		(mod "mp" {rotate_ik_Limit 0})
	}
	{Chassis "track"
		("car_trace" fx("tracewheel05a") step(0.14) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("loco_big")
	}
	{bone "basis"
		{speed 0.003}
	}
}
