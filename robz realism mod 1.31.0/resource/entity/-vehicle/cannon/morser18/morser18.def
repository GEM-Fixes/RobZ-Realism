(include "/properties/robz/volumes.inc")
{entity
	(include "/properties/cannon.ext")

	{props "vehicle" "cannon" "round_sandbag2" "vision_cannon_maximum" "muzzle_maximum" "gun_mode_change_art"}
	{PatherID  "cannon.large"}
	{collider "cannon_heavy"}
	("armor_heavy")
	{placer
		{place "gunner" {visor "main"} {useVision 0}}
		{place "commander" {visor "main"} {useVision 0}}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	("vol_body_plate" name(body2) mm(10))
	("vol_body_plate" name(body3) mm(10))
	("vol_body_plate" name(body4) mm(10))
	("vol_body_plate" name(body5) mm(10))
	("vol_body_plate" name(body6) mm(10))
	("vol_body_plate" name(body) mm(10))
	("vol_gun_part" name(gun2))
	("vol_gun_part" name(gun_rot))
	("vol_gun_part" name(gun))
	("vol_gun_part" name(gunback))

	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward {end "pose_155gpf_gunlayer" 10}}
		}
		{anm "commander"
			{forward {end "pose_155gpf_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon_right" 10}}
		}
	}

	{extender "inventory"
		{box
			{item "ammo bullet210" 2}
			(mod "mp"
				{item "sandbag_kit2"}
			)
		}
	}
	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "210mm_mrs18" filled}
			{charger "gunner"}
			("abm_howitzer")
		}
		{place "gun1_2"
			{type "gun_change_direct"}
			{weapon "210mm_mrs18_2" filled}
			{basic}
			{rotate}
			{charger "gunner"}
			("abm_field_gun")
		}
	}

	{mass 4000}


	{extender "cannon"
		{animation
			{switch "close"}
			{move	"cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim	"cannon_155gpf_gunlayer" ""}
			{fire	"Cannon_gunlayer_fire-alert" "cannon_zis3_charger_fire"}
			{reload	"" "Cannon_155gpf_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
	}
	{Chassis "track"
		("car_trace" fx("tracks_sm") step(0.4) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("loco_nomove")
	}
	{sensor
		{Visor "commander"
			{vision "cannon_crew"}
			{bone "commander"}
		}
	}
	{Extension "morser.mdl"}
	(include "/properties/selection/cannon.inc"  scale(0.7))
	{bone "basis"
		{speed 0.001}
	}
	{bone "gun_rot"
		{speed 0.0005}
	}
}
