(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/cannon.ext")
	{props "vehicle" "cannon" "wheeled" "round_sandbag2" "vision_cannon_maximum" "muzzle_large" "turret" "turret_rotator"}
	{PatherID  "cannon.large"}
	("armor_heavy")

	{Volume "shield"
		{tags "shield"}
		{component "shield"}
	}
	{Volume "shield1"
		{tags "shield"}
		{component "shield"}
	}
	{Volume "shield2"
		{tags "shield"}
		{component "shield"}
	}
	("vol_body_part" name(body))
	("vol_turret_part" name(turret))
	{Volume "wheell2"
	}
	{Volume "wheelleft"
	}
	{Volume "wheelr2"
	}
	{Volume "wheelright"
	}

	("wheel" args "wheelright")
	("wheel" args "wheelleft")

	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward	{end "pose_pak40_gunlayer" 10}}
		}
		{anm "commander"
			{forward	{end "pose_pak40_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon_right" 10}}
		}
	}
	{extender "inventory"
		{box
			{item "ammo bullet155_fra fg" 5}
			{item "sandbag_kit2"}
		}
	}
	{Weaponry

		{place "gun"
			{weapon "155mm_c17s" filling "ammo bullet155_fra fg" 3}
			{Rotate}
			{StationaryFiring}
			("abm_howitzer")
		}
	}
	{mass 3300}
	{Extension "155mm_mle1917_schneider.mdl"}
	(include "/properties/selection/cannon.inc"  scale(0.7))

	{extender "cannon"
		{animation
			{switch "close"}
			{move "cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim "cannon_zis3_gunlayer" ""}
			{fire  "Cannon_gunlayer_fire-alert" "Cannon_zis3_charger_fire 0.2"}
			{reload  "" "Cannon_zis3_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		(mod "mp" {rotate_ik_Limit 0})
	}

	{Chassis "track"
		("car_trace" fx("tracewheel05") step(0.07) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("loco_big")
	}

	{bone "turret"
		{limits -25 25}
		{speed 0.0003}
	}
	{bone "gun_rot"
		{limits -5 60}
		{speed 0.0003}
	}

	{Texmod "camo14"}
}
