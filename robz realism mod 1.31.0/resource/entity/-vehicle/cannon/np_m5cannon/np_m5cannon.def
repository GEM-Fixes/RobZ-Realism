(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/cannon.ext")
	{props "vehicle" "cannon" "wheeled" "round_sandbag2" "vision_cannon_high" "muzzle_medium" "big_weapons"}
	("armor_medium")
	("vol_gun_part" name(gun))
	("vol_gun_part" name(gun2))
	("vol_turret_part" name(turret1))
	("vol_turret_part" name(turret2))
	("vol_turret_part" name(turret3))
	("vol_body_part" name(body))
	("vol_body_part" name(body2))

	("wheel" args "wheelright")
	("wheel" args "wheelleft")

	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward	{end "pose_m5_gunlayer" 10}}
		}
		{anm "commander"
			{forward	{end "pose_m5_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon_right" 10}}
		}
	}
	("us_5x_sight_no_visor1")
	{extender "inventory"
		{box
			{item "bullet76 us ap" 4}
			{item "bullet76 us apcbc" 5}
			{item "bullet76 us fg" 5}
			{item "bullet76 us hvap" 4}
			{item "sandbag_kit2"}
		}
	}
	{Weaponry

		{place "gun"
			{weapon "76mm_m5" filling "bullet76 us apcbc" 1}

			{Rotate}
			("abm_field_gun")
		}
	}
	{mass 2215}
	{Extension "m5.mdl"}
	(include "/properties/selection/cannon.inc"  scale(0.7))
	{bone "basis"
		{limits}
		{speed 0.001}
	}
	{extender "cannon"
		{animation
			{switch "close"}
			{move "cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim "Cannon_m5_gunlayer" ""}
			{fire  "Cannon_gunlayer_fire-alert" "cannon_pdr25_charger_fire"}
			{reload  "" "Cannon_m5_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		(mod "mp" {rotate_ik_Limit 0})
	}
	{Chassis "track"
		("car_trace" fx("tracewheel01") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("loco_medium")
	}
	{bone "turret"
		{limits -20 20}
		{speed 0.0007}
	}
	{bone "gun_rot"
		{speed 0.0005}
	}
}
