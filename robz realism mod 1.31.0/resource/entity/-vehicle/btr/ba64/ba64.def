(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{Extension "ba64.mdl"}
	{props "vehicle" "armored_car" "tank" "turret" "wheeled" "vision_vehicle_low" "switch_mgun_coax"}
	{PatherId "vehicle.small"}

	{extender "enumerator"}
	{extension "crew.ext"}

	; --- Godny hitbox armor (ported from GodnyMod: ba64.def) ---
	{volume "body1"	;бо
		{tags "body"}
		{component "body"}
		{thickness 9
			{front	15}	;лоб 15 мм
			;	{rear	9}
			{top	6}
			{bottom	4}
		}
	}
	{volume "body2"	;моторное
		{tags "body"}
		{component "body"}
		{thickness 9
			;	{front	9}	;лоб моторного 9 мм
			{rear	6}
			{top	6}	;гласисы верхний и нижний
			{bottom	4}
		}
	}
	{volume "turret"
		{thickness 10}
	}
	{volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	("vol_body_plate_lower" name(body) mm(9))
	{volume "crew"
		{able {contact_ground 0}}
	}
	("armor_medium" args 0.9)
	{component "turret"
		{RepairTime 20}
	}

	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{Box
			{item "dt" filled {user "mgun"}}
			{item "ammo dt29_mag" 2400}
		}
	}
	{Weaponry
		{place "mgun"
			{type "mgun_main"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			{charger "gunner"}
			("abm_mgun")
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{mass 2500}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	40}
			{maxSpeedAtMaxTurn 6}
			{StartTime	20}
			{BrakeTime	1.5}
			{StopTime	3}
			{TurnRadius	4}
			{Gears  0.1 0.2 0.3 1}
			{RearGears 0.25}

		}
		{FuelBag
			{volume 110 }
			{rate	10 }
			{remain 110 }
			{fuel "fuel"}
		}
		{speed
			{Normal  40}
			{Slow  40}
		}
		("car_trace" fx("tracewheel04") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel04") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}

	{bone "mgun"
		{limits -10 15}
	}
	{bone "turret"
		{speed 0.01}
	}
}
