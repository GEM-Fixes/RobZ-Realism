(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{props "vehicle" "armored_car" "zenite" "tank" "turret" "turret_rotator" "wheeled" "vision_vehicle_medium" "muzzle_zenite"}
	;{targetClass "armoredcar" "ap fg bullet"}
	;{targetSelector "tank_aa"}
	{PatherId "vehicle.small"}

	{extension "crew.ext"}

	("vol_body_plate_lower" name(body1) mm(15))
	("vol_body_plate_lower" name(body2) mm(15))
	{volume "turret"
		{component "turret"}
		{tags "turret" "body"}
		{thickness 9
			{front 18}
		}
	}
	{volume "crew"
		{able {contact_ground 0}}
	}
	{component "turret"
		{RepairTime 10}
	}
	{volume "engine"
		{thickness 10
			{rear	15}
		}
	}
	("armor_medium" args 1.0)
	{extender "inventory"
		{box
			{item "bullet20_ita zenite" 456}
			{item "mab_38a" filled}
			{item  "ammo bredam38_belt" 1560}
			{item "oto_mod35 grenade" 5}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_m35" filling "bullet20_ita zenite" 8}
			{charger "gunner"}
			{gunner "gunner"}
			("abm_zenite")
		}
		{place "mgun"
			{type "mgun_coaxial"}
			{weapon "breda_38_optic" filled}
			{charger "gunner"}
			{gunner "gunner"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{type "mgun_rear"}
			{weapon "breda_38" filled}
			{foresight "foresight5"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
		}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{mass 8130}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	41}
			{maxSpeedAtMaxTurn 15}
			{StartTime 22}
			{BrakeTime	1.5}
			{StopTime	3}
			{TurnRadius	5}
		}
		{FuelBag
			{volume 110}
			{rate	25}
			{remain 110 }
			{fuel "fuel"}
		}
		{speed
			{Normal  12}
		}
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}
	{Extension "ab41.mdl"}
	{bone "turret"
		{speed 0.007}
	}
	{bone "gun_rot"
		{speed 0.003}
	}
;("turret_speed_zenite")
}
