;SDL

{boarder
	{anm "driver"
		{forward	{begin	"board_sd222_driver"}}
		{reverse 	{end	"emit_tank_1_hold"}}
	}

	{anm "gunner"
		{forward	{begin	"board_sd222_driver"}}
		{reverse 	{end	"emit_tank_1_hold"}}
	}

	{anm "charger"
		{forward	{begin	"board_sd222_driver"}}
		{reverse 	{end	"emit_tank_1_hold"}}
	}

	{anm "commander"
		{forward	{begin	"board_sd222_driver"}}
		{reverse 	{end	"emit_tank_1_hold"}}
	}
}


(include "/properties/robz/crew.inc")

("crew_human_visor" place(driver)		door(emit1) group(crew)		animation(driver)	    visor(driver))
("crew_human_visor" place(gunner)		door(emit2) group(crew)	    animation(gunner)	    visor(main))
("crew_human_visor" place(commander)	door(emit1) group(crew)		animation(charger)	    visor(back))
("crew_human_visor" place(charger)	door(emit2) group(crew)		animation(charger)	    visor(view-around))

