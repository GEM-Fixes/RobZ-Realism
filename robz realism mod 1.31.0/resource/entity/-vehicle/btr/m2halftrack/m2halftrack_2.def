(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{Extension "m2_2.mdl"}
	{extension "crew.ext"}
	{props "vehicle" "armored_car" "tank" "turret" "wheeled_6" "explosion_throw_crew" "vision_vehicle_medium" "switch_mgun"}

	{extender "enumerator"}
	(include "/properties/resupply_generic.inc")
	("halftrack_ammo_us_inf")
	("vol_sticky_grenade_target" name(sticky))
	{component "sticky_body"}

	("vol_body_plate_lower" name(body1) mm(10))
	("vol_body_plate_lower" name(body2) mm(10))
	("vol_body_plate_lower" name(body3) mm(15))
	("vol_body_plate_lower" name(body4) mm(15))
	("vol_body_plate_lower" name(body5) mm(15))
	("vol_body_plate_lower" name(body6) mm(15))
	{volume "roll"
		{thickness 15}
	}
	("vol_body_plate_lower" name(body7) mm(15))
	{volume "engine"
		{thickness 10}
	}
	{Volume "fuel"
		{thickness 1}
	}

	("armor_light_btr" args 1.0)

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")

	{extender "inventory"
		{Box
			{item "n73at" "grenade" 10}
			{item "m61" "grenade" 25}
			{item "smoke" "grenade" 10}
			{item "bandage" 10}
			{item "dynamite"}
			{item "browning" filling "ammo hmgun ap" 100 {user "mgun"}}
			{item "ammo springfield_belt" 2500}
			{item "ammo hmgun ap" 1000}
		}
	}
	{extender "shield"
		(mod "mp"
			{on}
		)
	}
	{component "shield"
		{RepairTime 10}
	}
	{volume "shield"
		{thickness 0.3}
	}
	{sensor
		{visor "main"
			{bone "mgun"}
		}
	}

	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed 35}
			{maxSpeedAtMaxTurn 6}
			{StartTime	10}
			{Gears  0.1 0.2 0.3 1}
			{RearGears 0.25}
		}
		{FuelBag
			{volume 230 }
			{rate	11 }
			{remain 230 }
			{fuel "fuel"}
		}
		{speed
			{Normal  35}
			{Slow  35}
		}
		; left track must be first
		("tank_trace" fx("tracks_sm") step(0.3) len(0.4) boneleft("wheell4") boneright("wheelr4"))
		("car_trace" fx("tracewheel01") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
	}
	{mass 7000}

}
