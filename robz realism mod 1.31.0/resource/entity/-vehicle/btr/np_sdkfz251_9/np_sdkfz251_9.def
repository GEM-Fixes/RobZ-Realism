(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{Extension "sdkfz251_9.mdl"}
	{extension "crew.ext"}
	{props "vehicle" "armored_car" "tank" "turret" "wheeled_8" "explosion_throw_crew" "vision_vehicle_medium" "muzzle_small" "switch_mgun"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}

	("vol_body_plate_lower" name(body) mm(15))
	("vol_body_plate_lower" name(body2) mm(15))
	("vol_body_plate_lower" name(body3) mm(15))
	("vol_body_plate_lower" name(body4) mm(15))
	("vol_body_plate_lower" name(body5) mm(15))
	("vol_body_plate_lower" name(body6) mm(15))
	("vol_body_plate_lower" name(body7) mm(15))
	("vol_body_plate_lower" name(body8) mm(15))
	("vol_body_plate_lower" name(body9) mm(15))
	("vol_body_plate_lower" name(body10) mm(15))
	("vol_body_plate_lower" name(body11) mm(15))
	("vol_body_plate_lower" name(body12) mm(15))
	("vol_body_plate_lower" name(body13) mm(15))
	{volume "engine"
		{tags "engine"}
		{component "engine"}
		{thickness 15}
	}
	("vol_body_plate" name(body_l) mm(10))
	("vol_body_plate" name(body_r) mm(10))
	{Volume "gun1"
		{tags "gun"}
		{component "gun"}
		{thickness 10}
	}
	{Volume "gun"
		{tags "gun"}
		{component "gun"}
		{thickness 10}
	}
	{Volume "mantlet"
		{tags "gun"}
		{component "gun"}
		{thickness 20}
	}
	("vol_body_plate" name(mgun_turret) mm(10))
	("vol_body_plate" name(shield) mm(20))
	{component "body"
		{RepairTime 15}
	}
	{component "engine"
		{RepairTime 20}
	}
	{component "gun"
		{RepairTime 10}
	}
	("armor_medium" args 1.0)

	{Placer
		{place "attach01"
			{entity "shell_fg_75"}
			{Linkbone "attach01"}
			{handlebone "basis"}
			{obstacle disable}
		}
		{place "attach02"
			{entity "shell_fg_75"}
			{Linkbone "attach02"}
			{handlebone "basis"}
			{obstacle disable}
		}
		{place "attach03"
			{entity "shell_fg_75"}
			{Linkbone "attach03"}
			{handlebone "basis"}
			{obstacle disable}
		}
		{place "attach04"
			{entity "shell_fg_75"}
			{Linkbone "attach04"}
			{handlebone "basis"}
			{obstacle disable}
		}
		{place "attach05"
			{entity "shell_fg_75"}
			{Linkbone "attach05"}
			{handlebone "basis"}
			{obstacle disable}
		}
	}
	; define_place_squat_lie: {placer {place}} {Volume "%place" {tags} {able}}
	;   place - name of {place}, name of {linkbone}, name of {Volume}
	;   e.g. none (not called)
	(define "define_place_squat_lie"
		{placer
			{place "%place"
				{linkbone "%place"}
				{attach squat_lie}
				{turnoff {shadow}}
				{obstacle disable}
			}
		}
		{Volume "%place"
			{tags "attach" "attach_%place"}
			{able clear {bullet 0} {touch 1}}
		}
	)
	{extender "inventory"
		{Box
			{size 6 5}
			{item "ammo bullet75 gers apc" 15}
			{item "ammo bullet75 gers fg" 50}
			{item "ammo bullet75 gers heat" 10}
			{item "ammo mg_mauser belt" 2500}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{Weapon "75mm_kwk37_2" filling "ammo bullet75 gers fg" 1}
			{charger "gunner"}
			("abm_low_v2")
			{basic}
		}
		{place "mgun"
			{type "mgun_main"}
			{weapon "mg34" filled}
			{LinkBone "mgun1"}
			{LinkAnimation "off"}
			{charger "gunner1"}
			{gunner "gunner1"}
			{foresight "foresight3"}
			("abm_mgun")
			{basic}
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")

	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	33}
			{maxSpeedAtMaxTurn 6}
			{StartTime	30}
			{BrakeTime	1.5}
			{StopTime	2.5}
			{TurnRadius	8}
			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 160}
			{rate	10}
			{remain 160 }
			{fuel "fuel"}
		}
		{speed
			{Normal  33}
			{Slow  33}
		}
		; left track must be first
		("tank_trace" fx("tracks_mid") step(0.5) len(0.86) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
	}
	{mass 8500}
}
