{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{props "vehicle" "armored_car" "tank" "turret" "wheeled" "explosion_throw_crew" "vision_vehicle_low" "switch_mgun"}
	{PatherId "vehicle.small"}

	{extender "enumerator"
		{digit_folder "ger"}
	}
	{extension "crew.ext"}

	; --- Godny hitbox armor (ported from GodnyMod: sdkfz223.def) ---
	{volume "body1"	;верхн€€ часть бо
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	15}
			{bottom	5}
		}
	}
	{volume "body2"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	15}
			{bottom	5}
		}
	}
	{Volume "body3"	;дно, рама
		{tags "body"}
		{component "body"}
		{thickness 8}
	}
	{Volume "body4"	;моторное
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	5}
			{bottom	5}
		}
	}
	{volume "turret"
		{thickness 8
			{front	15}
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "box"
		{component "box"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	("armor_medium" args 1.2)

	{component "turret"
		{RepairTime 20}
	}

	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{box
			{item "mg34" filled {user "mgun"}}
			{item "ammo mg_mauser belt" 1350}
		}
	}
	{Weaponry
		{place "mgun"
			{type "mgun_main"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			{charger "gunner"}
			("abm_mgun")
		}
	}
	{sensor
		{visor "main"
			{bone "mgun"}
		}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{mass 4800}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	41}
			{maxSpeedAtMaxTurn 6}
			{StartTime	25}
			{BrakeTime	1.5}
			{StopTime	3}
			{TurnRadius	5}
			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 110}
			{rate	10}
			{remain 110 }
			{fuel "fuel"}
		}
		{speed
			{Normal  41}
			{Slow  41}
		}
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}
	{Extension "sdkfz223.mdl"}

	{bone "turret"
		{speed 0.01}
	}
}
