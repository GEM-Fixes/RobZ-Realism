{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{props "vehicle" "armored_car" "tank" "zenite" "turret" "wheeled_8" "with_gun" "vision_vehicle_low" "muzzle_zenite" "switch_mgun"}
	{targetClass "armoredcar" "ap fg bullet"}
	{targetSelector "tank"}

	{extender "enumerator"
		{digit_folder "ger"}
	}
	{extension "crew.ext"}

	; --- Godny hitbox armor (ported from GodnyMod: sdkfz234_1.def) ---
	{volume "body"	;нижн€€ передн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 8	;борта
			{front	30}	;влд, нлд
			{rear	0.1}	;стык body с body1 и body2
		;	{top	8}
			{bottom	5}	;дно
			{right	15}	;гласис
		}
	}
	{volume "body1"	;верхн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	30}	;мехвод
			{rear	10}
			{top	18}	;усилена +10мм
			{bottom	0.1}	;внутренн€€ стенка на пересечении
		}
	}
	{volume "body2"	;моторное
		{tags "body"}
		{component "body"}
		{thickness 8	;борта
			{front	10}	;стенка моторного
			{rear	10}
		;	{top	8}
			{bottom	5}
		}
	}
	{volume "turret"
		{component "turret"}
		{tags "turret"}
		{thickness 14.5
			{front 30}
		;	{rear	14.5}
			{top	10}
			{bottom	5}
		}
	}
	{Volume "Gun"
		{tags "no_target"}
		{able {Visible 0} {Obstacle 0} {Contact 0}}
		{thickness 10}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "shieldr1"	;юбка
		{component "shieldr1"}
		{thickness 4}
	}
	{volume "shieldl1"	;юбка
		{component "shieldl1"}
		{thickness 4}
	}
	{volume "zipr1"	;€щик зип
		{component "zipr1"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{volume "crew"
		{able {contact_ground 0}}
	}
	{component "turret"
		{RepairTime 20}
	}

	{component "Gun"
		{RepairTime 20}
	}

	("armor_medium" args 1.1)

	{extender "inventory"
		{box
			{item "ammo mg_mauser belt" 700}
            		{item "ammo bullet20 ger zenite ap" 200}
            		{item "ammo bullet20 ger zenite apcr" 80}
	    		{item "ammo bullet20 ger zenite fg" 200}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon			"20mm_kwk38(l55)" filling "ammo bullet20 ger zenite" 10}
			{charger		"commander"}
			("abm_low")
		}
		{place "mgun"
			{type			"mgun_coaxial"}
			{weapon			"mg34_optic" filled}
			{LinkBone		"mgun"}
			{charger		"gunner"}
			("abm_mgun")
			{basic}
		}
	}
	{sensor
		{visor "main"
			{bone "gun"}
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")
	("wheel" args "wheelright3")
	("wheel" args "wheelleft3")
	("wheel" args "wheelright4")
	("wheel" args "wheelleft4")

	{mass 11750}
	{Chassis
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlr") wheelr("wrr") bonel("FXtraceL3") boner("FXtraceR3"))
		{Locomotion ("locomotion")
			{MaxSpeed	38}
	  		{maxSpeedAtMaxTurn 8}		
			{StartTime	20}
			{BrakeTime	1.5}	
			{StopTime	3}
			{TurnRadius	7}
     			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 360}
			{rate	11}
			{remain 360}
			{fuel "fuel"}
		}
		{speed
			{Normal  38}
			{Slow  38}
		}
	}

	{Extension "sdkfz234_1.mdl"}
	
	{bone "turret"
		{speed 0.008}
	}
}
