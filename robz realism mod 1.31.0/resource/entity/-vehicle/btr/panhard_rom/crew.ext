;SDL
{boarder
	{anm "driver"
		{forward	{begin	"board_daimler_gunner"}{base "open_driver"}}
		{reverse 	{end	"emit_body"}}
	}

	{anm "gunner"
		{forward	{begin	"board_daimler_gunner"}{base "open_gunner"}}
		{reverse 	{end	"emit_body"}}
	}

	{anm "charger"
		{forward	{begin	"board_daimler_gunner"}{base "open_gunner"}}
		{reverse 	{end	"emit_body"}}
	}

	{anm "commander"
		{forward	{begin	"board_daimler_gunner"}{base "open_driver"}}
		{reverse 	{end	"emit_body"}}
	}
}


(include "/properties/robz/crew.inc")

("crew_human_visor" place(driver)	door(emit1) group(crew)		animation(driver)	    visor(driver))
("crew_human_visor" place(gunner)	door(emit2) group(crew)	    	animation(gunner)	    visor(main))
("crew_human_visor" place(charger)	door(emit2) group(crew)		animation(charger)	    visor(main))
("crew_human_visor" place(commander)	door(emit1) group(crew)		animation(commander)	    visor(main))
