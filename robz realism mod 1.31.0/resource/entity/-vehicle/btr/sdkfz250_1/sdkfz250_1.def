(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{props "vehicle" "armored_car" "tank" "turret" "wheeled_8" "explosion_throw_crew" "vision_vehicle_medium" "switch_mgun"}

	{extender "enumerator"
		{digit_folder "ger"}
	}
	{extension "crew.ext"}

	{extender "shield"
		{on}
	}
	; --- Godny hitbox armor (ported from GodnyMod: sdkfz250_1.def) ---
	("vol_sticky_grenade_target" name(sticky))
	{volume "body1"	;дно корпуса
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			{front	14.5}
			;	{rear	8}
			{top	0.1}	;внутренняя стенка
			{bottom	6}
		}
	}
	{volume "body2"	;верх моторного
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	14.5}
			{rear	0.1}	;внутренняя стенка
			;	{top	8}	;гласис
			{bottom	6}
		}
	}
	{volume "body3"	;верх отделения управления
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			;	{front	8}	;стенка мто
			{rear	0.1}	;внутренняя стенка
			{top	6}
			{bottom	6}
		}
	}
	{volume "body4"	;задняя часть десантного
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			{front	0.1}	;внутренняя стенка
			;	{rear	8}
			{top	6}
			{bottom	6}
		}
	}
	{volume "body5"	;верхняя передняя часть десантного
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			{front	10}
			{rear	0.1}	;внутренняя стенка
			{top	6}
			{bottom	0.1}	;внутренняя стенка
		}
	}
	{Volume "mgun_shield"
		{component "mgun_shield"}
		{thickness 6}
	}
	("vol_body_hole_only" name(hole_bod))
	{volume "engine"
		{thickness 10}
	}
	{volume "inventory"	;правая боеукладка
		{thickness 3
			{bottom	0.1}
		}
	}
	{volume "inventory1"	;левая боеукладка
		{thickness 3
			{bottom	0.1}
		}
	}
	{volume "zipl1"
		{component "zipl1"}
		{thickness 6}
	}
	{volume "zipr1"
		{component "zipr1"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{component "sticky_body"}

	("vol_body_plate_lower" name(body6) mm(15))
	{volume "engine1"
		{tags "engine"}
		{component "engine"}
		{thickness 20}
	}
	{volume "engine2"
		{tags "engine"}
		{component "engine"}
		{thickness 20}
	}
	{Volume "fuel"
		{thickness 1}
	}
	("armor_medium" args 1.0)

	{placer
		{place "driver"		{group "driver"} {visor "driver"}}
		{place "gunner"		{group "driver"} {visor "main"} {turnoff {targetable 0}}}
	}

	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{Box
			{item "m24x5" "grenade" 10}
			{item "m24" "grenade" 25}
			{item "smoke" "grenade" 10}
			{item "bandage" 10}
			{item "dynamite"}
			{item "mg42" filled {user "mgun"}}
			{item "ammo mg_mauser drum" 2300}
		}
	}
	{Weaponry
		{place "mgun"
			{type			"mgun_main"}
			{LinkBone		"mgun2"}
			{LinkAnimation	"off"}
			{charger		"gunner"}
			{gunner			"gunner"}
			("abm_mgun")
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")

	{mass 5800}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	38}
			{maxSpeedAtMaxTurn 6}
			{StartTime	20}
			{BrakeTime	1.5}
			{StopTime	2.5}
			{TurnRadius	8}
			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 140}
			{rate	10}
			{remain 140}
			{fuel "fuel"}
		}
		{speed
			{Normal  38}
			{Slow  38}
		}
		; left track must be first
		("tank_trace" fx("tracks_mid") step(0.5) len(0.86) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
	}

	{Extension "sdkfz250_1.mdl"}

	{bone "mgun_rot"
		{limits -20 20}		;gun min right to max left
	}
	{bone "mgun_rot2"
		{limits -15 15}		;gun min up to max down
	}
}
