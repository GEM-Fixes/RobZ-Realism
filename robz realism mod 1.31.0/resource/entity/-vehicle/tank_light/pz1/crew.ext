;SDL

{boarder
	{anm "driver"
		{forward	{begin	"board_LowTank_stand_1"} {end "seat_armor"}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "commander"
		{forward	{begin	"board_LowTank_stand"} {end "seat_armor"}}
		{reverse 	{end	"emit_tank_1"}}
	}

	{anm "gunner"
		{forward	{begin	"board_LowTank_stand_1"} {end "pose_flak38-1_gunlayer" 10}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "charger"
		{forward	{begin	"board_LowTank_stand"} {end "pose_flak38-1_charger" 10}}
		{reverse 	{end	"emit_tank_1"}}
	}
}

(include "/properties/robz/crew.inc")

("crew_human_visor"		  place(driver)		door(emit1) group(driver) animation(driver) visor(driver))
("crew_human_visible_placer" place(charger)	door(emit3) group(crew)	 animation(charger) visor(main))
("crew_human_visible_placer" place(gunner)		door(emit4) group(crew)	 animation(gunner) visor(main))

{placer
	{place "charger"{openForCrush} {turnoff {sensor}} {visor "view-around"}}
	{place "gunner" {openForCrush} {turnoff {sensor}} {visor "main"}}
}
