(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.light"}
	{props "light" "turret_rotator" "vision_vehicle_medium" "muzzle_small"}

	{extender "enumerator"}

	("armor_light" turret(25 25 25 10) body(25 20 20 10))
	("armor_mantlet" t(30))

	{sensor
		{visor "back"
			{vision "tank_back"}
			{bone "foresight5"}
		}
	}

	("crew_inside_left")
	("crew_human" place(commander)	door1(emit1) door2(emit2) visor(back))
	("crew_human" place(gunner)		door1(emit1) door2(emit2) visor(main))
	("crew_human" place(driver)		door1(emit1) door2(emit2) visor(driver))
	("crew_human" place(charger)	door1(emit1) door2(emit2) visor(main))
	("crew_human_gunner" place(gunner2) visorbone(mgun_rot))

	("gunner_visible")

	{boarder
		{anm "left"
			{forward	{begin	"board_Kv"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}

	}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit3)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit4)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit4)  animation(armor))

	{extender "inventory"
		{box
			{item "ammo bullet47 jap aphe" 74}
			{item "ammo bullet47 jap fg" 45}
			{item "type99_mg" filled {user "mgun"}}
			{item "ammo type99_mag" 600}
			{item "ammo type97_mag" 1800}

		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{weapon "47mm_type1" filling "ammo bullet47 jap aphe" 1}
			{RestoreIKAfterAim}
			("abm_low_v4")
		}
		{place "mgun"
			{type "mgun_aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun")
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "type97_mg" filled}
			{gunner "driver"}
			{charger "driver"}
			{foresight "foresight4"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{type "mgun_rear"}
			{weapon "type97_mg" filled}
			{gunner "commander"}
			{charger "commander"}
			{foresight "foresight5"}
			("abm_mgun")
		}

	}

	{mass 15800}

	{Chassis
		("tank_trace" fx("tracks_mid") step(0.56) len(0.3))
		{Locomotion ("locomotion")
			{MaxSpeed	30}
			{maxSpeedAtMaxTurn 6}
			{StartTime	 25}
			{TurnTime	14}
			{TurnStart  1.5}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{TurnRadius 9}
			{TurnStop   0.7}
			{Gears      0.1 0.2 0.3 1.0}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 390 }
			{rate	 15 }
			{remain 390 }
			{fuel "fuel"}
		}
		{speed
			{Normal  30}
			{Slow  30}
		}
	}

	{Extension "chi-ha47.mdl"}
	; --- Godny hitbox armor (ported from GodnyMod: chi-ha47.def) ---
	{Volume "body01"	;нижн€€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 25	;нижн€€ боковина 25мм
			;	{front	25}
			{rear	20}
			{top	0.1}	;внутренн€€ стенка
			{bottom	10}
			{right	12}	;гласис
		}
	}
	{Volume "body02"	;верхн€€ лева€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 25	;верхн€€ боковина 25мм
			;	{front	25}
			{rear	0.1}	;внутренн€€ стенка
			{top	12}
			{bottom	10}
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{Volume "body03"	;верхн€€ права€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 25
			{front	0.1}	;внутренн€€ стенка
			{rear	0.1}	;внутренн€€ стенка
			{top	12}
			{bottom	10}
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{Volume "body04"	;мехвод
		{component "body"}
		{tags "body"}
		{thickness 25
			;	{front	25}
			{rear	0.1}	;внутренн€€ стенка
			{top	12}
			{bottom	10}
		}
	}
	{Volume "body05"	;моторное верхнее передн€€ часть
		{component "body"}
		{tags "body"}
		{thickness 25	;верхн€€ боковина 25мм
			{front	10}	;стенка моторного
			{rear	20}
			{top	12}
			{bottom	10}
		}
	}
	{Volume "body06"	;моторное верхнее задн€€ часть
		{component "body"}
		{tags "body"}
		{thickness 25
			{front	0.1}	;внутренн€€ стенка
			{rear	20}
			{top	12}
			{bottom	10}
		}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 25
			{front	35}
			;	{rear	25}
			{top	12}
			{bottom	10}
		}
	}
	{Volume "turret1"	;командирска€ башенка
		{component "turret"}
		{tags "turret"}
		{thickness 17}
	}
	("vol_turret_hole_only" name(hole_man))
	{volume "mantlet"
		{thickness 35
			;	{front	35}
			{rear	10}	;орудие дает небольшую броню
		}
	}
	{Volume "gun1"
		{tags "gun"}
		{component "gun"}
		{tags "no_target"}
		{thickness 35}
		{able {Visible 0} {Obstacle 0} {Contact 0}}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "cover01"
		{component "cover1"}
		{thickness 10}
	}
	{Volume "cover02"
		{component "cover1"}
		{thickness 10}
	}
	{Volume "zip1"
		{component "zip1"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{Volume "engine01"
		{component "engine"}
		{tags "engine"}
	}
	{Volume "engine02"
		{component "engine"}
		{tags "engine"}
	}
	{Volume "gun2"
		{component "gun"}
		{tags "gun"}
	}
	{Volume "turret2"
		{component "turret"}
		{tags "turret"}
	}
	{Volume "turret3"
		{component "turret"}
		{tags "turret"}
	}

	{bone "gun_rot"
		{limits 12 -10}
		{speed 0.001}
	}
	{bone "turret"
		{speed 0.003}
	}
	{bone "turret_mgun"
		{limits -30 30}
		{speed 0.03}
		{terminator}
	}
}
