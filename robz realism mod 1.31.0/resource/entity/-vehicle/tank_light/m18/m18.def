(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "light" "turret_rotator" "vision_vehicle_medium" "muzzle_medium" "gun_mode_change"}
	{targetClass "light_tank"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: m18.def) ---
	{Volume "body1"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 12.7
			;	{front	12.7}
			;	{rear	12.7}
			{top	0.1}	;внутренн€€ стенка
			{bottom	5}
		}
	}
	{Volume "body2"	;верхн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 12.7
			;	{front	12.7}
			;	{rear	12.7}
			{top	8}
			{bottom	5}
		}
	}
	{Volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 12.7
			;	{front	12.7}
			;	{rear	12.7}
			{top	8}
			{bottom	5}
		}
	}
	{Volume "body4"	;люк к трансмиссии
		{tags "body"}
		{component "body"}
		{thickness 12.7
			;	{front	12.7}
			{rear	0.1}	;внутренн€€ стенка
		;	{top	12.7}
		;	{bottom	12.7}
		}
	}
	{volume "turret"	;верхн€€ часть башни с задней нишей
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 12.7
			{front	25.4}
			{rear	12.7}
			{top	10}
			{bottom	5}
		}
	}
	{Volume "turret1"	;нижн€€ часть башни
		{tags "turret"}
		{component "turret"}
		{thickness 12.7
			{front	25.4}
			;	{rear	12.7}
			{top	0.1}	;стык turret и turret1
			{bottom	5}
		}
	}
	{Volume "turret2"	;корзина стрелка зенитного пулемета
		{tags "turret"}
		{component "turret"}
		{thickness 12.7
			{bottom	0.1}	;стык turret и turret2
		}
	}
	("vol_body_hole_only" name(hole_bod))
	("vol_turret_hole_only" name(hole_man))
	("vol_turret_hole_only" name(hole_tur))
	{volume "mantlet"
		{thickness 19
			;	{front	19}
			{rear	15}	;орудие дает некоторую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	{Volume "gun"
		{thickness 20}
	}

	("armor_light" turret(25 8 12 13) body(32 8 12 18))
	("us_5x_sight")

	("shield" args 10)

	{extender "shield"
		{on}
	}
	{component "shieldl1"}
	{component "shieldl2"}
	{component "shieldl3"}
	{component "shieldl4"}
	{component "shieldr1"}
	{component "shieldr2"}
	{component "shieldr3"}
	{component "shieldr4"}


	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
	}
	("crew_human"		place(driver) door1(emit1) door2(emit2) visor(driver))
	("crew_human"		place(commander) door1(emit1) door2(emit2) visor(driver))
	("crew_human_visible_anm"	place(charger) door1(emit1) door2(emit2) visor(main) anm_left(left) anm_right(left))
	("crew_human_gunner" 	place(gunner2) visorbone(mgun2))
	("crew_human_visible_anm"	place(gunner) door1(emit1) door2(emit2) visor(main) anm_left(left) anm_right(left))
	{placer
		{place "gunner" {openForCrush 0}}
		{place "charger" {openForCrush 0}}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))

	{extender "inventory"
		{weapon "mgun" {mask clear}}
		{box
			;{item "ammo bullet76 us ap" 14}
			{item "ammo bullet76 us apcbc" 28}
			{item "ammo bullet76 us fg" 13}
			{item "ammo bullet76 us hvap" 4}
			{item "browning" filling "ammo hmgun ap" 100 {user "mgun"}}
			{item "ammo hmgun ap" 800}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m1a2" filling "ammo bullet76 us apcbc" 1}
			("abm_low_v4")
		}
		{place "gun1_2"
			{type "gun_change_arty"}
			{weapon "76mm_m1a2_2"}
			{StationaryFiring}
			("abm_howitzer")
		}
		{place "mgun"
			{type "mgun_aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun_heavy")
			{basic}
		}
	}

	{mass 17700}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.52) len(0.56))
		{Locomotion ("locomotion")
			{maxspeed   40}
			{maxSpeedAtMaxTurn 6}
			{StartTime  25}
			{TurnTime   14}
			{TurnStart  1}
			{TurnRadius 8}
			{TurnStop   0.6}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears  0.1 0.25 0.35 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 630 }
			{rate	38 }
			{remain 630 }
			{fuel "fuel"}
		}
		{speed
			{Normal  40}
			{Slow  40}
		}
		{DisableMoveWhileFiring}
	}

	{Extension "m18.mdl"}

	{bone "turret"
		{speed 0.0043}
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed 0.001}
	}

	{bone "turret_mgun"
		{Matrix34
			0	1	0
			-1	0	0
			0	0	1
			-11.4892	-11.9355	8.93723
		}
		{speed 0.03}
		{terminator}
	}
}
