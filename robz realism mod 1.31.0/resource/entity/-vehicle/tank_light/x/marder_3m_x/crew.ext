;SDL

{boarder
	{anm "driver"
		{forward	{begin	"board_pz4_driver"} {end "seat_armor"}}
		{reverse 	{end	"board_pz4_driver" -1}}
	}
	{anm "commander"
		{forward	{begin	"board_LowTank_stand"} {end "seat_armor"}}
		{reverse 	{end	"emit_tank_1"}}
	}

	{anm "gunner"
		{forward	{begin	"board_LowTank_stand_1"} {end "pose_pak40_gunlayer" 10}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "charger"
		{forward	{begin	"board_LowTank_stand"} {end "pose_pak40_gunlayer" 10}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "crew"
		{forward	{begin	"board_tank_right"} {end "seat_m7_mgunner"}}
		{reverse 	{end	"emit_tank_1_hold"}}
	}
}

(include "/properties/robz/crew.inc")

("crew_human_visor"		  place(driver)		door(emit1) group(driver) animation(driver) visor(driver))
("crew_human_visible_placer" place(commander)	door(emit2) group(crew)	 animation(commander) visor(main))
("crew_human_visible_placer" place(gunner)		door(emit2) group(crew)	 animation(gunner) visor(main))
("crew_human_visible_placer" place(charger)	door(emit2) group(crew)	 animation(charger) visor(main))
("crew_human_visible_placer" place(gunner2)	door(emit2) anm_left(crew)	 animation(crew)	visor(main))

{placer
	{place "commander" {openForCrush}}
	{place "charger" {openForCrush}}
	{place "gunner" {openForCrush}}
	{place "gunner2" {openForCrush}}
}
