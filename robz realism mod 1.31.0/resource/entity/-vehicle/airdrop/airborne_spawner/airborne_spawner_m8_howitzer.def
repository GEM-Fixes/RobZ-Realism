	{mass 1}
	
	{Chassis
		{Locomotion ("locomotion")
				{maxspeed   		2000}
				{maxSpeedAtMaxTurn 	2000}
				{StartTime  		0.01}
				{TurnTime    		0.01}
				{TurnStart   		0.01}			
				{TurnRadius  		1} 
	    		{TurnStop    		0.01}
				{BrakeTime   		0.01}
				{StopTime    		0.01}
     			{Gears       		1}
				{RearGears   		1}
		}
