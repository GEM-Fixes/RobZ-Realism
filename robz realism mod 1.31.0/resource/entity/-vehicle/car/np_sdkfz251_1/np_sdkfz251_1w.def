(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{Extension "sdkfz251_1w.mdl"}
	{extension "crew2.ext"}
	{props "vehicle" "armored_car" "tank" "turret" "wheeled" "explosion_throw_crew" "vision_vehicle_high" "open_door2"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}
	("vol_body_plate_lower" name(body) mm(15))
	("vol_body_plate_lower" name(body2) mm(15))
	("vol_body_plate_lower" name(body3) mm(15))
	("vol_body_plate_lower" name(body4) mm(15))
	("vol_body_plate_lower" name(body5) mm(15))
	("vol_body_plate_lower" name(body6) mm(15))
	("vol_body_plate_lower" name(body7) mm(15))
	("vol_body_plate_lower" name(body8) mm(15))
	("vol_body_plate_lower" name(body9) mm(15))
	("vol_body_plate_lower" name(body10) mm(15))
	("vol_body_plate_lower" name(body11) mm(15))
	("vol_body_plate_lower" name(body12) mm(15))
	("vol_body_plate_lower" name(body13) mm(15))
	{volume "engine"
		{tags "engine"}
		{component "engine"}
		{thickness 15}
	}
	("vol_body_plate" name(body_l) mm(10))
	("vol_body_plate" name(body_r) mm(10))
	("vol_body_plate" name(mgun_turret) mm(10))
	("vol_body_plate" name(shield) mm(15))
	{Volume "gun01"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{Volume "gun02"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{Volume "gun21"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{Volume "gun22"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{Volume "gun31"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{Volume "gun32"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	("vol_body_plate" name(sup1) mm(15))
	("vol_body_plate" name(sup2) mm(15))
	("vol_body_plate" name(sup3) mm(15))
	("vol_body_plate" name(sup4) mm(15))
	("vol_body_plate" name(sup5) mm(15))
	("vol_body_plate" name(sup6) mm(15))

	{component "body"
		{RepairTime 15}
	}
	{component "engine"
		{RepairTime 20}
	}
	{component "gun"
		{RepairTime 10}
	}
	("armor_medium" args 1.0)

	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{Box
			{item "mg34" filled {user "mgun"}}
			{item "ammo nebel" 12}
			{item "ammo nebel ic" 12}
			{item "ammo 7x57" 1200}
		}
	}

	{Weaponry
		{place "gun"
			{weapon "weapon nebel" filled}
			{shooter "shooter_a"}
			{charger "commander"}
			{gunner "commander"}
			{foresight "foresight1"}
			{Barrels 2}
			{basic}
		}
		{place "gun2"
			{weapon "weapon nebel2" filled}
			{shooter "shooter_b"}
			{charger "commander"}
			{gunner "commander"}
			{foresight "foresight5"}
			{Barrels 2}
			{basic}
		}
		{place "gun3"
			{weapon "weapon nebel3" filled}
			{shooter "shooter_c"}
			{charger "commander"}
			{gunner "commander"}
			{foresight "foresight6"}
			{Barrels 2}
			{basic}
		}
		{place "mgun"
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			{weapon "mg34" filled}
			{gunner "gunner"}
			{charger "gunner"}
			{type "mgun_main"}
			{basic}
		}
	}


	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")

	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	33}
			{maxSpeedAtMaxTurn 16}
			{StartTime 20}
			{BrakeTime	1.5}
			{StopTime	2.5}
			{TurnRadius	8}
		}
		{FuelBag
			{volume 160}
			{rate	40}
			{remain 160 }
			{fuel "fuel"}
		}
		{speed
			{Normal  12}
			{Slow  20}
		}
		; left track must be first
		("tank_trace" fx("tracks_mid") step(0.5) len(0.86) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
	}
	{mass 8500}
}
