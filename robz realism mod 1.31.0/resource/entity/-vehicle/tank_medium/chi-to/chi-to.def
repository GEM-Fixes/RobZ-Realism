(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "vision_vehicle_high" "muzzle_medium"}

	{extender "enumerator"}

	("armor_medium" turret(75 50 50 20) body(75 35 35 20))
	("armor_engine"  t(50 35 35 20))
	("armor_mantlet" t(75))

	{boarder
		{anm "left"
			{forward	{begin	"board_sherman_left"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_sherman_right"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("crew_4_human")
	("gunner_visible")

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "inventory"
		{box
			{item "ammo bullet75 japl aphe" 30}
			{item "ammo bullet75 japl aphe2" 10}
			{item "ammo bullet75 japl fg" 32}
			{item "ammo bullet75 japl aphe3" 5}
			{item "type99_mg" filled {user "mgun"}}
			{item "ammo type99_mag" 600}
			{item "ammo type97_mag" 800}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_type5" filling "ammo bullet75 japl aphe" 1}
			("abm_high")
		}
		{place "mgun"
			{type "mgun_aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "type97_mg" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
		}
	}

	{mass 31500}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.25))
		{Locomotion ("locomotion")
			{maxspeed   32}
			{maxSpeedAtMaxTurn 4}
			{StartTime  35}
			{TurnStart  1.8}
			{TurnTime   20}
			{TurnRadius 10}
			{TurnStop   1}
			{BrakeTime  2}
			{StopTime   3}
			{Gears   0.1 0.21 0.31 1}
			{RearGears  0.2}
		}
		{FuelBag
			{volume 720 }
			{rate	75 }
			{remain 720 }
			{fuel "fuel"}
		}
		{speed
			{Normal  32}
			{Slow  32}
		}
	}

	{Extension "chi-to.mdl"}
	{bone "gun_rot"
		{limits -8 20}
		{speed 0.0006}
	}
	{bone "turret"
		{speed 0.0025}
	}
	{bone "mgun"
		{speed 0.025}
	}

	; --- Godny hitbox armor (ported from GodnyMod: chi-to.def) ---
	{Volume "body1"	;передн€€ часть и гласис
		{component "body"}
		{tags "body"}
		{thickness 35	;нижний борт 25мм
			{front	75}
			{rear	20}
			{top	0.1}	;внутренн€€ стенка
			{bottom	10}
			{right	20}	;гласис
		}
	}
	{Volume "body2"	;верхн€€ передн€€ часть, бо
		{component "body"}
		{tags "body"}
		{thickness 35
			{front	75}
			{rear	0.1}	;внутренн€€ стенка
			{top	20}
			{bottom	10}
			{right	50}	;щеки
		}
	}
	{Volume "body3"	;верхн€€ задн€€ часть
		{component "body"}
		{tags "body"}
		{thickness 35
			{front	10}	;стенка моторного
			;	{rear	35}
			{top	20}
			{bottom	10}
		}
	}
	{Volume "body4"	;моторное верх
		{component "body"}
		{tags "body"}
		{thickness 35
			{front	0.1}	;внутренн€€ стенка
			;	{rear	35}
			{top	20}
			{bottom	10}
		}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 50
			{front	75}
			;	{rear	50}
			{top	30}
			{bottom	20}
		}
	}
	{Volume "turret1"	;командирска€ башенка
		{component "turret"}
		{tags "turret"}
		{thickness 50
			{top	30}
			{rear	0.1}	;внутренн€€ стенка
		}
	}
	("vol_turret_hole_only" name(hole_man))
	{volume "mantlet"
		{thickness 75
			;	{front	75}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "cover1"
		{component "cover1"}
		{thickness 20}
	}
	{Volume "cover2"
		{component "cover1"}
		{thickness 20}
	}
	{Volume "detail2"
		{component "detail2"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{Volume "gun"
	}
	{Volume "ram"
	}
	{Volume "trackleft"
	}
	{Volume "trackright"
	}
	{texmod "1"}
	{bone "turret_mgun"
		{limits -30 30}
		{speed 0.03}
		{terminator}
	}
}
