(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "vision_vehicle_medium" "muzzle_minimum"}

	("vol_body_part_component_first" name(body1))
	("vol_body_part_component_first" name(body2))
	{volume "engine"
		{component "engine"}
	;		{thickness 15}
	}
	{Volume "gun"
		{component "gun"}
		{tags "gun"}
	}
	{Volume "mantlet"
		{component "mantlet"}
		{tags "mantlet"}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
	}

	("armor_medium" turret(50 25 25 10) body(50 30 50 22))
	("armor_engine"  t(25 25 25 20))
	("armor_mantlet" t(50))
	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "hullmg"
			{bone "foresight4"}
			{vision "tank_driver"}
		}
	}
	("crew_5_human")
	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_LowArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}
	("seat_human" place(seat1) bone(seat01) door(emit5)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit6)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit3)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit4)  animation(armor))
	{extender "inventory"
		{box
			{item "bullet40_hun ap" 30}
			{item "bullet40_hun fg" 27}
			{item "ammo bullet40_hun apcr" 5}
			{item "ammo gabauer_belt" 3150}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "40mm_41M" filling "bullet40_hun ap" 1}
			("abm_medium")
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "gebauer" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "gebauer_optic" filled}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
	}
	{mass 21000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.21))
		{Locomotion ("locomotion")
			{MaxSpeed   30}
			{maxSpeedAtMaxTurn 6}
			{StartTime 	 35}
			{TurnTime  	 15}
			{TurnStart 1.4}
			{BrakeTime   1}
			{StopTime    2}
			{TurnRadius  8}
			{TurnStop   0.7}
			{Gears  0.1 0.2 0.3 1}
			{RearGears 0.28}
		}
		{FuelBag
			{volume 320 }
			{rate	24 }
			{remain 320 }
			{fuel "fuel"}
		}
		{speed
			{Normal  30}
			{Slow  30}
		}
	}

	{Extension "turan1.mdl"}

	{bone "turret"
		{speed 0.0036}
	}
;{bone "gun_rot"
;{speed 0.0008}
;}
;("turret_speed_medium")
;("ger_1_sight")
}
