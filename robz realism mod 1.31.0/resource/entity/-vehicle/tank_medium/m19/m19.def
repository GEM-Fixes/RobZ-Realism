(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "flak" "turret" "vision_vehicle_medium" "muzzle_zenite"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: m19.def) ---
	{volume "body1"	;корпус
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 12.7	;из одной толщины листа корпус
			;	{front	12.7}	;нлд и влд
			{rear	10}	;стенка моторного
		;	{top	12.7}
		;	{bottom	12.7}
		}
	}
	{volume "body2"	;люк трансмиссии
		{tags "body"}
		{component "body"}
		{thickness 12.7
			{front	25.4}
			{rear	0.1}	;внутренн€€ стенка
			{top	12.7}
			{bottom	12.7}
		}
	}
	{volume "body3"	;корпус
		{tags "body"}
		{component "body"}
		{thickness 12.7	;из одной толщины листа корпус
			{front	0.1}	;внутренн€€ стенка
		;	{rear	12.7}
		;	{top	12.7}
		;	{bottom	12.7}
		}
	}
	{volume "turret1"
		{component "turret"}
		{thickness 13}
	}
	{volume "turret2"
		{component "turret"}
		{thickness 13}
	}
	{volume "turret3"
		{component "turret"}
		{thickness 13}
	}
	{volume "turret4"
		{component "turret"}
		{thickness 13}
	}
	{volume "turret5"
		{component "turret"}
		{thickness 13}
	}
	{volume "turret6"
		{component "turret"}
		{thickness 13}
	}
	{volume "turret7"
		{component "turret"}
		{thickness 13}
	}
	{volume "turret8"
		{component "turret"}
		{thickness 13}
	}
	{volume "gun1"
		{tags "gun"}
		{component "gun"}
	}
	{volume "gun2"
		{tags "gun"}
		{component "gun"}
	}
	("vol_body_hole_only" name(hole_bod))
	; --- end Godny hitbox armor ---
	("vol_body_part_lower" name(body))
	("armor_medium" turret(15) body(25 25 10 22))

	{extender "inventory"
		{box
			{item "bullet40 us zenite ap" 220}
			{item "bullet40 us zenite fg" 200}
		}
	}
	{Weaponry
		{place "gun"
			{weapon "40mm_m19" filling "ammo bullet40 us zenite ap" 14}
			{charger "gunner"}
			{Barrels 2}
			("abm_zenite")
		}
	}

	("crew_inside_left")
	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_sd222_gunner2"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_tank_left"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{boarder
		{door "emit0"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}

	("crew_human_visible" place(gunner)	door1(emit4)  visor(main))
	("crew_human_visible" place(gunner1) door1(emit5) visor(main))

	("crew_human" place(commander) door1(emit4) visor(main))

	("seat_human" place(seat1) bone(seat01) door(emit1)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit3)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit6)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit2)  animation(armor1))

	;	("gunner_visible")

	{placer
		{place "gunner" {openForCrush 0}}
	}

	{mass 20000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.7))
		{Locomotion ("locomotion")
			{maxspeed   27}
			{maxSpeedAtMaxTurn 6}
			{StartTime  13}
			{TurnTime   14}
			{TurnStart  1.5}
			{TurnRadius 9}
			{TurnStop   0.7}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears   0.1 0.2 0.3 1}
			{RearGears  0.34}
		}
		{FuelBag
			{volume 420 }
			{rate	28 }
			{remain 420 }
			{fuel "fuel"}
		}
		{speed
			{Normal  27}
			{Slow  27}
		}
	}

	{Extension "m19.mdl"}

	{bone "turret"
		{speed 0.005}
	}
}
