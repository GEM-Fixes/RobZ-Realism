	}

	{mass 29600}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.28))
		{Locomotion ("locomotion")
			{maxspeed   34}
			{maxSpeedAtMaxTurn 5}
			{StartTime	       25.5}
			{TurnTime	        13.5}
			{TurnStart        1.5}
			{BrakeTime        4}
			{StopTime         1.5}
			{TurnRadius         8}
			{TurnStop         0.7}
			{Gears      0.13 0.28 0.38 1.0}
			{RearGears       0.27}
		}
		{FuelBag
			{volume 780 }
			{rate   23 }
			{remain 780 }
			{fuel "fuel"}
		}
		{speed
			{Normal  34}
			{Slow  34}
		}
	}
	{Extension "su100.mdl"}

	{bone "gun_rot1"
		{speed 0.0012}
	}
	{bone "gun_rot2"
		{speed 0.0012}
