		{component "body"}
		{able {holed}}
		{thickness 45
			{front	75}
			;	{rear	45}
			{top	20}
			{bottom	20}
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body3"	;моторное верх
