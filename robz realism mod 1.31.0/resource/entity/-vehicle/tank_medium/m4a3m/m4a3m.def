(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "tractor" "heavy tow" "medium" "mine_exploder" "vision_vehicle_high"}
	{tag "heavy_tow"}
	{extender "enumerator"}

	("armor_medium_advanced" turret(0) body(64 38 38 22) body2(51 38 38 22) body3(51 38 38 22))
	("armor_engine"  t(40 38 38 22))
	("shield" args 10)
	("us_3x_sight")

	("shield" args 8)
	{extender "shield"
		{on}
	}


	; --- Godny hitbox armor (ported from GodnyMod: m4a3m.def) ---
	{volume "Wheel_work"
		{thickness 150}
		{density 0.1}
	}
	; --- end Godny hitbox armor ---
	("vol_body_part_component_first" name(body1))
	("vol_body_part_component_first" name(body2))
	{volume "body3"
		{component "body"}
		{thickness 81}
		{tags "body"}
	}
	{volume "engine"
		{component "engine"}
		{tags "engine"}
	}
	{volume "support1"
		{thickness 15}
	}
	{volume "support"
		{thickness 15}
	}
	{volume "mgun_shield1"
		{thickness 15}
	}
	{volume "mgun_shield2"
		{thickness 15}
	}
	{volume "wheel"
		{thickness 1500}
		{density 0.1}
	}
	{boarder
		{anm "left"
			{forward	{begin	"board_HighArmor"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_HighArmor"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("crew_human" place(driver)	door1(emit1) door2(emit2) visor(driver))
	("gunner_visible")

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{box
			{item "browning" filling "ammo hmgun ap" 100 {user "mgun"}}
			{item "ammo hmgun ap" 300}
			{item "dynamite" 2}
		}
	}
	{Weaponry
		{place "mgun"
			{type "mgun_aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun_heavy")
		}
	}

	{mass 25500}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.16))
		{Locomotion ("locomotion")
			{maxspeed   32}
			{maxSpeedAtMaxTurn 5}
			{StartTime  30}
			{TurnTime   17}
			{TurnStart  1.6}
			{TurnRadius 8}
			{TurnStop   0.8}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears   0.1 0.2 0.3 1}
			{RearGears  0.27}
		}
		{FuelBag
			{volume 660 }
			{rate	34 }
			{remain 660 }
			{fuel "fuel"}
		}
		{speed
			{Normal  32}
			{Slow  32}
		}
	}
	{Extension "m4a3m.mdl"}
}
