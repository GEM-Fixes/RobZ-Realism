	; --- end Godny hitbox armor ---
	("shield" args 10)

	{extender "shield"
		{on}
	}
	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}

	("armor_medium" turret(51 24 29 12) body(46 27 27 9))
	("armor_engine"  t(30 27 27 7))
	("eng_3x_sight")


	("crew_4_human")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_LowArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "inventory"
		{box
			{item "bullet57 eng ap" 37}
			{item "bullet57 eng fg" 28}
			{item "ammo mg_mauser belt red" 3500}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "57mm_oqf" filling "bullet57 eng ap" 1}
			("abm_medium")
		}
		{place "mgun"
			{type "mgun_coaxial"}
			{weapon "besa_optic" filling "mg_mauser belt red" 225}
			("abm_mgun")
			{basic}
		}
	}

	{mass 20100}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.2))
		{Locomotion ("locomotion")
			{MaxSpeed   34}
			{StartTime  20}
			{TurnStart  1.5}
			{TurnTime   15}
			{TurnRadius 9}
			{TurnStop   0.7}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.23}
		}
		{FuelBag
			{volume 500 }
			{rate	32 }
			{remain 500 }
			{fuel "fuel"}
		}
		{speed
			{Normal  34}
			{Slow  34}
		}
	}


	{Extension "crusader_mk6.mdl"}
	{bone "turret"
		{speed 0.0033}
	}
	{bone "gun_rot"
		{speed 0.001}
	}
}

