			{right	14}	;внутренн€€ плита
		}
	}
	{volume "body7"	;лева€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 14.27	;внешн€€ плита
			{front	0.1}	;внутренн€€ стенка
			{rear	14}
			{top	12}
			{bottom	0.1}	;внутренн€€ стенка
			{right	14}	;внутренн€€ плита
