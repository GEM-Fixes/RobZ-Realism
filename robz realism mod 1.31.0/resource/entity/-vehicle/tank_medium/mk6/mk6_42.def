			{rear	14}
			{top	7}
			{bottom	6.35}
		}
	}
	{volume "body5"	;мехвод
		{tags "body"}
		{component "body"}
		{thickness 28.3	;14+14,27
			{front	40.2}	;18+22,22
			{rear	0.1}	;внутренн€€ стенка
			{top	12}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body6"	;права€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 14.27	;внешн€€ плита
			{front	0.1}	;внутренн€€ стенка
			{rear	14}
			{top	12}
