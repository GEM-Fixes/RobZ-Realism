{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{collider "tank.light"}
	{props "light" "turret_rotator" "vision_vehicle_medium" "muzzle_small" "switch_mgun_coax"}

	{extender "enumerator"}

