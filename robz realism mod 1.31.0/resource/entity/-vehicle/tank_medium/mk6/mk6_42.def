	{Volume "turret"
		{component "turret"}
		{tags "turret"}
		{thickness 25
			{front	0.1}	;31,75+19,05 передн€€ плита перенесена в маску
			{rear	29.7}	;17+12,7
			{top	12}
			{bottom	9}
		}
	}
	{Volume "mantlet"
		{thickness 31.75
			;	{front	31.75}	;31,75+19,05 передн€€ плита
			{rear	19.05}
		}
