(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "-turret" "opened" "vision_vehicle_medium" "muzzle_large_sides"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: archer.def) ---
	("vol_sticky_grenade_target" name(sticky))
	{volume "body1"	;передн€€ (носова€) часть корпуса
		{component "body"}
		{tags "body"}
		{able {holed}}
		{thickness 20
			{front	60}	;нлд
			{rear	0.1}	;внутренн€€ стенка
			{top	10}
			{bottom	7}
			{right	15}	;гласис
		}
	}
	{volume "body2"	;моторное
		{component "body"}
		{tags "body"}
		{thickness 20
			{front	60}
			{rear	10}	;стенка моторного
			{top	10}
			{bottom	7}
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body3"	;нижн€€ часть рубки
		{component "body"}
		{tags "body"}
		{thickness 20
			{front	0.1}	;внутренн€€ стенка
			;	{rear	20}
			{top	10}
			{bottom	20}	;днище усилено?
		}
	}
	{volume "body4"	;рубка верхн€€ часть
		{component "body"}
		{tags "body"}
		{able {holed}}
		{thickness 20
			;	{front	20}
			;	{rear	20}
			{top	10}
			{bottom	10}
		}
	}
	{volume "body5"	;решетка моторного
		{component "body"}
		{tags "body"}
		{thickness 20
			{front	60}
			{rear	0.1}	;внутренн€€ стенка
			{top	7}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "turret"
		{thickness 20
			;	{front	20}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	("vol_body_hole_only" name(hole_bod1))
	("vol_body_hole_only" name(hole_bod2))
	("vol_body_hole_only" name(hole_man))
	{volume "engine"
		{thickness 10}
	}
	{volume "inventory"
		{thickness 2}
	}
	{volume "zipl1"
		{component "zipl1"}
		{thickness 6}
	}
	{volume "zipl2"
		{component "zipl2"}
		{thickness 6}
	}
	{volume "zipl3"
		{component "zipl3"}
		{thickness 6}
	}
	{volume "zipr1"
		{component "zipr1"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	("vol_body_plate_component_first" name(body6) mm(30))
	("vol_body_plate_component_first" name(body7) mm(30))

	("armor_spa_light" armor(30 15 15 15))
	("armor_mantlet" t(30))
	("eng_6x_sight")

	{boarder
		{anm "driver"
			{forward	{begin	"board_tank_left"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "charger"
			{forward	{begin	"board_hummel"} {end "pose_pak40_gunlayer"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
		{anm "gunner"
			{forward	{begin	"board_hummel"} {end "pose_pak40_charger"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
		{anm "commander"
			{forward	{begin	"board_hummel"} {end "pose_seat_armor_2"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
	}

	(include "/properties/robz/crew.inc")

	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner" {visor "main"}}
	}
	{boarder
		{door "emit0"}
		{door "emit1"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}

	("crew_human_two_doors" place(commander)	door2(emit2))
	("crew_human_two_doors" place(driver)	door1(emit1))
	("crew_human_two_doors" place(charger)	door2(emit2))
	("crew_human_two_doors" place(gunner)	door1(emit1))

	{extender "inventory"
		{box
			{item "bullet76 eng apcbc" 44}
			{item "bullet76 eng fg" 6}
			{item "bullet76 eng apds" 4}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_mk4_2" filling "ammo bullet76 eng apcbc" 1}
			("abm_medium")
		}
	}
	{sensor
		{visor "main"
			{vision "tank_main-h"}
			{bone "visor2"}
		}
		{visor "driver"
			{vision "tank_driver"}
			{bone "visor1"}
		}
		{visor "view-around"
			{vision "none"}
			{bone "basis"}
		}
	}

	{mass 16300}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.4) len(0.4))
		{Locomotion ("locomotion")
			{maxspeed   29}
			{maxSpeedAtMaxTurn 6}
			{StartTime  30}
			{TurnStart  1}
			{TurnTime   17}
			{TurnRadius 9}
			{TurnStop   0.5}
			{BrakeTime  1}
			{StopTime   2}
			{Gears  0.1 0.2 0.3 1}
			{RearGears   0.25}
		}
		{FuelBag
			{volume 230 }
			{rate	24 }
			{remain 230 }
			{fuel "fuel"}
		}
		{speed
			{Normal  29}
			{Slow  29}
		}
	}

	{Extension "archer.mdl"}
	{bone "gun_rot"
		{speed 0.001}
		{limits -7 15}
	}
	{bone "turret"
		{speed 0.001}
		{limits -22 22}
	}
}
