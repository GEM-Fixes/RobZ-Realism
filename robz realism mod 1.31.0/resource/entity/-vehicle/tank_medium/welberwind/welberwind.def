(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "flak" "turret" "vision_vehicle_high" "muzzle_zenite"}
	{Extension "wirbelwind.mdl"}

	; --- Godny hitbox armor (ported from GodnyMod: welberwind.def) ---
	("vol_sticky_grenade_target" name(sticky))
	{volume "body1"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 30	;борта и нижние гласисы - скосы
			{front	50}	;нлд
			{rear	20}	;зад и нижний скос мто
			{top	0.1}	;внутренн€€ стенка
			{bottom	10}
			{right	20}	;гласис
		}
	}
	{volume "body2"	;верхн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 30
			{front	50}	;влд
			{rear	20}	;задн€€ стенка бо
			{top	10}
			{bottom	10}
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 20
			{front	0.1}	;внутренн€€ стенка
			{rear	20}
			{top	8}
			{bottom	10}
		}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 16
			{top	10}
			{bottom	10}
		}
	}
	("vol_turret_hole_only" name(hole_tur))
	{volume "gun1"
		{tags "gun"}
		{component "gun"}
	}
	{volume "gun2"
		{tags "gun"}
		{component "gun"}
	}
	{volume "gun3"
		{tags "gun"}
		{component "gun"}
	}
	{volume "gun4"
		{tags "gun"}
		{component "gun"}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "detail7"
		{component "detail7"}
		{thickness 7.5}
	}
	; --- end Godny hitbox armor ---
	{component "sticky_body"}

	("armor_medium" turret(20) body(80 30 30 20))
	("armor_engine"  t(30 30 30 20))

	(include "/properties/robz/crew.inc")

	{placer
		{place "driver" {visor "driver"}}
		{place "commander" {visor "main"}}
		{place "gunner" {visor "main"}}
		{place "charger" {visor "main"}}
	}

	{boarder
		{door "emit0"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}

	("crew_human_open_for_crush_two_doors" place(gunner)	    door1(emit2))
	("crew_human_open_for_crush_two_doors" place(charger)	door1(emit3))
	("crew_human_open_for_crush_two_doors" place(commander)	door1(emit3))

	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "charger"
			{forward	{begin	"board_tank_left"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "commander"
			{forward	{begin	"board_tank_left"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "gunner"
			{forward	{begin	"board_tank_right"} {end "pose_gunner_ostwind"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
	}

	{extender "inventory"
		{box
			{item "bullet20 ger zenite ap" 1600}
			{item "bullet20 ger zenite fg" 1600}
			{item  "ammo mg_mauser belt" 1350}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_flak38_x4" filling "bullet20 ger zenite ap" 80}
			("abm_zenite")
			{charger "gunner"}
			{Barrels 4}
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "mg34_optic" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 22000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.21))
		{Locomotion ("locomotion")
			{MaxSpeed	 28}
			{maxSpeedAtMaxTurn 4}
			{StartTime	  40}
			{TurnTime  	  19}
			{TurnStart  1.4}
			{BrakeTime    1}
			{StopTime     2}
			{TurnRadius   8}
			{TurnStop   0.8}
			{Gears  0.1 0.2 0.3 1}
			{RearGears 0.28}
		}
		{FuelBag
			{volume 470 }
			{rate	35 }
			{remain 470 }
			{fuel "fuel"}
		}
		{speed
			{Normal  28}
			{Slow  28}
		}
	}

	{bone "gun_rot"
		{speed 0.003}
		{limits -8 65}
	}
	{bone "turret"
		{speed 0.005}
	}
}
