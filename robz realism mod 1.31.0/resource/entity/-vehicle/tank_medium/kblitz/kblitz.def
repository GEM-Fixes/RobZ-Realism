{Entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "flak" "turret" "vision_vehicle_high" "muzzle_zenite"}
	{Extension "kblitz.mdl"}

	{volume "body1"
		{tags "body"}
		{component "body"}
	}
	{volume "body2"
		{tags "body"}
		{component "body"}
	}
	{volume "gun1"
		{tags "gun"}
		{component "gun"}
	}
	{volume "gun2"
		{tags "gun"}
		{component "gun"}
	}
	{volume "gun_rot"
		{tags "turret"}
		{component "turret"}
	}
	{volume "turre"
		{thickness 20}
	}
	
	("armor_medium" turret(30) body(80 30 30 20))
	("armor_engine"  t(30 30 30 20))
	("shield" args 20)
	
	{extender "inventory"
		{box
			{item "ammo bullet30 ger zenite ap" 200}
			{item "ammo bullet30 ger zenite fg" 800}
			{item "ammo bullet30 ger zenite apcr" 50}
			{item  "ammo mg_mauser belt" 1350}
		}
	}	
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "30mm_mk103x2" filling "bullet30 ger zenite ap" 100}
			{Barrels 2}
			("abm_zenite")
			{charger "gunner"}
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "mg34_optic" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
		}
	}
	("crew_4_human")
	{boarder
			{anm "driver"
				{forward	{begin	"board_pz4_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
				{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
			}
			{anm "left"
				{forward	{begin	"board_tank_right"} {end "seat_gunner_stand"}}
				{reverse 	{end	"emit_tank_2_hold"}}
			}
			{anm "right"
				{forward	{begin	"board_tank_left"} {end "seat_gunner_stand"}}
				{reverse 	{end	"emit_tank_2_hold"}}
			}
			{anm "armor"
				{forward	{begin	"board_highArmor"} 	{end "pose_seat_armor_1"}}
				{reverse 	{end	"emit_tank_2"}}
			}
			{anm "armor1"
				{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
				{reverse 	{end	"emit_body"}}
			}
			{anm "armor2"
				{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
				{reverse 	{end	"emit_body"}}
			}
	}

	
	{mass 22000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.21))
		{Locomotion ("locomotion")
			{MaxSpeed	 28}
			{maxSpeedAtMaxTurn 4}
			{StartTime	  40}
			{TurnTime  	  19}
    		{TurnStart  1.4} 
    		{BrakeTime    1} 
    		{StopTime     2} 
    		{TurnRadius   8} 
    		{TurnStop   0.8}
     		{Gears  0.1 0.2 0.3 1}
    		{RearGears 0.28}
		}
		{FuelBag
			{volume 470 }	
			{rate	35 }   
			{remain 470 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  28}
        	{Slow  28}
    	}
	}

	{bone "gun_rot"
		{speed 0.003}
		{limits -7 80}
	}
	{bone "turret"
		{speed 0.005}
	}
}
