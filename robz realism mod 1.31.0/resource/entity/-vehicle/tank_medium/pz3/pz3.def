(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "vision_vehicle_high" "muzzle_small"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: pz3.def) ---
	{volume "body1"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 30	;борта и нижние гласисы - скосы
			{front	50}	;слд и нлд
			;	{rear	30}
			{top	0.1}	;внутренн€€ стенка
			{bottom	15}
			{right	25}	;гласис
		}
	}
	{volume "body2"	;верхн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 30
			{front	50}
			{rear	10}	;внутренн€€ стенка мто
			{top	10}
			{bottom	0.1}	;внутренн€ стенка
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 30	;борта и скос между верхней и задними стенками мто
			{front	0.1}	;внутренн€€ и нижн€€ стенки
			;	{rear	30}
			{top	15}
			{bottom	10}
		}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 30
			{front	50}
			;	{rear	30}
			{top	16}
			{bottom	10}
		}
	}
	{Volume "turret1"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 30
			;	{front	30}
			;	{rear	30}
			{top	16}
			{bottom	10}
		}
	}
	("vol_turret_hole_only" name(hole_man))
	{volume "mantlet"
		{thickness 50
			;	{front	50}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "zip1"
		{component "zip1"}
		{thickness 6
			{front	0.1}	;внутренн€€ стенка
		}
	}
	{volume "detail6"
		{tags "detail6"}
		{component "detail6"}
		{thickness 7.5}
	}
	; --- end Godny hitbox armor ---
	("armor_medium" turret(50 30 30 10) body(50 30 50 22))
	("armor_engine"  t(30 30 50 20))
	("armor_mantlet" t(50))

	("crew_4_human")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "inventory"
		{box
			{item "ammo bullet50 gerl apc" 43}
			{item "ammo bullet50 gerl fg" 44}
			{item "ammo bullet50 gerl apcr" 4}
			{item "ammo mg_mauser belt" 2250}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "50mm_kwk39" filling "ammo bullet50 gerl apc" 1}
			("abm_medium")
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "mg34_optic" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "mg34_optic" filled}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 21000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.21))
		{Locomotion ("locomotion")
			{MaxSpeed   30}
			{maxSpeedAtMaxTurn 6}
			{StartTime 	 35}
			{TurnTime  	 15}
			{TurnStart 1.4}
			{BrakeTime   1}
			{StopTime    2}
			{TurnRadius  8}
			{TurnStop   0.7}
			{Gears  0.1 0.2 0.3 1}
			{RearGears 0.28}
		}
		{FuelBag
			{volume 320 }
			{rate	24 }
			{remain 320 }
			{fuel "fuel"}
		}
		{speed
			{Normal  30}
			{Slow  30}
		}
	}

	{Extension "pz3j.mdl"}

	{bone "turret"
		{speed 0.002}
	}
	{bone "gun_rot"
		{speed 0.001}
	}
}

