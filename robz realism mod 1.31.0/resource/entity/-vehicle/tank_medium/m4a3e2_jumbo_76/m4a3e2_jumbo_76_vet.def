(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "turret_rotator" "vision_vehicle_high" "muzzle_medium_sides" "m4a3e2_jumbo_76"}

	{extender "enumerator"}
	;{extender "detail"
	;	{random 0}
	;}

	; --- Godny hitbox armor (ported from GodnyMod: m4a3e2_jumbo_76.def) ---
	{volume "body1"	;нижн€€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 38.1	;борта и корма
			{front	114.3}	;трансмисси€
			{rear	130}	;промежуточна€ брон€ на фронте трансмиссии
			{right	139.7}	;максимальна€ брон€ на фронте трансмиссии
			{top	0.1}	;внутренн€€ стенка
			{bottom	19.05}
		}
	}
	{volume "body2"	;верхн€€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 76.2	;вертикальный борт
			{front	101.6}
			{rear	0.1}	;внутренн€€ стенка
			{right	19.05}	;верхние скосы к мто
			{top	50}
			{bottom	12.7}
		}
	}
	{volume "body3"	;мто
		{component "body"}
		{tags "body"}
		{thickness 76.2
			{front	10}
			;	{rear	76.2}
			{right	19.05}	;верхние скосы мто
			{top	15}
			{bottom	12.7}
		}
	}
	{volume "body4"	;нижн€€ задн€€ решетка мто
		{component "body"}
		{tags "body"}
		{thickness 38.1
			{front	0.1}	;внутренн€€ стенка
			{rear	38.1}
			{top	0.1}	;внутренн€€ стенка
			{bottom	12.7}
		}
	}
	{volume "turret"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 152.4
			;	{front	152.4}
			;	{rear	152.4}
			;	{right	63.5}	;скос
			{top	25.4}
			{bottom	12.7}
		}
	}
	("vol_turret_hole_only" name(hole_man))
	{Volume "mantlet"
		{thickness 177.8
			;	{front	177.8}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "inventory"
		{thickness 5}
	}
	{volume "inventory1"
		{thickness 5}
	}
	; --- end Godny hitbox armor ---
	("vol_turret_part" name(turret1))
	("vol_turret_part" name(turret2))
	("armor_heavy_advanced" turret(152 152 152 25) body_mm(102 76 38 22) body2(114 38 38 22) body3(114 38 38 22))
	("armor_engine"  t(30 76 38 22))
	("armor_mantlet" t(178))
	("shield" args 10)
	("us_5x_sight")

	("shield" args 8)
	{extender "shield"
		{on}
	}

	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}

	("crew_4_human")

	("gunner3_visible")
	("gunner_visible")
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{boarder
		{anm "left"
			{forward	{begin	"board_Kv"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}

		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}


	{extender "inventory"
		{box
			{size 8 12}
			{item "ammo bullet76 us apcbc" 32}
			{item "ammo bullet76 us ap" 6}
			{item "ammo bullet76 us fg" 25}
			{item "ammo bullet76 us hvap" 8}
			{item "browning" filling "ammo hmgun ap" 100 {user "mgun"}}
			{item "browning_m19" filled {user "mgun3"}}
			{item "ammo hmgun ap" 300}
			{item "ammo springfield_belt" 2350}
		}
		{weapon "mgun3"
			{mask "weapon mgun"}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m1a2_vet" filling "ammo bullet76 us apcbc" 1}
			("abm_stabilized")
		}
		{place "mgun"
			{type "mgun_aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun_heavy")
		}

		{place "mgun1"
			{type "mgun_hull"}
			{weapon "browning_m19" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "browning_an_m2" filling "ammo hmgun inc" 100}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
		{place "mgun3"
			{type "mgun_aa"}
			{foresight "foresight6"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{LinkBone "mgun_rot3"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
		}
	}

	{Extension "m4a3e2_jumbo_76.mdl"}

	{mass 42900}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.6))
		{Locomotion ("locomotion")
			{maxspeed   25}
			{maxSpeedAtMaxTurn 3.5}
			{StartTime  42.5}
			{TurnTime   19.8}
			{TurnStart  1.6}
			{TurnRadius 8}
			{TurnStop   0.8}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears   0.13 0.23 0.31 1}
			{RearGears  0.27}
		}
		{FuelBag
			{volume 640 }
			{rate	46 }
			{remain 640 }
			{fuel "fuel"}
		}
		{speed
			{Normal  25}
			{Slow  25}
		}
	}
	{bone "turret_mgun"
		{limits -15 15}
		{speed 0.03}
		{terminator}
	}

	{bone "turret"
		{speed 0.0035}
	}
	{bone "gun_rot"
		{speed 0.0014}
	}
}

