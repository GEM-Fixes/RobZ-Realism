(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "heavy" "turret_rotator" "vision_vehicle_high" "muzzle_large_sides" "vehicle_camo_2var3"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: pz5g.def) ---
	{volume "body1"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 40	;нижний борт 40мм
			{front	82}	;влд
			;	{rear	40}
			{top	0.1}	;внутренн€€ стенка
			{bottom	30}
			{right	62}	;нлд
		}
	}
	{volume "body2"	;верхн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 50
			{front	82}
			{rear	10}	;внутренн€€ стенка мто
			{top	17}
			{bottom	17}
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 50	;G - 50мм/30град, D - 40мм/40град
			{front	0.1}	;внутренн€€ стенка
			{rear	40}
			{top	17}
			{bottom	17}
		}
	}
	{Volume "turret1"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 45
			{front	100}
			;	{rear	45}
			{top	30}	;D-17мм, G-30мм
			{bottom	17}
		}
	}
	{Volume "turret2"
		{tags "turret"}
		{component "turret"}
		{able {holed}}
		{thickness 45
			;	{front	45}
			{rear	0.1}	;внутренн€€ стенка
			{top	30}
			{bottom	17}
		}
	}
	("vol_turret_hole_only" name(hole_man))
	{volume "mantlet"
		{thickness 110
			;	{front	110}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	("armor_heavy_advanced" turret(100 45 45 30) body_mm(82 50 40 17) body2(82 40 40 17) body3(62 40 40 25))
	("armor_engine"  t(40 50 40 17))
	("armor_mantlet" t(110))
	("ger_2-5x_sight")
	("ger_5x_sight")

	("shield" args 8)
	{extender "shield"
		{on}
	}

	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldl4" {tags "shield"}}
	{component "shieldl5" {tags "shield"}}
	{component "shieldl6" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}
	{component "shieldr4" {tags "shield"}}
	{component "shieldr5" {tags "shield"}}
	{component "shieldr6" {tags "shield"}}


	("crew_4_human")

	("gunner_visible")
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{boarder
		{anm "left"
			{forward	{begin	"board_Kv"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}

		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}


	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{box
			{item "ammo bullet75 gerl apcbc" 37}
			{item "ammo bullet75 gerl fg" 41}
			{item "ammo bullet75 gerl apcr" 4}
			{item "ammo mg_mauser belt" 1350}
			{item "mg42" filled {user "mgun"}}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_kwk42" filling "ammo bullet75 gerl apcbc" 1}
			("abm_high")
		}
		{place "mgun"
			{type "mgun_aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun")
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "mg34_optic" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "mg34_optic" filled}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
	}




	{mass 45500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.2))
		{Locomotion ("locomotion")
			{MaxSpeed   34}
			{maxSpeedAtMaxTurn 4}
			{StartTime  50}
			{TurnStart  1.8}
			{TurnTime   20}
			{TurnRadius 10}
			{TurnStop   1}
			{BrakeTime  2}
			{StopTime   3}
			{Gears   0.1 0.2 0.3 1}
			{RearGears  0.12}
		}
		{FuelBag
			{volume 720 }
			{rate	75 }
			{remain 720 }
			{fuel "fuel"}
		}
		{speed
			{Normal  34}
			{Slow  34}
		}
	}

	{Extension "pz5g.mdl"}

	{bone "turret_mgun"
		{limits -30 30}
		{speed 0.03}
		{terminator}
	}
	{bone "turret"
		{speed 0.0028}
	}
	{bone "gun_rot"
		{speed 0.0006}
	}
}



