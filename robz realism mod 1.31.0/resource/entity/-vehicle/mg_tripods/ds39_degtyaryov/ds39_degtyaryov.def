(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/cannon_mgun.ext")
	{collider "cannon_small"}
	{props"cannon_small" "round_sandbag2" "vision_cannon_minimum" "mgun_tripod"}

	{Weaponry
		{place "mgun"
			{type "mgun_main"}
			;{LinkBone ""}
			{weapon "ds_mount" filled}
		}
	}
	{extender "inventory"
		{box
			{item "ammo rus_mg_belt" 500}
			{item "plant" 5}
		}
	}

	{Extension "ds39_degtyaryov.mdl"}

	{boarder
		{anm "gunner"
			{forward	{end "pose_vicers_gunner" 10}}
		}
		{anm "commander"
			{forward	{end "lie_take_item_end" 10}}
		}

	}

	{sensor
		{visor "main"
			{vision "cannon_mgun"}
			{bone "turret"}
		}
	}

	{extender "shield"
		{on}
	}

	{extender "cannon"
		{animation
			{reload  "" "cannon_kpvt_charger end lie_take_item_end"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		{rotate_ik_Limit 0}
	}

	{Volume "body"
		{tags "body"}
		{able{obstacle 0}}
		{thickness 1}
		{component "body"}
	}
	("vol_body_plate_no_obstacle_blast" name(body1) mm(1))
	("vol_body_plate_no_obstacle_blast" name(body2) mm(1))
	("vol_body_plate_no_obstacle_blast" name(body3) mm(1))

	{Texmod "bo4"}
}
