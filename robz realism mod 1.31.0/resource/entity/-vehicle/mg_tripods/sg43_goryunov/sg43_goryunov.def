(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/cannon_mgun.ext")

	{props "cannon" "vision_cannon_minimum" "cannon_small" "mgun_tripod"}
	{collider "cannon_small"}

	{Weaponry
		{place "mgun"
			{type "mgun_main"}
			{LinkBone ""}
			{weapon "sg_43_mount" filled}
		}
	}
	{extender "inventory"
		{box
			{item "ammo rus_mg_belt" 500}
			{item "plant" 5}
		}
	}
	{Extension "sg43_goryunov.mdl"}

	{boarder
		{anm "gunner"
			{forward	{end "pose_maxim_gunlaeyr" 10}}
		}
		{anm "commander"
			{forward	{end "lie_take_item_end" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_maxim_move" 10}}
		}
		{anm "driver2"
			{forward {end "walk_1hand" 10}}
		}

	}

	{sensor
		{visor "main"
			{vision "cannon_mgun"}
			{bone "turret"}
		}
	}

	{extender "shield"
		{on}
	}

	{extender "cannon"
		{animation
			{move "cannon_maxim_move" "walk_1hand"}
			{reload  "" "cannon_kpvt_charger end lie_take_item_end"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		{rotate_ik_Limit 0}
	}

	("vol_body_plate_no_obstacle_blast" name(body) mm(1))
	{volume "turret"
		{thickness 3}
	}
	{component "turret"
		{RepairTime 15}
	}
	{Texmod "bo4"}

}
