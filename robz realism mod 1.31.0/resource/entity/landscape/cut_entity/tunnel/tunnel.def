		{link "nL0" "dL8" {anm "walk"}}
		{link "nL0" "dL9" {anm "walk"}}
		{link "nL0" "dL10" {anm "walk"}}
		{link "nL0" "dL11" {anm "walk"}}
		{link "nL0" "dL12" {anm "walk"}}

		{link "nL0" "n1" {anm "ladder"}}

		{link "n1" "cL1" {anm "ladder_super_fast"}}
		{link "n1" "cL2" {anm "ladder_super_fast"}}
		{link "n1" "cL3" {anm "ladder_super_fast"}}
		{link "n1" "cL4" {anm "ladder_super_fast"}}
		{link "n1" "cL5" {anm "ladder_super_fast"}}
		{link "n1" "cL6" {anm "ladder_super_fast"}}
		{link "n1" "cL7" {anm "ladder_super_fast"}}
		{link "n1" "cL8" {anm "ladder_super_fast"}}
		{link "n1" "cL9" {anm "ladder_super_fast"}}
		{link "n1" "cL10" {anm "ladder_super_fast"}}
		{link "n1" "cL11" {anm "ladder_super_fast"}}
		{link "n1" "cL12" {anm "ladder_super_fast"}}

		{link "cL1" "cR1" {anm "ladder_fast"}}
		{link "cL2" "cR2" {anm "ladder_fast"}}
		{link "cL3" "cR3" {anm "ladder_fast"}}
		{link "cL4" "cR4" {anm "ladder_fast"}}
		{link "cL5" "cR5" {anm "ladder_fast"}}
		{link "cL6" "cR6" {anm "ladder_fast"}}
		{link "cL7" "cR7" {anm "ladder_fast"}}
		{link "cL8" "cR8" {anm "ladder_fast"}}
		{link "cL9" "cR9" {anm "ladder_fast"}}
		{link "cL10" "cR10" {anm "ladder_fast"}}
		{link "cL11" "cR11" {anm "ladder_fast"}}
		{link "cL12" "cR12" {anm "ladder_fast"}}

		{link "n2" "cR1" {anm "ladder_super_fast"}}
		{link "n2" "cR2" {anm "ladder_super_fast"}}
		{link "n2" "cR3" {anm "ladder_super_fast"}}
