		{place "cR11" {attach squat_lie} {linkbone "cR11"}}
		{place "cR12" {attach squat_lie} {linkbone "cR12"}}
	}
	{boarder
		{door "dL1"}
		{door "dL2"}
		{door "dL3"}
		{door "dL4"}
		{door "dL5"}
		{door "dL6"}
		{door "dL7"}
		{door "dL8"}
		{door "dL9"}
		{door "dL10"}
		{door "dL11"}
		{door "dL12"}
		{node "nL0"}
		{node "n1"}

		{door "dR1"}
		{door "dR2"}
		{door "dR3"}
		{door "dR4"}
		{door "dR5"}
		{door "dR6"}
		{door "dR7"}
		{door "dR8"}
		{door "dR9"}
		{door "dR10"}
		{door "dR11"}
		{door "dR12"}
		{node "nR0"}
		{node "n2"}

		{anm "walk"
			{forward {speed 1.2} {loop "walk_normal_gun_up" -1}}
			{reverse {speed 1.2} {loop "walk_normal_gun_up" }}
		}
		{anm "ladder"
			{forward {speed 1.2} {loop "stand_upstairs"} {fix_orientation}}
			{reverse {speed 1.2} {loop "stand_upstairs" -1} {fix_orientation}}
		}
		{anm "ladder_fast"
			{forward {speed 4.8} {loop "stand_upstairs"} {fix_orientation}}
			{reverse {speed 4.8} {loop "stand_upstairs" -1} {fix_orientation}}
		}
		{anm "ladder_super_fast"
			{forward {speed 100} {loop "stand_upstairs"} {fix_orientation}}
			{reverse {speed 100} {loop "stand_upstairs" -1} {fix_orientation}}
		}

		{link "nL0" "dL1" {anm "walk"}}
		{link "nL0" "dL2" {anm "walk"}}
		{link "nL0" "dL3" {anm "walk"}}
		{link "nL0" "dL4" {anm "walk"}}
		{link "nL0" "dL5" {anm "walk"}}
		{link "nL0" "dL6" {anm "walk"}}
