	{placer
		{place "cL1" {attach squat_lie} {linkbone "cL1"}}
		{place "cL2" {attach squat_lie} {linkbone "cL2"}}
		{place "cL3" {attach squat_lie} {linkbone "cL3"}}
		{place "cL4" {attach squat_lie} {linkbone "cL4"}}
		{place "cL5" {attach squat_lie} {linkbone "cL5"}}
