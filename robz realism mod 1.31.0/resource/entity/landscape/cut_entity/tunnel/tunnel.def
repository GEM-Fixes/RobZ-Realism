{
	(include "/properties/trench.inc")
	{Extension "tunnel.mdl"}
	{props "sand" "trench_weak"}
	("boneLand"  args "trench_ground")
	("boneLand"  args "trench_ground2")
	{ObstacleID "unbreakable"}

	{Volume "cL1"
