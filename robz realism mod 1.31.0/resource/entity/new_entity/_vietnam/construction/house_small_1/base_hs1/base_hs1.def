	("vol_body_fire" name(body4) mm(10))
	("vol_body_fire" name(body5) mm(10))
	("vol_body_fire" name(body6) mm(10))
	("vol_body_fire" name(body7) mm(10))
	("vol_body_tagged" name(body8) mm(10))
	("vol_body_tagged" name(body9) mm(10))
	("vol_body_no_obstacle" name(body10) mm(10))
