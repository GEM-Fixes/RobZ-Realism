(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/construction.inc")
	{Extension "bridge_small.mdl"}
	{props "parts" "construction" "no_destroyed_stamp" "wood" "burning"}

	{Volume "body"
		{Tags  "body" "fire"}
		{Thickness 30}
		{able clear {blast}}
	}
	("vol_body_fire" name(body1) mm(30))
	("vol_body_fire" name(body2) mm(30))
	{Extender "land_patch"
		{TerrainType "road" "bridge_wood"}
	}
}
