(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/construction.inc")
	{Extension "base3_hm1.mdl"}
	{props "cornered" "wood" "parts" "construction" "burning" "wood_stamp" "wall"}
	("armor_house_wood")
	{mass 1000}
	{obstacleID "small_building"}

	("vol_body_tagged" name(body1) mm(10))
	("vol_body_tagged" name(body2) mm(10))
	("vol_body_no_obstacle" name(body3) mm(10))
	("vol_body_fire" name(body4) mm(10))
	("vol_body_fire" name(body5) mm(10))
	("vol_body_no_obstacle" name(body6) mm(10))
	{Extender "land_patch"
		{nonormals 1}
	}
}
