(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/construction.inc")
	("armor_light" args 0.5)
	{Extension "tunnel_jap_mgun.mdl"}
	{props "construction" "parts" "wood" "no_destroyed_stamp" "disable_area" "small" "burning"}
	("armor_heavy" args 0.8)
	{obstacleID "small_building"}
	{placer}
	{extender "structure"
		{place "gun_nest" "mg42_stan" "browning_stan" "type1hmg_stan_fix"}
	}
	("vol_body_visible" name(body1) mm(50))
	("vol_body_visible" name(body2) mm(50))
	("vol_body_hidden" name(body_ro) mm(50))
	("vol_body_hidden" name(body_3) mm(50))
	("vol_body_visible" name(body_4) mm(50))
	{Extender "land_patch"
	}
}
