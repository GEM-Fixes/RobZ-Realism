(include "/properties/robz/volumes.inc")
{construction
	(include "/properties/building.inc")
	{props "concrete" "burning"}
	{obstacleid "unbreakable"}
	("armor_heavy" args 1.0)
	{Extension "bunker_01_b.mdl"}
	{placer}
	{extender "structure"
		{place "roof" "ardenn_trench_baza_wall_roof_10"}
		{place "door" "bunker_01_door_04" "bunker_01_door_03"}
		{place "win" "bunker_win_01" "bunker_win_02"}
		{place "wall" "bunker_01_wall_caz_b"}
		{place "gun_nest_01" "mg42_stan" "browning_stan"}
		{place "gun_nest_02" "mg42_stan" "browning_stan"}
	}
	("vol_body_visible" name(body) mm(50))
	("vol_body_visible" name(body10) mm(50))
	("vol_body_visible" name(body11) mm(50))
	("vol_body_hidden" name(body12_r) mm(50))
	("vol_body_visible" name(body13) mm(50))
	("vol_body_visible" name(body14) mm(50))
	("vol_body_hidden" name(body2_r) mm(50))
	("vol_body_visible" name(body3) mm(50))
	("vol_body_visible" name(body4) mm(50))
	("vol_body_visible" name(body5) mm(50))
	("vol_body_visible" name(body6) mm(50))
	("vol_body_visible" name(body7) mm(50))
	("vol_body_visible" name(body8) mm(50))
	("vol_body_visible" name(body9) mm(50))
	{Extender "land_patch"
	}
}
