(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/building.inc")
	{props "concrete"}
	{obstacleid "unbreakable"}
	{Extension "dot_pz_wall_l.mdl"}
	("armor_heavy" args 1.0)

	{Placer
		{place "gun"
			{entity "pz_turret"}
			{Linkbone "attach1"}
			{obstacle disable}
		}
		{place "mgun"
			{entity "mg34_tower"}
			{Linkbone "attach2"}
			{obstacle disable}
		}
	}

	("vol_body_visible" name(body) mm(100))
	("vol_body_visible" name(body01) mm(100))
	("vol_body_visible" name(body02) mm(100))
	("vol_body_visible" name(body03) mm(100))
	("vol_body_visible" name(body04) mm(100))
	("vol_body_visible" name(body05) mm(100))
	("vol_body_visible" name(body06) mm(100))
	("vol_body_visible" name(body07) mm(100))
	("vol_body_visible" name(body08) mm(100))
	("vol_body_visible" name(body09) mm(100))
	("vol_body_visible" name(body10) mm(100))
	("vol_body_visible" name(body11) mm(100))
	("vol_body_visible" name(body12) mm(100))
	("vol_body_visible" name(body13) mm(100))
	("vol_body_visible" name(body14) mm(100))
	("vol_body_visible" name(body15) mm(100))
	("vol_body_visible" name(body16) mm(100))
	("vol_body_visible" name(body17) mm(100))
	("vol_body_visible" name(body18) mm(100))
	("vol_body_visible" name(body19) mm(100))
	{Volume "hole1"
		{able clear {hole}}
	}
	{Volume "hole2"
		{able clear {hole}}
	}
	{Volume "roof01"
		{Tags  "body"}
		{Thickness 100}
		{able {visible 0}{holed}}
	}
	{Volume "roof02"
		{Tags  "body"}
		{Thickness 100}
		{able {visible 0}}
	}
}
