;SDL
(include "car_crew.ext")
(include "tank_crew.ext")
;//////////////////////////////////////////////////////////////////////////////
;//////////////////////////////////////////////////////////////////////////////
; crew_kangaroo_visible_anm: {placer {place}} {boarder {door} {link}}
;   place - name of {place}, name of {linkbone}, text in {link}
;   visor - name of {visor}
;   door1 - name of {door}, name of {link}
;   door2 - name of {door}, name of {link}
;   anm_left - name of {anm}
;   anm_right - name of {anm}
;   e.g. ("crew_kangaroo_visible_anm" place(%place) door1(%door1) door2(%door2) visor(%visor) anm_left(left) anm_right(right))
(define "crew_kangaroo_visible_anm"
	{placer
		{place "%place"
			{group "crew"}
			{linkbone "%place"}
			{attach squat_lie}
			{visor "%visor"}
			{openForCrush}
		}
	}
	{boarder
		{door "%door1"}
		{door "%door2"}
		{link "%door1" "%place" {anm "%anm_left"} {forward putoff} {reverse puton}}
		{link "%door2" "%place" {anm "%anm_right"} {forward putoff} {reverse puton}}
	}
)
; crew_kangaroo_visible: calls "crew_kangaroo_visible_anm"
;   place - name of {place} via "crew_kangaroo_visible_anm", name of {linkbone} via "crew_kangaroo_visible_anm", text in {link} via "crew_kangaroo_visible_anm"
;   door1 - name of {door} via "crew_kangaroo_visible_anm", name of {link} via "crew_kangaroo_visible_anm"
;   door2 - name of {door} via "crew_kangaroo_visible_anm", name of {link} via "crew_kangaroo_visible_anm"
;   visor - name of {visor} via "crew_kangaroo_visible_anm"
;   e.g. ("crew_kangaroo_visible" place(seat00) door1(emit1) door2(emit2) visor(main))
(define "crew_kangaroo_visible"
	("crew_kangaroo_visible_anm" place(%place) door1(%door1) door2(%door2) visor(%visor) anm_left(left) anm_right(right))
)

; kangaroo_4_passengers: calls "seat_inside" "passenger_invisible"
;   e.g. ("kangaroo_4_passengers")
(define "kangaroo_4_passengers"
	("seat_inside")
	("passenger_invisible" place(seat10) bone(seat10)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat11)	bone(seat11)	door(emit3) animation(passenger))
	("passenger_invisible" place(seat12)	bone(seat12)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat13)	bone(seat13)	door(emit3)	animation(passenger))
)
; kangaroo_6_passengers: calls "kangaroo_4_passengers" "passenger_invisible"
;   e.g. ("kangaroo_6_passengers")
(define "kangaroo_6_passengers"
	("kangaroo_4_passengers")
	("passenger_invisible" place(seat14)	bone(seat14)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat15)	bone(seat15)	door(emit3)	animation(passenger))
)
; kangaroo_8_passengers: calls "kangaroo_6_passengers" "passenger_invisible"
;   e.g. none (not called)
(define "kangaroo_8_passengers"
	("kangaroo_6_passengers")
	("passenger_invisible" place(seat16)	bone(seat16)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat17)	bone(seat17)	door(emit3)	animation(passenger))
)
