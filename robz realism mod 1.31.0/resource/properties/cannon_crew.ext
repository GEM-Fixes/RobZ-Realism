;SDL

;//////////////////////////////////////////////////////////////////////////////
; crew_inside: {boarder {anm}}
;   e.g. ("crew_inside")
(define "crew_inside"
	{boarder
		{anm "gunner"
			{forward	{end "seat_driver_car"}}
		}
		{anm "commander"
			{forward	{end "seat_driver_car"}}
		}
		{anm "passenger"
			{forward	{end "seat_driver_car"}}
		}
	}
)
; crew_human: {placer {place}} {boarder {door} {link}}
;   place - name of {place}, name of {group}, text in {link}
;   bone - name of {linkbone}
;   animation - name of {anm}
;   e.g. ("crew_human" place(driver) door1(emit1) door2(emit2) visor(driver))
(define "crew_human"
	{placer
		{place "%place"
			{group "%place"} {linkbone "%bone"} {turnoff {sensor} {shadow}} {openForCrush}
		}
	}
	{boarder
		{door "emit"}
		{door "emit1"}
		{door "emit2"}
		{door "emit3"}
		{door "emit4"}
		{link "emit" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit1" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit2" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit3" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit4" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
	}
)

; crew_human_invisible: {placer {place}} {boarder {door} {link}}
;   place - name of {place}, text in {link}
;   visor - name of {visor}
;   animation - name of {anm}
;   e.g. none (not called)
(define "crew_human_invisible"
	{placer
		{place "%place"
			{group "crew"} {visor "%visor"}
		}
	}
	{boarder
		{door "emit"}
		{door "emit1"}
		{door "emit2"}
		{door "emit3"}
		{door "emit4"}
		{link "emit" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit1" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit2" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit3" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		{link "emit4" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
	}
)

; crew_2_human: {placer {place}}, calls "crew_inside" "crew_human"
;   e.g. ("crew_2_human")
(define "crew_2_human"
	("crew_inside")
	("crew_human" place(gunner)		bone(gunner)	door(emit1) animation(gunner))
	("crew_human" place(commander)	bone(commander)	door(emit2) animation(commander))
	{placer
		{place "gunner" {group "crew"}}
		{place "commander" {group "crew"}}
	}
)
; crew_gunner: calls "crew_inside" "crew_human"
;   e.g. none in the mod (called from vanilla files)
(define "crew_gunner"
	("crew_inside")
	("crew_human" place(gunner)		bone(gunner)	door(emit) animation(gunner))
)

; stand_human: {placer {place}} {boarder {door} {link}}
;   place - name of {place}, name of {group}, text in {link}
;   bone - name of {linkbone}
;   animation - name of {anm}
;   e.g. ("stand_human" place(gunner) bone(gunner) animation(gunner))
(define "stand_human"
	{placer
		{place "%place" {group "%place"} {linkbone "%bone"} {turnoff {sensor}} {openForCrush}}
	}
	{boarder
		{door "emit"}
		{door "emit1"}
		{door "emit2"}
		{door "emit3"}
		{door "emit4"}
		{link "emit"	"%place" {anm "%animation"} {forward putoff}}
		{link "emit1"	"%place" {anm "%animation"} {forward putoff}}
		{link "emit2"	"%place" {anm "%animation"} {forward putoff}}
		{link "emit3"	"%place" {anm "%animation"} {forward putoff}}
		{link "emit4"	"%place" {anm "%animation"} {forward putoff}}
	}
)

; crew_stan_gunner: {boarder {anm}}, calls "stand_human"
;   e.g. none in the mod (called from vanilla files)
(define "crew_stan_gunner"
	{boarder
		{anm "gunner"
			{forward	{end "pose_mgun_stan"}}
		}
	}
	("stand_human" place(gunner)	bone(gunner)	animation(gunner))
)
{placer
	{place "gunner" {visor "main"}}
}

; crew_gun: {placer {place}} {boarder {link}}, calls "crew_2_human" "crew_human"
;   e.g. ("crew_gun")
(define "crew_gun"
	("crew_2_human")
	("crew_human" place(driver1) bone(driver1) door(emit1) animation(driver1))
	("crew_human" place(driver2) bone(driver2) door(emit2) animation(driver2))
	{placer
		{place "driver1" {visor "commander"}}
		{place "driver2" {visor "commander"}}
	}
	{boarder
		{link "driver1" "gunner"}
		{link "driver2" "commander"}
	}
)

; crew_wheeled_gun: {placer {place}} {boarder {link}}, calls "crew_gun" "crew_human"
;   e.g. ("crew_wheeled_gun")
(define "crew_wheeled_gun"
	("crew_gun")
	("crew_human" place(seat1)   bone(seat1)   door(emit1) animation(seat1))
	("crew_human" place(seat2)   bone(seat2)   door(emit2) animation(seat2))
	{placer
		{place "seat1" {visor "commander"}}
		{place "seat2" {visor "commander"}}
	}
	{boarder
		{link "seat1" "driver1"}
		{link "seat2" "driver2"}
	}
)

; crew_4_human_two_commanders: {boarder} {placer} {boarder}, calls "crew_human"
;   e.g. none (not called)
(define "crew_4_human_two_commanders"
	("crew_human" place(commander1)		bone(commander1)		door(emit3) animation(commander1))
	("crew_human" place(commander2)		bone(commander2)		door(emit4) animation(commander2))
	("crew_human" place(driver3)		bone(driver3)			door(emit3) animation(driver3))
	("crew_human" place(driver4)		bone(driver4)			door(emit4) animation(driver4))
	{boarder
		{anm "commander1"
			{forward	{end "pose_squat_watch_binocular" 10}}
		}
		{anm "commander2"
			{forward	{end "pose_m8_charger" 10}}
		}
		{anm "driver3"
			{forward {end "mgun_browning_driver_l" 10}}
		}
		{anm "driver4"
			{forward {end "mgun_browning_driver_r" 10}}
		}
	}
	{placer
		{place "commander1" {group "crew"}}
		{place "commander2" {group "crew"}}
		{place "driver3" {visor "commander"}}
		{place "driver4" {visor "commander"}}
	}
	{boarder
		{link "driver3" "commander1"}
		{link "driver4" "commander2"}
	}
)
; crew_gun_extended: calls "crew_4_human", per mod "mp"
;   e.g. none (not called)
(define "crew_gun_extended"
	(mod "mp"
		("crew_4_human")
	)
)
