;SDL
{sensor
	{visor "main"
		{vision "cannon_main"}
		{bone "visor"}
	}
	{visor "commander"
		{vision "cannon_crew"}
		{bone "visor2"}
	}
}

; armor_cannon: {armor {setting}}
;   tur - {thickness}, mm, {value}, [?]
;   t_thr - {value}, [?]
;   t_dur - {value}, [?]
;   s - {thickness}, mm
;   w - {thickness}, mm
;   b - {thickness}, mm
;   e.g. ("armor_cannon" tur(5) t_thr(3) t_dur(8) s(3) b(5) w(10))
(define "armor_cannon"
	{armor
		{setting "turret"
			{thickness %tur}
			{threshold  {blast {value %t_thr}}}	;
			{durability {blast {value %t_dur}}}	;
			{volumes "turret*"}
		}
		{setting "gun"
			{thickness %tur}
			{threshold  {blast {value (* 0.8 %t_thr)}}}	;
			{durability {blast {value (* 0.8 %t_dur)}}}	;
			{volumes "gun*"}
		}
		{setting "shield"
			{thickness %s}
			{durability
				{blast {value (* %tur 3)}}
				{pierce {value 999}}
			}
			{volumes "shield*"}
		}
		{setting "wheel"
			{thickness %w}
			{volumes "wheel*"}
		}
		{setting "body"
			{thickness %b}
			{threshold  {blast {value %t_thr}}}
			{durability {blast {value %t_dur}}}
			{volumes "body*"}
		}
	}
)

; armor_mortar: calls "armor_cannon"
;   e.g. ("armor_mortar")
(define "armor_mortar"
	("armor_cannon" tur(5) t_thr(3) t_dur(8) s(3) b(5) w(10))
)
; armor_light: calls "armor_cannon"
;   e.g. ("armor_light" args 0.5)
(define "armor_light"
	("armor_cannon" tur(7) t_thr(3) t_dur(10) s(4) b(10) w(10))
)
; armor_medium: calls "armor_cannon"
;   e.g. ("armor_medium" args 1.0)
(define "armor_medium"
	("armor_cannon" tur(7) t_thr(6) t_dur(15) s(4) b(10) w(14))
)
; armor_heavy: calls "armor_cannon"
;   e.g. ("armor_heavy" args 0.8)
(define "armor_heavy"
	("armor_cannon" tur(7) t_thr(7) t_dur(20) s(10) b(10) w(14))
)


; loco_params: {StopTime} {BrakeTime} {TurnRadius} {TurnStart} {TurnStop} {Gears} +1 more
;   e.g. ("loco_params")
(define "loco_params"
	{StopTime	0.2}
	{BrakeTime	0.7}
	{TurnRadius	3}
	{TurnStart	0.8}
	{TurnStop	0.5}
	{Gears		0.35 0.5 0.7 1.0}
	{RearGears	0.33 0.5}
)


; loco_carrier: {locomotion {MaxSpeed} {StartTime} {TurnTime} {TurnRadius}}
;   e.g. ("loco_carrier")
(define "loco_carrier"
	{locomotion
		("loco_params")
		{MaxSpeed	15}
		{StartTime	1}
		{TurnTime	4}
		{TurnRadius	2}
	}
)

