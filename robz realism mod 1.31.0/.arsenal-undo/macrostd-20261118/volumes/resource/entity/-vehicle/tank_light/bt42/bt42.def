{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{collider "tank.light"}
	{props "light" "turret_rotator" "vision_vehicle_medium" "muzzle_minimum"}


	{patherId "tank.light"}

	{extender "enumerator"}
	{Volume "Body1"
		{tags "body"}
		{component "body"}
	}
	{Volume "Body2"
		{tags "body"}
		{component "body"}
	}
	("armor_light" turret(20) body(20 13 13 10))
	("armor_engine"  t(13))
	("armor_mantlet"  t(13))
	{extender "inventory"
		{box
			{item "ammo bullet114_fin fg"  24}
		;{item "ammo bullet114_fin sr"  10}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "qf45" filling "ammo bullet114_fin fg" 1}
			{charger "gunner"}
			("abm_low_v4")

		}

	}
	("crew_4_human")
	{boarder
		{anm "left"
			{forward    {begin  "board_kv"}}
			{reverse    {end    "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward    {begin  "board_tank_right"}}
			{reverse    {end    "emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward    {begin  "board_MiddleArmor"}    {end "pose_seat_armor_1"}}
			{reverse    {end    "emit_tank_1"}}
		}
		{anm "armor1"
			{forward    {begin  "board_MiddleArmor"}    {end "pose_seat_armor_2"}}
			{reverse    {end    "emit_body"}}
		}
	}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))
	{mass 18900}
	{Chassis
		("tank_trace_ex" fx("tracks_sm") step(0.3) len(1.0) boneleft("wheell4") boneright("wheelr4"))
		{Locomotion ("locomotion")
			{MaxSpeed 30}
			{maxSpeedAtMaxTurn 8}
			{StartTime 25}
			{TurnTime 15}
			{TurnStart  1.1}
			{TurnRadius 7}
			{TurnStop   0.6}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears  0.2 0.5 1}
			{RearGears  0.27}
		}
		{FuelBag
			{volume 790 }
			{rate   100 }
			{remain 790 }
			{fuel "fuel"}
		}
		{speed
			{Normal  12}
			{Slow  18}
		}
	}

	{Extension "bt42.mdl"}
	{bone "gun_rot"
		{speed 0.003}
		{limits -25 14}
	}
	{bone "turret"
		{speed 0.003}
	}
;("turret_speed_medium")
;("rus_1_sight")
}
