{game_entity
	(include "/properties/cannon.ext")
	{props "vehicle" "cannon" "wheeled" "round_sandbag2" "vision_cannon_medium" "muzzle_medium_sides" "gun_mode_change" "medium_weapons"}


	("armor_medium")

	{volume "body1"
		{tags "body"}
		{component "body"}
	}
	{volume "body2"
		{tags "body"}
		{component "body"}
	}
	{component "shield"
		{RepairTime 20}
	}
	{volume "shield1"
		{tags "shield"}
		{component "shield"}
		{thickness 20}
	}
	{volume "shield2"
		{tags "shield"}
		{component "shield"}
		{thickness 20}
	}
	{volume "shield"
		{tags "shield"}
		{component "shield"}
		{thickness 20}
	}

	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward	{end "pose_pak40_gunlayer" 10}}
		}
		{anm "commander"
			{forward	{end "pose_pak40_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon_right" 10}}
		}
	}
	("wheel" args "wheelright")
	("wheel" args "wheelleft")

	{extender "inventory"
		{box
			{item "bullet75 ger apcbc" 45}
			{item "bullet75 ger fg" 10}
			{item "bullet75 ger apcr" 5}
			{item "sandbag_kit2"}
		}
	}
	{Weaponry
		{place "gun"
			{weapon "75mm_dt"  filling "ammo bullet75 ger apcbc"}
			{RestoreIKAfterAim}
			{Rotate}
			("abm_field_gun")
		}
		{place "gun1_2"
			{type "gun_change_arty"}
			{weapon "75mm_dt_2"}
			{basic}
			{charger "gunner"}
			{StationaryFiring}
			{Rotate}
			("abm_howitzer")
		}
	}

	{mass 1760}
	{Extension "resita.mdl"}
	(include "/properties/selection/cannon.inc"  scale(0.7))

	{bone "basis"
		{limits}
		{speed 0.007}
	}



	{extender "cannon"
		{animation
			{switch "close"}
			{move "cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim "cannon_zis3_gunlayer" ""}
			{fire  "Cannon_gunlayer_fire-alert" "Cannon_zis3_charger_fire 0.2"}
			{reload  "" "Cannon_zis3_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		(mod "mp" {rotate_ik_Limit 0})
	}



	{Chassis "track"
		("car_trace" fx("tracewheel03") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("loco_medium")
	}
	{bone "turret"
		{limits -27 27}
		{speed 0.0006}
	}
	{bone "gun_rot"
		{speed 0.0006}
	}
;("ger_3_sight")
}
