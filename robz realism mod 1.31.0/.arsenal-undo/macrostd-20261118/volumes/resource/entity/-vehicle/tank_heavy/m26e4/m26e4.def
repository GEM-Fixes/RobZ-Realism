	{Volume "hole_man"
		{able clear {hole}}
		{component "turret"}
	}
	{volume "mantlet"
		{thickness 114.3
			;	{front	114.3}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "zip1"	;€щик на башне
		{component "zipl1"}
		{thickness 6}
	}
	{Volume "zipl1"	;€щик зип слева
