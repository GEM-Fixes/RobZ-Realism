{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "heavy" "turret_rotator" "vision_vehicle_maximum" "muzzle_large_sides"}

	; --- Godny hitbox armor (ported from GodnyMod: m26e4.def) ---
