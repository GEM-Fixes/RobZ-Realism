{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "heavy" "-turret" "vision_vehicle_maximum" "muzzle_large_sides"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: elefant.def) ---
	{volume "body1"	;нижн€€ передн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 60
			{front	200}	;нлд
			{rear	0.1}	;внутренн€€ стенка
			{top	40}	;гласис
			{bottom	50}	;20мм + 30мм
			{right	80}	;нижний передний скос
		}
	}
	{volume "body2"	;нижн€€ задн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 60
			{front	10}	;стенка моторного
			{rear	80}
			{top	0.1}	;внутренн€€ стенка
			{bottom	20}
			{right	80}	;нижний задний скос
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 80	;борта и передние боковые скосы
			{front	200}
			{rear	10}	;стенка моторного
			{top	30}	;крышка моторного
			{bottom	20}
		}
	}
	{volume "body4"	;рубка
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 80
			{front	200}	;влд
			;	{rear	80}
			{top	30}
			{bottom	20}
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "turret"}
	}
	{volume "mantlet"
		{thickness 30
		;	{front	30}
		;	{rear	30}	;30+30
		}
	}
	{volume "gun_rot1"	;кожух ствола
		{tags "gun"}
		{component "gun"}
		{thickness 30}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "shield1"	;бронировка вокруг шарового креплени€ оруди€
		{thickness 80
			;	{front	80}
			{rear	20}	;толщина самого шарового приблизительно
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	; --- end Godny hitbox armor ---
	("armor_spa_heavy" armor(200 80 80 40))
	("armor_engine"  t(100 80 80 40))
	("armor_mantlet" t(125))
	("ger_5x8_sight")

	("crew_4_human_extended")
	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_gunner_stand"} {base "open_driver" -1}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_Kv-85"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_Is-2"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	;	("gunner_visible")
	("crew_human" place(charger) door1(emit1) door2(emit2))
	{placer
		{place "commander" {visor "back"}}
	}

	("seat_human" place(seat1) bone(seat01) door(emit5)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit3)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6)  animation(armor1))

	{sensor
		{visor "back"
			{vision "tank_back"}
			{bone "foresight4"}
		}
	}

	{extender "inventory"
		{box
			{item "ammo bullet88 gerl apcbc" 29}
			{item "ammo bullet88 gerl fg" 20}
			;{item "ammo bullet88 gerl apcr" 4}
			{item "ammo bullet88 gerl heat" 5}
			{item "ammo mg_mauser belt" 2500}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_pak43" filling "ammo bullet88 gerl apcbc" 1}
			("abm_low_v4")
		}
		{place "mgun"
			{type "mgun_hull"}
			{weapon "mg34_optic" filled}
			{foresight "foresight3"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 65000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.20) len(0.65))
		{Locomotion ("locomotion")
			{Maxspeed    18}
			{maxSpeedAtMaxTurn 2.5}
			{StartTime   50}
			{BrakeTime  2.5}
			{StopTime   3.5}
			{TurnStart  2.5}
			{TurnTime    30}
			{TurnStop     1}
			{TurnRadius   14}
			{Gears     0.1 0.2 0.28 1.0}
			{RearGears 0.1 0.2}
		}
		{FuelBag
			{volume 950 }
			{rate	105 }
			{remain 950 }
			{fuel "fuel"}
		}
		{speed
			{Normal  10}
			{Slow  12}
		}
	}

	{Extension "elefant.mdl"}

	{bone "gun_rot"
		{speed 0.001}
		{limits -10 25}
	}
	{bone "gun_rot1"
		{speed 0.001}
		{limits -7 7}
	}
	{bone "mgun"
		{limits 10}
		{speed2 80}
	}
}
