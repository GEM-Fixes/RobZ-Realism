{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "medium" "-turret" "vision_vehicle_medium" "muzzle_maximum" "gun_mode_change"}
	{tag "diesel_exhaust"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: su122.def) ---
	{volume "body"	;прилив пушки
		{tags "body"}
		{component "body"}
		;{able {holed}}	;вариант с отдельной маской сложно реализовать из-за щелей при вращении оруди€
		{thickness 52
			{rear	15}	;внутренн€€ стенка
		}
	}
	{volume "body1"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 45
			;	{front	45}
			;	{rear	45}
			{top	0.1}	;внутренн€€ стенка
			{bottom	15}
			{right	100}	;передн€€ балка между нлд и влд
		}
	}
	{volume "body2"	;рубка
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 45
			;	{front	45}
			;	{rear	45}
			{top	20}
			{bottom	20}
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 40
			{front	0.1}	;внутренн€€ стенка
			{rear	45}
			{top	20}
			{bottom	20}
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "body"}
	}
	{volume "mantlet"
		{thickness 52
			;	{front	52}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{Volume "mantlet2"	;бронировка откатных
		{tags "gun"}
		{component "gun"}
		{thickness 45}
	}
	{Volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	{volume "body4"
		{tags "body"}
		{component "body"}
		{thickness 75}
	}
	{volume "body5"
		{tags "body"}
		{component "body"}
		{thickness 75}
	}

	{volume "mantlet1"
		{tags "gun"}
		{component "gun"}
		{thickness 75}
	}

	("armor_spa_light" armor(45 45 45 22))
	("armor_engine"  t(30 45 45 22))
	("armor_mantlet" t(65))
	("rus_2-5x_sight")

	("crew_4_human_extended")
	{boarder
		{anm "driver"
			{forward	{begin	"board_t34_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"emit_t34_hold"} {base "close_driver"}}
		}
		{anm "left"
			{forward	{begin	"board_Is-2"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_Is-2"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_body"} {end "seat_isu1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor3"
			{forward	{begin	"board_body"} 	{end "seat_isu"}}
			{reverse 	{end	"emit_tank_2"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor2))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor3))

	{Weaponry
		{place "gun"
			{weapon "122mm_m30s" filling "ammo bullet122 rus fg" 1}
			("abm_direct_how")
		}
		{place "gun1_2"
			{type "gun_change_arty"}
			{weapon "122mm_m30s_2"}
			{StationaryFiring}
			("abm_howitzer")
			{basic}
		}
	}

	{extender "inventory"
		{box
			{item "ammo bullet122 rus fg" 22}
			{item "ammo bullet122 rus heat" 6}
			{item "ammo bullet122 rus wp" 6}
		}
	}

	{mass 30900}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.28))
		{Locomotion ("locomotion")
			{maxspeed   34}
			{maxSpeedAtMaxTurn 5}
			{StartTime	       30}
			{TurnTime	        15}
			{TurnStart        1.5}
			{BrakeTime        4}
			{StopTime         1.5}
			{TurnRadius         8}
			{TurnStop         0.7}
			{Gears      0.1 0.25 0.35 1.0}
			{RearGears       0.27}
		}
		{FuelBag
			{volume 810 }
			{rate	24 }
			{remain 810 }
			{fuel "fuel"}
		}
		{speed
			{Normal  34}
			{Slow  34}
		}
		{DisableMoveWhileFiring}
	}
	{Extension "su122.mdl"}

	{bone "gun_rot"
		{limits -3 25}
		{speed 0.001}
	}
	{bone "gun_rot1"
		{speed 0.001}
	}
}

