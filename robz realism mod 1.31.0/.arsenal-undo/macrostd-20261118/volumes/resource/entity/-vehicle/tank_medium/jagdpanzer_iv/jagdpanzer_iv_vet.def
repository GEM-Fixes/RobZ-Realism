{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "-turret" "vision_vehicle_high" "muzzle_large"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: jagdpanzer_iv.def) ---
	{Volume "body1"	;рубка верхн€€ часть
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 30
			{front	80}	;60 дл€ L48
			{rear	30}
			{top	20}
			{bottom	20}
		}
	}
	{Volume "body2"	;рубка нижн€€ часть
		{tags "body"}
		{component "body"}
		;	{able {holed}}
		{thickness 30
			{front	80}
			{rear	30}
			{top	0.1}	;внутренн€€ стенка
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{Volume "body3"	;верхн€€ часть корпуса и гласис
		{tags "body"}
		{component "body"}
		{thickness 30
			{front	60}
			{rear	22}
			{top	20}	;гласис
			{bottom	20}
		}
	}
	{Volume "body4"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 30
			{front	50}
			{rear	22}
			{top	20}
			{bottom	20}
		}
	}
	{Volume "body5"	;прилив пушки
		{tags "body"}
		{component "body"}
		{thickness 80
			{rear	0.1}	;внутренн€€ стенка
		;	{right	15}	;орудие дает небольшую броню
		}
	}
	{Volume "body6"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 30
			{front	10}
			{rear	22}
			{top	10}
			{bottom	10}
		}
	}
	{Volume "body7"	;моторное низ
		{tags "body"}
		{component "body"}
		{thickness 30
			{front	10}
			{rear	22}
			{top	20}
			{bottom	10}
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "body"}
	}
	{volume "mantlet"
		{thickness 75
			;	{front	75}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	{Volume "engine1"
		{tags "engine"}
		{component "engine"}
		{thickness 40}
	}
	{Volume "engine2"
		{tags "engine"}
		{component "engine"}
		{thickness 40}
	}

	("armor_spa_heavy" armor(80 40 20 22) armor2(80 30 20 22) armor3(80 30 20 22) armor4(80 30 20 22) armor5(80 30 20 22))
	("armor_mantlet" t(80))
	("armor_engine"  t(30 40 40 22))
	("ger_5x8_sight")

	("crew_4_human")

	("shield" args 10)

	{extender "shield"
		{on}
	}
	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldl4" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}
	{component "shieldr4" {tags "shield"}}

	("gunner_visible")
	{boarder
		{anm "left"
			{forward	{begin	"board_Kv"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}

	}

	{extender "inventory"
		{box
			{item "ammo bullet75 gerl apcbc" 27}
			{item "ammo bullet75 gerl fg" 22}
			{item "ammo bullet75 gerl apcr" 5}
			{item "ammo mg_mauser belt" 900}
		}
	}

	{Weaponry
		{place "gun"
			{weapon "75mm_stuk42_vet" filling "ammo bullet75 gerl apcbc" 1}
			{RestoreIKAfterAim}
			("abm_veteran")
		}
		{place "mgun"
			{type "mgun_hull"}
			{weapon "mg42" filled}
			{foresight "foresight3"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 24500}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.7))
		{Locomotion ("locomotion")
			{MaxSpeed	 27}
			{maxSpeedAtMaxTurn 4}
			{StartTime	  38.25}
			{TurnTime  	  17.1}
			{TurnStart  1.4}
			{BrakeTime    1}
			{StopTime     2}
			{TurnRadius   8}
			{TurnStop   0.8}
			{Gears  0.13 0.23 0.33 1}
			{RearGears 0.28}
		}
		{FuelBag
			{volume 470 }
			{rate	36 }
			{remain 470 }
			{fuel "fuel"}
		}
		{speed
			{Normal  27}
			{Slow  27}
		}
	}

	{Extension "jagdpanzer_iv.mdl"}

	{bone "gun_rot"
		{speed 0.0012}
	}
	{bone "gun_rot2"
		{speed 0.0012}
	}
}
