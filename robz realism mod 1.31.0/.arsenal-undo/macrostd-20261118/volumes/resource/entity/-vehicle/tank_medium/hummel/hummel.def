{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "-turret" "opened" "vision_vehicle_high" "muzzle_maximum_nodust" "gun_mode_change_art"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: hummel.def) ---
	{volume "sticky"
		{tags "grenade_fg_target"}
		{able clear {contact} {touch}}
		{component "sticky_body"}
	}
	{volume "body1"	;передн€€ (носова€) часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 20
			{front	30}	;нлд
			{rear	10}	;стенка моторного
			;	{top	20}
			{bottom	10}
			{right	15}	;гласис
		}
	}
	{volume "body2"	;задн€€ нижн€€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 20
			{front	0.1}	;внутренн€€ стенка
			;	{rear	20}
			{top	0.1}	;внутренн€€ стенка
			{bottom	10}
		}
	}
	{volume "body3"	;рубка
		{component "body"}
		{tags "body"}
		{able {holed}}
		{thickness 10
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body4"	;передн€€ нижн€€ часть рубки - изгиб
		{component "body"}
		{tags "body"}
		{thickness 10
			{front	0.1}	;внутренн€€ стенка
			{rear	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body5"	;мехвод
		{component "body"}
		{tags "body"}
		{thickness 20
			{front	30}
			;	{rear	20}
			;	{top	20}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "mantlet"
		{thickness 20
			;	{front	20}
			{rear	10}	;орудие дает небольшую броню
		}
	}
	{Volume "hole_bod"
		{able clear {hole}}
		{component "body"}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "body"}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "inventory"
		{thickness 2}
	}
	{volume "detail7"
		{component "detail7"}
		{thickness 7.5}
	}
	; --- end Godny hitbox armor ---
	{component "sticky_body"}
	("armor_spa_heavy" armor(30 20 20 15))
	("shield" args 15)

	{boarder
		{anm "driver"
			{forward	{begin	"board_hummel_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"board_hummel_driver" -1} {base "open_driver" }}
		}
		{anm "charger"
			{forward	{begin	"board_hummel"} {end "pose_pak40_gunlayer"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
		{anm "gunner"
			{forward	{begin	"board_hummel"} {end "pose_pak40_charger"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
		{anm "commander"
			{forward	{begin	"board_hummel"} {end "pose_pak40_gunlayer"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
	}

	(include "/properties/robz/crew.inc")

	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner" {visor "main"}}
	}
	{boarder
		{door "emit0"}
		{door "emit1"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}

	("crew_human_two_doors" place(commander)	door1(emit1))
	("crew_human_two_doors" place(gunner)	    door1(emit1))
	("crew_human_two_doors" place(charger)	door1(emit1))

	{extender "inventory"
		{box
			{item "ammo bullet150 ger fg" 9}
			{item "ammo bullet150 ger sm" 6}
		}
	}
	{Weaponry
		{place "gun"
			{weapon "150mm_sfh18" filling "ammo bullet150 ger fg" 3}
			{StationaryFiring}
			("abm_howitzer")
		}
		{place "gun1_2"
			{RestoreIKAfterAim}
			{type "gun_change_direct"}
			{weapon "150mm_sfh18_2"}
			{basic}
			("abm_direct_how")
		}
	}

	{mass 24000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.56) len(0.167))
		{Locomotion ("locomotion")
			{MaxSpeed   24}
			{maxSpeedAtMaxTurn 5}
			{StartTime  45}
			{TurnStart  1.7}
			{TurnTime   16}
			{TurnRadius 10}
			{TurnStop   0.9}
			{BrakeTime  1}
			{StopTime   2}
			{Gears      0.1 0.2 0.3 1}
			{RearGears  0.3}
		}
		{FuelBag
			{volume 470 }
			{rate	36 }
			{remain 470 }
			{fuel "fuel"}
		}
		{speed
			{Normal  24}
			{Slow  24}
		}
		{DisableMoveWhileFiring}
	}
	{Extension "Hummel.mdl"}

	{bone "gun_rot1"
		{speed 0.0005}
	}
	{bone "gun_rot"
		{speed 0.0005}
	}
	(mod "mp"
		{brain
			{properties
				{fire_mode hold}
			}
		}
	)
}
