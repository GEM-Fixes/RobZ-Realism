{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "turret_rotator" "vision_vehicle_high" "muzzle_medium" "gun_mode_change"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: m10wolverine.def) ---
	{volume "sticky"
		{tags "grenade_fg_target"}
		{able clear {contact} {touch}}
		{component "sticky_body"}
	}
	{volume "body1"	;нижн€€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 25.4	;борта и корма
			{front	50.8}	;трансмисси€
			{rear	85}	;промежуточна€ брон€ на фронте трансмиссии
			{right	114}	;максимальна€ брон€ на фронте трансмиссии
			{top	0.1}	;внутренн€€ стенка
			{bottom	12.7}
		}
	}
	{volume "body2"	;верхн€€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 19.05
			{front	38.1}
			{rear	10}	;внутренн€€ стенка
			;	{top	19.05}
			{bottom	12.7}
		}
	}
	{volume "body3"	;мто
		{component "body"}
		{tags "body"}
		{thickness 19.05
			{front	10}	;внутренн€€ стенка
			;	{rear	19.05}
			{top	9.5}
			{bottom	12.7}
		}
	}
	{volume "body4"	;подбашенное кольцо
		{component "body"}
		{tags "body"}
		{thickness 38.1
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "turret"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 25.4
			;	{front	25.4}
			;	{rear	25.4}
			;	{top	25.4}
			{bottom	12.7}
		}
	}
	{Volume "turret1"	;бронировка цапф
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 25.4
			{rear	0.1}	;внутренн€€ стенка
		}
	}
	{Volume "turret2"	;противовес и брон€ задней части башни
		{component "turret"}
		{tags "turret"}
		{thickness 100
			{front	0.1}	;внутренн€€ стенка
			{top	50}
			{bottom	50}
		}
	}
	{Volume "turret3"	;противовес и брон€ задней части башни
		{component "turret"}
		{tags "turret"}
		{thickness 100
			{front	0.1}	;внутренн€€ стенка
			{top	50}
			{bottom	50}
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "turret"}
	}
	{Volume "hole_tur"
		{able clear {hole}}
		{component "turret"}
	}
	{volume "mantlet"
		{thickness 57
			;	{front	57}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "shield1"	;задн€€ часть юбки
		{component "shield1"}
		{thickness 5
			{top	0.1}	;внутренн€€ стенка
		}
	}
	{volume "shieldl1"
		{component "shieldl1"}
		{thickness 5}
	}
	{volume "shieldr1"
		{component "shieldr1"}
		{thickness 5}
	}
	; --- end Godny hitbox armor ---
	{Volume "turret4"
		{tags "turret"}
		{component "turret"}
	}
	{Volume "turret5"
		{tags "turret"}
		{component "turret"}
	}
	{Volume "turret6"
		{tags "turret"}
		{component "turret"}
	}
	{Volume "turret7"
		{tags "turret"}
		{component "turret"}
	}
	("armor_medium_advanced" turret(35 25 25 19) body(38 19 20 22) body2(51 25 20 22))
	("armor_engine"  t(40 25 25 19))
	("armor_mantlet" t(57))
	("us_5x_sight")

	("crew_4_human")

	{boarder

		{anm "left"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "gunner"
			{forward	{begin	"board_hummel"} {end "pose_pak40_gunlayer"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
		{anm "commander"
			{forward	{begin	"board_hummel"} {end "pose_seat_armor_2"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
	}


	("gunner_visible")
	("crew_human" place(driver)	door1(emit1) door2(emit2) visor(driver))
	("crew_human_visible" place(commander) door1(emit1) door2(emit2) visor(main))
	("crew_human_visible" place(gunner)	door1(emit1) door2(emit2) visor(main))
	{placer
		{place "commander" {openForCrush 0}}
		{place "gunner" {openForCrush 0}}
	}


	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "inventory"
		{box
			{item "ammo bullet76 us3inch ap" 40}
			{item "ammo bullet76 us3inch fg" 13}
			{item "browning" filling "ammo hmgun ap" 100 {user "mgun"}}
			{item "ammo hmgun ap" 400}
			{item "ammo mgun" 3150}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m7" filling "ammo bullet76 us3inch ap" 1}
			("abm_high")
		}
		{place "gun1_2"
			{type "gun_change_arty"}
			{weapon "76mm_m7_2"}
			{StationaryFiring}
			("abm_howitzer")
		}
		{place "mgun"
			{type "mgun_aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun_heavy")
			{basic}
		}
	}

	{mass 42500}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.50) len(0.6))
		{Locomotion ("locomotion")
			{maxspeed   34}
			{maxSpeedAtMaxTurn 4.5}
			{StartTime  30}
			{TurnTime   17}
			{TurnStart  1.7}
			{TurnRadius 10}
			{TurnStop   0.7}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears   0.1 0.23 0.32 1}
			{RearGears  0.27}
		}
		{FuelBag
			{volume 750 }
			{rate	32 }
			{remain 750 }
			{fuel "fuel"}
		}
		{speed
			{Normal  34}
			{Slow  34}
		}
		{DisableMoveWhileFiring}
	}
	{Extension "m10wolverine.mdl"}
	{bone "turret_mgun"
		{limits -22 38}
		{speed 0.03}
		{terminator}
	}
	{bone "turret"
		{speed 0.002}
	}
	{bone "gun_rot"
		{speed 0.0008}
	}
}
