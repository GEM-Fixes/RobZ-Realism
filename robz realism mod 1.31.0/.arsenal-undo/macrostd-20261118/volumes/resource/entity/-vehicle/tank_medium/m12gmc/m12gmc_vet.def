{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "medium" "turret_rotator" "vision_vehicle_high" "muzzle_maximum_nodust" "gun_mode_change_art" "m12gmc"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: m12gmc.def) ---
	{volume "sticky"
		{tags "grenade_fg_target"}
		{able clear {contact} {touch}}
		{component "sticky_body"}
	}
	{volume "body1"	;нижняя часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 19.05
			{front	50.8}	;трансмиссия
			{rear	0.1}	;внутрення стенка
			{top	25.4}	;влд
			{bottom	19.05}
		}
	}
	{Volume "body2"	;мехвод
		{tags "body"}
		{component "body"}
		{thickness 19.05
			{front	25.4}
			{rear	0.1}	;внутрення стенка
			{top	12.7}
			{bottom	0.1}	;внутрення стенка
			{right	0.1}	;внутрення стенка
		}
	}
	{Volume "body3"	;нижняя часть корпуса
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 19.05
			{front	0.1}	;внутренняя стенка
			;	{rear	19.05}
			{top	12.7}
			{bottom	12.7}
		}
	}
	{Volume "body4"	;моторное
		{tags "body"}
		{component "body"}
		{thickness 0.1
			{front	10}
			{rear	12.7}
			{top	12.7}
		;	{bottom	0.1}	;внутренняя стенка
		}
	}
	{Volume "body5"	;правая консоль
		{tags "body"}
		{component "body"}
		{thickness 16.0
			;	{front	16.0}
			;	{rear	16.0}
			{top	12.7}
			{bottom	12.7}
		}
	}
	{Volume "body6"	;правая консоль
		{tags "body"}
		{component "body"}
		{thickness 16.0
			;	{front	16.0}
			;	{rear	16.0}
			{top	12.7}
			{bottom	12.7}
		}
	}
	{Volume "hole_bod"
		{able clear {hole}}
		{component "body"}
	}
	{Volume "mantlet1"
		{tags "mantlet"}
		{component "mantlet"}
	}
	{Volume "mantlet3"
		{tags "mantlet"}
		{component "mantlet"}
	}
	{Volume "mantlet"
		{tags "mantlet"}
		{component "mantlet"}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "bucket"
		{component "bucket"}
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	{component "sticky_body"}

	("armor_spa_heavy" armor(51 19 19 13))
	("armor_engine"  t(5 5 5 5))
	("armor_mantlet" t(15))

	("crew_4_human")

	{boarder
		{anm "driver"
			{forward	{begin	"board_su76"}}
			{reverse 	{end	"board_su76" -1}}
		}
		{anm "charger"
			{forward	{begin	"board_hummel"} {end "pose_pak40_charger"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}

		}
		{anm "gunner"
			{forward	{begin	"board_hummel"} {end "pose_pak40_gunlayer"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
		{anm "gunner2"
			{forward	{begin	"board_su76"} {end "seat_driver_car"}}
			{reverse 	{end	"board_su76" -1}}
		}
		{anm "commander"
			{forward	{begin	"board_hummel"} {end "pose_seat_armor_2"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
	}

	(include "/properties/robz/crew.inc")

	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{boarder
		{door "emit1"}
		{door "emit2"}
		{link "emit1" "driver" {anm "driver"} {forward putoff} {reverse puton}}
		{link "emit2" "driver" {anm "driver"} {forward putoff} {reverse puton}}
		{link "emit1" "commander" {anm "commander"} {forward putoff} {reverse puton}}
		{link "emit2" "commander" {anm "commander"} {forward putoff} {reverse puton}}
	}

	("crew_human_visor_main" place(gunner) door1(emit1) door2(emit2) visor(main))
	("crew_human_visor_main" place(charger)	door1(emit1) door2(emit2))
	("crew_human_visor_main" place(commander)	door1(emit1) door2(emit2))

	{placer
		{place "commander" {group "crew"} {visor "main"}}
	}

	{extender "inventory"
		{box
			{item "ammo bullet155 us fg" 6}
			{item "ammo bullet155 us sm" 3}
			{item "ammo bullet155 us wp" 3}
			{item "ammo bullet155 us aphe" 2}
		}
	}
	{Weaponry
		{place "gun"
			{weapon "155mm_m12_vet" filling "bullet155 us fg" 3}
			{Rotate}
			{StationaryFiring}
			("abm_howitzer")
		}
		{place "gun1_2"
			{RestoreIKAfterAim}
			{type "gun_change_direct"}
			{weapon "155mm_m12_2_vet"}
			("abm_veteran")
			{basic}
		}
	}

	{mass 42500}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.6))
		{Locomotion ("locomotion")
			{MaxSpeed   22}
			{maxSpeedAtMaxTurn 4.5}
			{StartTime  30}
			{TurnStart  1.8}
			{TurnTime   17}
			{TurnRadius 9}
			{TurnStop   0.8}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.3}
		}
		{FuelBag
			{volume 660 }
			{rate	35 }
			{remain 660 }
			{fuel "fuel"}
		}
		{speed
			{Normal  22}
			{Slow  22}
		}
		{DisableMoveWhileFiring}
	}
	{Extension "m12_gmc.mdl"}

	{bone "mantlet"
		{limits -15 15}
		{speed 0.0005}
	}
	{bone "gun_rot"
		{limits -5 50}
		{speed 0.0005}
	}
	(mod "mp"
		{brain
			{properties
				{fire_mode hold}
			}
		}
	)
}
