{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{props "vehicle" "armored_car" "tank" "turret" "turret_rotator" "wheeled" "with_gun" "vision_vehicle_low" "muzzle_small" "switch_mgun_coax"}
	{targetClass "armoredcar" "ap bullet"}
	{targetSelector "tank"}
	{PatherId "vehicle.small"}

	{extender "enumerator"}
	{extension "crew.ext"}

	; --- Godny hitbox armor (ported from GodnyMod: mk2daimler.def) ---
	{volume "body1"	;бо
		{tags "body"}
		{component "body"}
		{thickness 10
			{front	0.1}	;стык body1 и body2
			{rear	14}
			{top	8}
			{bottom	6}
		}
	}
	{volume "body2"	;мехвод
		{tags "body"}
		{component "body"}
		{thickness 10
			{front	16}
			{rear	0.1}	;стык body1 и body2
			{top	8}
			{bottom	0.1}	;стык body2 и body3
		}
	}
	{volume "body3"	;гласис
		{tags "body"}
		{component "body"}
		{thickness 10
			{front	14}
			{rear	0.1}	;стык body1 и body3
			{top	8}
			{bottom	6}
		}
	}
	{volume "body4"	;нижняя передняя часть, передний мост
		{tags "body"}
		{component "body"}
		{thickness 10
			{front	14}
			{rear	0.1}	;стык body1 и body4
			{top	8}
			{bottom	6}
		}
	}
	{volume "body5"	;мто
		{tags "body"}
		{component "body"}
		{thickness 10
			;	{front	10}
			{rear	14}
			{top	5}
			{bottom	6}
		}
	}
	{volume "zip1"	;ящик зип на морде
		{component "zip1"}
		{thickness 6}
	}
	{volume "turret"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 14
			{front	16}
			{rear	14}
			;	{top	6}
			{bottom	6}
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "turret"}
	}
	{volume "mantlet"
		{thickness 16
			;	{front	16}
			{rear	10}	;орудие дает небольшую броню
		}
	}
	{Volume "Gun"
		{tags "no_target"}
		{able {Visible 0} {Obstacle 0} {Contact 0}}
		{thickness 10}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "detail1"
		{component "detail1"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{volume "crew"
		{able {contact_ground 0}}
	}
	{component "turret"
		{RepairTime 10}
	}

	{component "Gun"
		{RepairTime 20}
	}

	("armor_medium" args 1.0)
	("eng_1-9x_sight")

	{extender "inventory"
		{box
			{item "bullet40 eng ap" 52}
			;{item "bullet40 fg" 27}
			;{item "bullet40 apcr" 2}
			{item "ammo mg_mauser belt red" 2700}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "40mm_oqf2pdr" filling "bullet40 eng ap" 1}
			("abm_low_v2")
		}
		{place "mgun"
			{type "mgun_coaxial"}
			{weapon "besa_optic" filling "mg_mauser belt red" 225}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")
	("wheel" args "wheelright3")
	("wheel" args "wheelleft3")

	{mass 8130}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	38}
			{maxSpeedAtMaxTurn 6}
			{StartTime	30}
			{BrakeTime	1.5}
			{StopTime	2.5}
			{TurnRadius	6}
			{Gears  0.1 0.2 0.3 1}
			{RearGears 0.25}
		}
		{FuelBag
			{volume 45 }
			{rate	10 }
			{remain 45 }
			{fuel "fuel"}
		}
		{speed
			{Normal  38}
			{Slow  38}
		}
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}
	{Extension "mk2daimler.mdl"}

	{bone "turret"
		{speed 0.004}
	}
	{bone "gun_rot"
		{speed 0.001}
	}
	{bone "coaxial_mgun"
		{limits 6}
	}
}
