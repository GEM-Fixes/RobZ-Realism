{entity
	(include "/properties/tank_unarmed.ext")
	(include "/properties/selection/vehicle.inc" scale(0.85))
	{collider "tank.light"}
	{props "vehicle" "armored_car" "tractor" "tank" "explosion_throw_crew" "vision_vehicle_low" "heavy_tractor" "t20"}
	{targetClass "tank" "bullet"}
	{targetSelector "tank_bullet"}
	{patherId "tank.light"}
	{tag "heavy_tow"}

	("armor_light" turret(0) body(3 3 3 3))
	("armor_engine"  t(3 3 3 3))

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"} {end "seat_passenger"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "seat_passenger"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
	}

	("crew_human_visible_anm" place(driver) door1(emit1) door2(emit1) visor(driver) anm_left(left) anm_right(left))


	{sensor
		{Visor "driver"
			{vision "moto_around"}
			{bone "visor1"}
		}
	}
	{extender "inventory"
		{box

		}
	}
	{mass 2500}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(-0.95))
		{Locomotion ("locomotion")
			{maxspeed   18}
			{maxSpeedAtMaxTurn 11}
			{StartTime 20}
			{TurnTime 12}
			{TurnStart  0.8}
			{TurnRadius 6}
			{TurnStop   0.5}
			{BrakeTime  1}
			{StopTime   1.5}
			{Gears  0.1 0.35 0.7}
			{RearGears  0.43}
		}
		(mod "mp"
			{FuelBag
				{volume 550 }
				{rate	3.2 }
				{remain 545 }
				{fuel "fuel"}
			}
			{speed
				{Normal  10}

			}
		)
	}
	{Extension "k50.mdl"}
	{volume "body"
		{tags "body"}
		{component "body"}
		{thickness 3}
	}
	{Volume "engine"
		{component "engine"}
	}
	{Volume "trackleft"
		{thickness 5}
	}
	{Volume "trackright"
		{thickness 5}
	}
}
