{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{collider "tank.light"}
	;{props "light" "zenite" "turret_rotator" "flak" "vision_vehicle_medium" "muzzle_minimum" }
	{props "medium" "zenite" "turret_rotator" "flak" "opened" "vision_vehicle_high" "muzzle_zenite"}
	{patherId "tank.light"}
	;{targetClass "light_tank" "bullet"}
	;{targetSelector "tank_aa"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{Volume "body1"
		{tags "body"}
		{component "body"}
	}
	{Volume "body2"
		{tags "body"}
		{component "body"}
	}
	{Volume "body3"
		{tags "body"}
		{component "body"}
	}
	{Volume "body4"
		{tags "body"}
		{component "body"}
	}
	{Volume "turret1"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	{Volume "turret2"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	{Volume "turret3"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	{Volume "turret4"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	{Volume "turret5"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	{Volume "turret6"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	{Volume "turret7"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	{Volume "turret8"
		{tags "turret"}
		{thickness 28}
		{component "turret"}
	}
	("armor_light" turret(28) body(20 16 14 8))
	("armor_engine"  t(16))


	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_driver_car"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "gunner"
			{forward	{begin	"board_tank_left"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "gunner1"
			{forward	{begin	"board_tank_right"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "charger"
			{forward	{begin	"board_tank_left"} {end "seat_armor"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "commander"
			{forward	{begin	"board_tank_right"} {end "seat_armor"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
	}

	(define "crew_human"
		{placer
			{place "%place"
				{group "crew"}
				{linkbone "%place"}
				{turnoff {sensor} {shadow}}
				{visor "main"}
			}
		}
		{boarder
			{door "%door1"}
			{door "%door2"}
			{link "%door1" "%place" {anm "%place"} {forward putoff} {reverse puton}}
			{link "%door2" "%place" {anm "%place"} {forward putoff} {reverse puton}}
		}
	)
	("crew_human" place(gunner)	    door1(emit1) door2(emit2))
	("crew_human" place(charger)	door1(emit1) door2(emit2))
	("crew_human" place(gunner1)	door1(emit1) door2(emit2))
	("crew_human" place(commander)	door1(emit1) door2(emit2))
	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{boarder
		{door "emit0"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}
	{placer
		{place "gunner" {openForCrush 0}}
	}

	{extender "inventory"
		{box
			{item "bullet40_hun zenite" 80}
			{item "bullet40_hun zenite fg" 80}
		;{item "bullet40_hun zenite heat" 12}

		}
	}
	{Weaponry
		{place "gun"
			{weapon "40mm_bofors_36m" filled}
			("abm_zenite")
		}
	}

	{mass 22000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.21))
		{Locomotion ("locomotion")
			{MaxSpeed	 28}
			{maxSpeedAtMaxTurn 4}
			{StartTime	  40}
			{TurnTime  	  19}
			{TurnStart  1.4}
			{BrakeTime    1}
			{StopTime     2}
			{TurnRadius   8}
			{TurnStop   0.8}
			{Gears  0.1 0.2 0.3 1}
			{RearGears 0.28}
		}
		{FuelBag
			{volume 470 }
			{rate	35 }
			{remain 470 }
			{fuel "fuel"}
		}
		{speed
			{Normal  28}
			{Slow  28}
		}
	}

	{Extension "nimrod.mdl"}

	{bone "turret"
		{speed 0.005}
	}
	{bone "gun_rot"
		{speed 0.003}
	}
;("turret_speed_zenite")

}
