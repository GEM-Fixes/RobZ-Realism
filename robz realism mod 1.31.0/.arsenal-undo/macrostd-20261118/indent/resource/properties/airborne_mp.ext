;SDL
actor

(include "vehicle.ext")
("brain_vehicle")
{collider "airborne"}
{props "airborne" "vision_vehicle_air"}

{targetClass "airborne"}
{targetSelector "airborne"}
{PatherID  "airborne"}

{extender "vitality"
	{Health
		{max 		2400}	; max health
		{current 	2400}	; current health
		{inc 		0}	; health regeneration per second
	}
}

{sensor
	{Visor "main"
		{bone  "body"}
		{vision "air"}   ;New vision for planes
	}
	{RecognizeTime 0.001}
	{InformRange 150 150}		;first - AI ;second - USER
}

{Weaponry
    {Manualaccuracy 1}
    {place "mgun01"
    {rotate}
    }
    {place "mgun02"
    {rotate}
    }
    {place "mgun03"
    {rotate}
    }
    {place "mgun04"
    {rotate}
    }
    {place "bomb"
        {Rotate}
    }
}


{Chassis "wheel"
	("chassis_defaults")
	{locomotion
		{MaxSpeed 	 	25 } ; максимальная скорость, kmph
		{StartTime 		5  } ; время разгона до макс. скорости с 0, seconds
		{BrakeTime 		1  } ; время торможения с макс. скорости до 0, seconds
		{StopTime		3  } ; время остановки после отключения двигателя с макс. скорости до 0, seconds
	}
	{dontUseSlope}
	{ignorePatherBounds}
	{disableBackward}
}
{Chassis "airborne"
	("chassis_defaults")
	{locomotion
		{Maxspeed 		95 } ; kmph
 	  	{turnRadius 	40 } ; m
		{StartTime 		6  } ; время разгона до макс. скорости с 0, seconds
		{BrakeTime 		4  } ; время торможения с макс. скорости до 0, seconds
		{StopTime		7  } ; время остановки после отключения двигателя с макс. скорости до 0, seconds
	}
	{dontUseSlope}
	{ignorePatherBounds}
	{disableBackward}
	{sideSlopeSpeed 25}			;degree/s
	{maxSideSlope 45}			;degree
	{maxElevationSpeed 10}		;m/s
	{elevationAcceleration 4}	;m/s^2
	(mod "mp"
		{Altitude 58}
	)
	{FuelBag
        		{volume 8000 }   ; liters
        		{rate   50 }    ; liters per kilometer
        		{remain 8000 }
        		{fuel "fuel"}
    	}
}
{extender "talk"
	{talker "tank"}
}
{ChassisManager
	{Current "airborne"}
}

{simulatorId "airborne"}

{extender "inventory"
	{box
		{Size 8 8}
		{weight 25000}
	}
}
(define "aircraft_vitality"
	{Extender "vitality"
		{Health
			{max (*1 %hp)}
			{current (* 1 %hp)}
			{inc 0}
		}

	}
)

(define "accuracy_by_motion" ;  spreading depending on the speed of "body", "gun" volumes
    {AccuracyByMotion
        {MaxLinearSpeed %max_linear}               ;km/h
        {ByLinearSpeed %accuracy_by_linear}
        {MaxAngularSpeed %max_angular}             ;deg/s
        {ByAngularSpeed %accuracy_by_angular}
        {DisorderTime %disorder_time}              ;s
        {OrderTime %order_time}                    ;s
    }
)
(define "abm_zenite"
    ("accuracy_by_motion"
        max_linear(15) accuracy_by_linear(0.3)
        max_angular(4) accuracy_by_angular(0.8)
        disorder_time(1.2) order_time(1.4)
    )
)
{volume "propeller"
	{tags "part"}
	{thickness 10}
	{able {visible 0}}
}
{volume "engine"
	{tags "body" "inflammable"}
	{thickness 3}
	{able {visible 1}}
}
{volume "body"
	{tags "body"}
	{thickness 3}
	{able {visible 0}}
}
{volume "body_back"
	{tags "body"}
	{thickness 3}
	{able {visible 0}}
	{density 0.01}
}
{volume "cabine"
	{tags "part"}
	{thickness 3}
	{able {visible 0}}
}
{volume "wingr1"
	{tags "inflammable" "part"}
	{component "wingright"}
	{thickness 3}
	{able {visible 0}}
}
{volume "wingl1"
	{tags "inflammable" "part"}
	{component "wingleft"}
	{thickness 3}
	{able {visible 0}}
}
{volume "wingr2"
	{tags "inflammable" "part"}
	{thickness 3}
	{able {visible 0}}
}
{volume "wingl2"
	{tags "inflammable" "part"}
	{thickness 3}
	{able {visible 0}}
}
{volume "wheel_back"
	{tags "part"}
	{thickness 2}
	{able {visible 0}}
}
{volume "retract_wheelR"
	{tags "part"}
	{thickness 3}
	{able {visible 0}}
}
{volume "retract_wheelL"
	{tags "part"}
	{thickness 3}
	{able {visible 0}}
}

{component "propeller"
	{RepairTime 10}
}
{component "engine"
	{RepairTime 10}
}
{component "body"
	{RepairTime 20}
}
{component "cabine"
	{RepairTime 10}
}
{component "body_back"
	{RepairTime 10}
}
{component "wingright"
	{RepairTime 10}
}
{component "wingleft"
	{RepairTime 10}
}
{component "wingr2"
	{RepairTime 10}
}
{component "wingl2"
	{RepairTime 10}
}
{component "wheel_back"
	{RepairTime 8}
	{tags "mover"}
}
{component "retract_wheelR"
	{RepairTime 8}
	{tags "mover"}
}
{component "retract_wheelL"
	{RepairTime 8}
	{tags "mover"}
}

(define "locomotion"
	{StartTime	5	}		; время разгона до макс. скорости с 0, seconds
	{BrakeTime	2	}		; время торможения с макс. скорости до 0, seconds
	{StopTime	4	}		; время остановки после отключения двигателя с макс. скорости до 0, seconds
	{SteerOn	15}			; скорость поворота колес, градусов в секунду
	{SteerOff	15}         ; скорость возврата колес в исх. состояние, градусов в секунду
	{SplineRadius 5}		; ограничение радиуса поворота на сплайнах, метров
)

(define "part"
	{volume %0
		{tags "part"}
		{thickness 0.5}
		{able {visible 0}}
	}
	{component %0}
)

(define "armor_airborne"
    {armor
        {setting "body"
            {thickness %bod}
            {durability
                {blast
                    {koef %dur}
                }
        		{pierce
                    {koef %pierce_dur}
                }
            }
            {threshold
                {blast
                    {koef %thr}
                }
            }
