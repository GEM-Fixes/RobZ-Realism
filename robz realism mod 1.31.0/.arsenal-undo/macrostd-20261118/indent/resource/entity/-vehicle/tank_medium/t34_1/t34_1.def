{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "vision_vehicle_high" "muzzle_small"}
	{tag "diesel_exhaust"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: t34_1.def) ---
	{volume "body1"	;нижн€€ часть корпуса
		{component "body"}
		{tags "body"}
		{thickness 45	;нижний борт 45мм
		;	{front	45}
		;	{rear	45}
			{top	0.1}	;внутренн€€ стенка
			{bottom	20}
			{right	100}	;передн€€ балка между нлд и влд
		}
	}
	{volume "body2"	;верхн€€ часть корпуса, бо
		{component "body"}
		{tags "body"}
		{able {holed}}
		{thickness 40	;верхний борт 40мм
			{front	45}
			{rear	10}	;стенка мто
			{top	20}
			{bottom	20}
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 40
			{front	10}	;стенка мто
			{rear	45}
			{top	20}	;мто
			{bottom	20}
		}
	}
	{volume "body4"	;люк мехвода
		{tags "body"}
		{component "body"}
		{thickness 40
		;	{front	40}
			{rear	0.1}	;внутренн€€ стенка
		}
	}
	{volume "turret"
		{tags "turret"}
		{component "turret"}
		{able {holed}}
		{thickness 52
			{front	52}
			{rear	52}
			{top	20}
			{bottom	20}
			{right	25}	;лобовой скос крыши
		}
	}
	{volume "turret1"	;барбет
		{tags "turret"}
		{component "turret"}
		{thickness 52
		;	{front	52}
		;	{rear	52}
			{top	0.1}	;внутренн€€ стенка
			{bottom	20}
		}
	}
	{Volume "hole_bod"
		{able clear {hole}}
		{component "body"}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "turret"}
	}
	{volume "mantlet"
		{thickness 40
		;	{front	40}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "zipl1"
		{tags "zipl1"}
		{component "zipl1"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{volume "turret2"
		{component "turret"}
		{tags "turret"}
	}
	{volume "turret3"
		{component "turret"}
		{tags "turret"}
	}
	{volume "turret4"
		{component "turret"}
		{tags "turret"}
	}
	{volume "turret5"
		{component "turret"}
		{tags "turret"}
	}
	{Volume "Gun"
		{thickness 30}
	}

    ("armor_medium" turret(52 52 52 20) body(45 45 45 22))
	("armor_engine"  t(30 40 45 20))
	("armor_mantlet" t(40))
	("rus_2-5x_sight")

	("crew_4_human_extended")
	{boarder
		{anm "driver"
			{forward	{begin	"board_t34_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"emit_t34_hold"} {base "close_driver"}}
		}
		{anm "left"
			{forward	{begin	"board_Is-2"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_Is-2"} {end "seat_m7_mgunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
	}

;	("crew_human_visible" place(gunner2) door1(emit1) door2(emit2) visor(main))

;	("gunner_visible")

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "inventory"
		{box
			{item "ammo bullet57 rus aphebc" 39}
			{item "ammo bullet57 rus fg" 33}
			{item "ammo bullet57 rus apcr" 4}
            {item "ammo dt29_mag" 2400}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "57mm_zis4" filling "ammo bullet57 rus aphebc" 1}
			("abm_medium")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "dt_optic" filled}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "dt" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
		}
	}

	{mass 28000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.28))
		{Locomotion ("locomotion")
			{maxspeed   36}
			{maxSpeedAtMaxTurn 5}
			{StartTime	       30}
			{TurnTime	        15}
			{TurnStart        1.5}
    		{BrakeTime        4}
     		{StopTime         1.5}
    		{TurnRadius         8}
    		{TurnStop         0.7}
    		{Gears      0.1 0.25 0.35 1.0}
    		{RearGears       0.27}
		}
		{FuelBag
			{volume 790 }
			{rate	22 }
			{remain 790 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  36}
        	{Slow  36}
    	}
	}
	{Extension "t34-57.mdl"}

	{bone "turret"
		{speed 0.0038}
	}
	{bone "gun_rot"
		{speed 0.001}
	}
}
