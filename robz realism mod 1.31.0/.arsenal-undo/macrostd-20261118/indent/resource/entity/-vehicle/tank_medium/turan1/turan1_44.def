{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "vision_vehicle_medium" "muzzle_minimum"}

	{volume "body1"
		{component "body"}
		{tags "body"}
	}
	{volume "body2"
		{component "body"}
		{tags "body"}
	}
	{volume "engine"
		{component "engine"}
;		{thickness 15}
	}
	{Volume "gun"
		{component "gun"}
		{tags "gun"}
	}
	{Volume "mantlet"
		{component "mantlet"}
		{tags "mantlet"}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
	}

	("armor_medium" turret(50 30 30 10) body(50 30 50 22))
	("armor_engine"  t(30 30 50 20))
	("armor_mantlet" t(50))
	("shield" args 10)

	{extender "shield"
		{on}
	}
	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldl4" {tags "shield"}}
	{component "shieldl5" {tags "shield"}}
	{component "shieldl6" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}
	{component "shieldr4" {tags "shield"}}
	{component "shieldr5" {tags "shield"}}
	{component "shieldr6" {tags "shield"}}
	{component "shieldr7" {tags "shield"}}
	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "hullmg"
			{bone "foresight4"}
			{vision "tank_driver"}
		}
	}
	("crew_5_human")
	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_LowArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}
	("seat_human" place(seat1) bone(seat01) door(emit5)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit6)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit3)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit4)  animation(armor))
	{extender "inventory"
		{box
            			{item "bullet40_hun ap" 30}
			{item "bullet40_hun fg" 27}
            			{item "ammo bullet40_hun apcr" 5}
            			{item "ammo 8x56" 3150}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "40mm_41M" filling "bullet40_hun ap" 1}
			("abm_medium")
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "gebauer" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "gebauer_optic" filled}
			{foresight "foresight5"}
			("abm_mgun")
            {basic}
		}
	}
	{mass 19200}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1))
		{Locomotion ("locomotion")
			{MaxSpeed   35}
			{maxSpeedAtMaxTurn 11}
			{StartTime 30}
			{TurnStart  1.7}
			{TurnTime 18}
			{TurnRadius 8}
    		{TurnStop   0.7}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears 0.1 0.25 0.7}
			{RearGears  0.15}
		}
		{FuelBag
			{volume 165 }
			{rate	40 }
			{remain 165 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  10}
        	{Slow  16}
    	}
	}
	{Extension "turan1_44.mdl"}

	{bone "turret"
		{speed 0.009}
	}
	;("turret_speed_medium")
	;("ger_1_sight")
}
