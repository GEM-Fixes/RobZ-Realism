			{item "ammo bullet76 eng fg" 32}
			{item "ammo bullet76 eng apds" 4}
			{item "ammo springfield_belt" 2500}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_mk4_vet" filling "ammo bullet76 eng apcbc" 1}
			("abm_veteran")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "browning_m19_optic" filled}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
	}

{Extension "m4a4_firefly.mdl"}

	{mass 32500}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.6))
		{Locomotion ("locomotion")
			{maxspeed   32}
			{maxSpeedAtMaxTurn 4.5}
			{StartTime  28.9}
			{TurnTime   16.2}
			{TurnStart  1.6}
			{TurnRadius 8}
    		{TurnStop   0.8}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears   0.13 0.23 0.33 1}
			{RearGears  0.27}
		}
		{FuelBag
			{volume 660 }
			{rate	35 }
			{remain 660 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  32}
        	{Slow  32}
    	}
	}
	{bone "turret_mgun"
		{limits -15 15}
		{speed 0.03}
		{terminator}
	}
	{bone "turret"
		{speed 0.0042}
	}
	{bone "gun_rot"
		{speed 0.0009}
	}
