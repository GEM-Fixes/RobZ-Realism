{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "vision_vehicle_high" "muzzle_medium"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: cromwell_mk_vii.def) ---
	{volume "body1"	;нос корпуса
		{component "body"}
		{tags "body"}
		{thickness 43	;28,57мм внеш + 14.3мм внутр
			{front	57}	;нлд
			{rear	0.1}	;внутренн€€ стенка
			{top	25.4}	;гласис верхний и нижний
			{bottom	14.35}	;8мм +6,35мм
		}
	}
	{volume "body2"	;низ бо
		{component "body"}
		{tags "body"}
		{thickness 43	;28,57мм внеш + 14.3мм внутр
			{front	63.5}	;влд
			{rear	0.1}	;внутренн€€ стенка
			{top	20}
			{bottom	14.35}	;8мм +6,35мм
		}
	}
	{volume "body3"	;влд
		{component "body"}
		{tags "body"}
		{thickness 31.75
			{front	63.5}
			{rear	0.1}	;внутренн€€ стенка
		;	{top	14}
			{bottom	6.35}
		}
	}
	{volume "body4"	;верх бо
		{component "body"}
		{tags "body"}
		{thickness 46	;31.75мм внеш + 14.3мм внутр
			{front	0.1}	;внутренн€€ стенка
			{rear	0.1}	;внутренн€€ стенка
			{top	20}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body5"	;нижн€€ часть моторного
		{component "body"}
		{tags "body"}
		{thickness 39	;25мм внеш + 14мм внутр
			{front	31.75}
			{rear	31.75}
			{top	14.3}
			{bottom	6.35}
		}
	}
	{volume "body6"	;верхн€€ часть моторного
		{component "body"}
		{tags "body"}
		{thickness 31.75	;31.75мм боковые жабры под наклоном
		;	{front	31.75}
			{rear	25}
			{top	14.3}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body7"	;кожух выхлопа
		{component "body"}
		{tags "body"}
		{thickness 25
			{front	0.1}	;внутренн€€ стенка
		;	{rear	25}
			{top	14.3}
			{bottom	6.35}
		}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
		{thickness 63.7	;51мм внеш + 12,7мм внутр
			{front	76.7}	;64мм внеш + 12,7мм внутр
			{rear	56.7}	;44мм внеш + 12,7мм внутр
			{top	20}
			{bottom	19}
		}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "zipl1"
		{component "zipl1"}
		{thickness 6}
	}
	{volume "zipr1"
		{component "zipr1"}
		{thickness 6}
	}
	{volume "zipr2"
		{component "zipr2"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{Volume "gun"
		{tags "gun"}
		{component "gun"}
	}
	("armor_medium" turret(76 64 57 20) body(64 44 32 14) body2(25 44 32 14) body3(57 44 32 14))
	("armor_engine"  t(10 44 25 14))
	("eng_3x_sight")

	("shield" args 10)

	{extender "shield"
		{on}
	}
	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldl4" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}
	{component "shieldr4" {tags "shield"}}
	("crew_4_human")


	{boarder
		{anm "left"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("crew_human_visible" 	place(gunner2)	door1(emit1) door2(emit2) visor(main))



	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))


	{extender "inventory"
		{box
            {item "ammo bullet75 us ap" 29}
            {item "ammo bullet75 us fg" 34}
            {item "ammo mg_mauser belt red" 2450}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_mk5" filling "ammo bullet75 us ap" 1}
			("abm_high")
		}

		{place "mgun1"
			{type "mgun_hull"}
			{weapon "besa" filling "mg_mauser belt red" 225}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "besa_optic" filling "mg_mauser belt red" 225}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 28000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.2))
		{Locomotion ("locomotion")
            		{MaxSpeed   38}
			{maxSpeedAtMaxTurn 5}
			{StartTime  20}
			{TurnStart  1.7}
			{TurnTime   18}
			{TurnRadius 9}
    		{TurnStop   0.8}
			{BrakeTime  1.5}
			{StopTime   3}
			{Gears   0.1 0.2 0.3 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 420 }
			{rate	33 }
			{remain 420 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  38}
        	{Slow  38}
    	}
	}
{Extension "cromwell_mk_vii.mdl"}
	{bone "turret"
		{speed 0.004}
	}
	{bone "gun_rot"
		{speed 0.0008}
	}
}
