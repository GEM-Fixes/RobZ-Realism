{game_entity
    (include "/properties/tank.ext")

    (include "/properties/selection/vehicle.inc"  scale(1.2))
    {collider "tank.heavy"}
    {props "medium" "-turret" "vision_vehicle_medium" "muzzle_medium"}
	;{targetSelector "tank_at"}

    {extender "enumerator"
		{digit_folder "ger"}
	}

    {volume "body1"
        {tags "body"}
        {component "body"}
    }
    {volume "body2"
        {tags "body"}
        {component "body"}
    }
    {volume "body3"
        {tags "body"}
        {component "body"}
    }

    ("armor_spa_light" armor(75 25 25 22))
    ("armor_engine"  t(25))
	("shield" args 10)


    ("crew_4_human")

    {boarder
        {anm "left"
            {forward    {begin  "board_Kv"}}
            {reverse    {end    "emit_tank_1_hold"}}
        }
        {anm "right"
            {forward    {begin  "board_tank_right"} {end "pose_mgun_pz6"}}
            {reverse    {end    "emit_tank_2_hold"}}
        }

;       {anm "armor"
;           {forward    {begin  "board_HighArmor"}  {end "seat_armor"}}
;           {reverse    {end    "emit_tank_2"}}
;       }
;       {anm "armor1"
;           {forward    {begin  "board_HighArmor"} {end "seat_armor"}}
;           {reverse    {end    "emit_body"}}
;       }
    }

	{extender "shield"
		{on}
	}

	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldl4" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}
	{component "shieldr4" {tags "shield"}}

    {extender "inventory"
        {box
			{item "ammo bullet75_hun ap" 50}
			{item "ammo bullet75_hun fg" 27}
			{item "ammo bullet75_hun apcr" 5}
		}
	}
    {Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_43m" filling "ammo bullet75_hun ap" 1}
			("abm_high")
		}
    }
	{mass 22000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.7))
		{Locomotion ("locomotion")
			{MaxSpeed   30}
			{maxSpeedAtMaxTurn 6}
			{StartTime 	 24.5}
			{TurnTime  	 12}
    		{TurnStart 1.4}
     		{BrakeTime   1}
    		{StopTime    2}
     		{TurnRadius  8}
    		{TurnStop   0.7}
     		{Gears  0.16 0.26 0.36 1}
     		{RearGears 0.28}
		}
		{FuelBag
			{volume 310 }
			{rate	24 }
			{remain 310 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  30}
        	{Slow  30}
    	}
	}

    {Extension "zrinyi1.mdl"}
	;("ger_5_sight")
}
