{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{Extension "sdkfz4.mdl"}
	{props "vehicle" "armored_car" "tank" "turret" "turret_rotator" "wheeled_6" "nebelwerfer" "vision_vehicle_high"}
	{targetClass "armoredcar" "ap fg"}
	{targetSelector "cannon_rocket"}
	{extension "crew.ext"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: sdkfz4.def) ---
	{volume "body1"	;основна€ (задн€€) часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	0.1}	;внутренн€€ стенка
		;	{rear	8}
			{top	6}
			{bottom	6}
		}
	}
	{volume "body2"	;моторное
		{tags "body"}
		{component "body"}
		{thickness 8
		;	{front	8}
			{rear	3}	;внутренн€€ стенка
			{top	6}
			{bottom	6}
		}
	}
	{volume "body3"	;кабина, крыша
		{tags "body"}
		{component "body"}
		{thickness 8
		;	{front	8}
		;	{rear	8}
			{top	6}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "turret"
		{thickness 10
			{top	6}
			{bottom	6}
		}
	}
	{Volume "Gun"
		{tags "no_target"}
		{able {Visible 0} {Obstacle 0} {Contact 0}}
		{thickness 8}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "zipl1"
		{component "zipl1"}
		{thickness 6}
	}
	{volume "zipr1"
		{component "zipr1"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	("armor_medium" args 1.0)

	{component "turret"
		{RepairTime 20}
	}
	{component "gun"
		{RepairTime 15}
	}

	{extender "inventory"
		{box
			{item "ammo nebel41 fg" 10}
			{item "ammo nebel41 sm" 10}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "weapon panzerwerfer42" filling "ammo nebel41 fg" 10}
			{charger "driver"}
			{gunner "driver"}
			{Barrels 10}
			{StationaryFiring}
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")

	{mass 8500}

	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed 26}
	  		{maxSpeedAtMaxTurn 12}
		}
		{FuelBag
			{volume 120}
			{rate	10}
			{remain 120}
			{fuel "fuel"}
		}
		{speed
        	{Normal  26}
        	{Slow  26}
    	}
		; left track must be first
		("tank_trace" fx("tracks_mid") step(0.52) len(0.7) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		{DisableMoveWhileFiring}
	}
	{bone "gun"
		{limits 2.0000 42.0000}
		{speed 0.001}
	}
	{bone "turret"
		{speed 0.002}
	}
	{brain
		{properties
			{fire_mode hold}
		}
	}
}
