{game_entity
	;© 2009 Zeke Wolff & Ngvede.
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{mass 8000}
	{props "vehicle" "armored_car" "tank" "wheeled" "turret" "turret_rotator" "vision_vehicle_high"}
  	;{targetClass "armoredcar" "ap fg bullet"}
	;{targetSelector "tank"}
	{PatherId "vehicle.small"}

	{extension "crew.ext"}

	{volume "body1"
		{tags "body"}
		{component "body"}
		{thickness 15}
	}
	{volume "body2"
		{tags "body"}
		{component "body"}
		{thickness 15}
	}

	{volume "turret"
		{component "turret"}
		{tags "turret" "body"}
		{thickness 15}
	}
	{volume "crew"
		{able {contact_ground 0}}
	}
	{component "turret"
		{RepairTime 10}
	}

	{volume "engine"
		{thickness 15}
	}
	{Volume "detail1"
		{thickness 10}
	}

	("armor_medium" args 1.0)

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{extender "inventory"
		{Box
			{item "ammo ravelli_belt" 1560}

		}

	}
	{Weaponry
		{place "mgun1"
			{foresight "foresight4"}
			{type "mgun_right"}
			{weapon "fiat_14" filled}
			{gunner "gunner1"}
			{charger "gunner1"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{foresight "foresight5"}
			{type "mgun_left"}
			{weapon "fiat_14" filled}
			{gunner "gunner2"}
			{charger "gunner2"}
			("abm_mgun")
			{basic}
		}
		{place "mgun3"
			{type "mgun_rear"}
			{weapon "fiat_14" filled}
			{foresight "foresight6"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
		}
	}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	34}
	  		{maxSpeedAtMaxTurn 15}
			{StartTime 22}
			{BrakeTime	1.5}
			{StopTime	3}
			{TurnRadius	5}
		}
		{FuelBag
			{volume 110}
			{rate	25}
			{remain 110 }
			{fuel "fuel"}
		}
		{speed
        		{Normal  12}
    		}
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}
	{Extension "lancia1zm.mdl"}
}
