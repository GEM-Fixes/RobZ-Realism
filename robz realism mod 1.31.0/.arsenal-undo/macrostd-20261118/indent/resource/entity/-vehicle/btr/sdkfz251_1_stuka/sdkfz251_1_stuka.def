{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{props "vehicle" "armored_car" "tank" "turret" "wheeled_8" "explosion_throw_crew" "nebelwerfer" "vision_vehicle_high"}
	{targetClass "armoredcar" "ap fg"}
	{targetSelector "cannon_rocket"}

	{extender "enumerator"
		{digit_folder "ger"}
	}
	{extension "crew.ext"}

	{extender "shield"
		{on}
	}
	; --- Godny hitbox armor (ported from GodnyMod: sdkfz251_1_stuka.def) ---
	{volume "sticky"
		{tags "grenade_fg_target"}
		{able clear {contact} {touch}}
		{component "sticky_body"}
	}
	{volume "body1"	;дно десантного
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			{front	0.1}	;внутренняя стенка
		;	{rear	8}
			{top	6}
			{bottom	6}
		}
	}
	{volume "body2"	;верх десантного
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			{front	8}
		;	{rear	8}
			{top	6}
			{bottom	6}
		}
	}
	{volume "body3"	;верх моторного
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	0.1}	;внутренняя стенка
			{rear	0.1}	;внутренняя стенка
			{top	8}	;гласис
			{bottom	6}
		}
	}
	{volume "body4"	;низ моторного
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	14.5}
		;	{rear	8}
			{top	0.1}	;внутренняя стенка
			{bottom	6}
		}
	}
	{Volume "mgun_shield"
		{component "mgun_shield"}
		{thickness 10}
	}
	{Volume "hole_bod"
		{able clear {hole}}
		{component "body"}
	}
	{volume "engine"
		{thickness 10}
	}
	{volume "inventory"	;правая боеукладка
		{thickness 3
			{bottom	0.1}
		}
	}
	{volume "inventory1"	;левая боеукладка
		{thickness 3
			{bottom	0.1}
		}
	}
	{volume "detail3"	;трак на морде
		{component "detail3"}
		{thickness 8}
	}
	{volume "zipl1"
		{component "zipl1"}
		{thickness 6}
	}
	{volume "zipr1"
		{component "zipr1"}
		{thickness 6}
	}
	{volume "gun1"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{volume "gun2"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{volume "gun3"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{volume "gun4"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{volume "gun5"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	{volume "gun6"
		{tags "gun"}
		{component "gun"}
		{thickness 15}
	}
	; --- end Godny hitbox armor ---
	{component "sticky_body"}

	{volume "body5"
		{tags "body"}
		{component "body"}
		{thickness 15}
	}
	{volume "body6"
		{tags "body"}
		{component "body"}
		{thickness 15}
	}
	{volume "engine1"
		{tags "engine"}
		{component "engine"}
		{thickness 20}
	}
	{volume "engine2"
		{tags "engine"}
		{component "engine"}
		{thickness 20}
	}
	{Volume "fuel"
		{thickness 1}
	}
	{component "gun"
		{RepairTime 15}
	}

	("armor_medium" args 1.0)

	{placer
		{place "driver"		{group "driver"} {visor "driver"}}
		{place "gunner"		{group "driver"} {visor "main"} {turnoff {targetable 0}}}
	}

	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{box
			{item "mg34" filled {user "mgun"}}
			{item "ammo nebel" 12}
			{item "ammo nebel incendiary" 12}
			{item "ammo mg_mauser drum" 1200}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon			"weapon wurfrahmen40" filled}
			{charger		"gunner"}
			{Barrels		6}
			{StationaryFiring}
		}
		{place "mgun"
			{type			"mgun_aa"}
			{LinkBone		"mgun2"}
			{LinkAnimation	"off"}
			{charger		"gunner"}
			{gunner			"gunner"}
			("abm_mgun")
			{basic}
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")

	{mass 14580}		;7800kg "sdkfz 251/1" + 6x 1130kg "28/32 Nebelwerfer 41"
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	33}
	  		{maxSpeedAtMaxTurn 6}
			{StartTime	30}
			{BrakeTime	1.5}
			{StopTime	2.5}
			{TurnRadius	8}
     			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 160}
			{rate	10}
			{remain 160 }
			{fuel "fuel"}
		}
		{speed
			{Normal  33}
			{Slow  33}
		}
		; left track must be first
		("tank_trace" fx("tracks_mid") step(0.5) len(0.86) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		{DisableMoveWhileFiring}
	}

	{brain
		{properties
			{fire_mode hold}
		}
	}

	{Extension "sdkfz251_Stukazufus.mdl"}

	{bone "turret"
		{speed 0.001}
	}
	{bone "gun1"
		{limits -42 12}		;gun min up to max down
		{speed 0.001}
	}
}
