{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "light" "-turret" "opened" "vision_vehicle_medium" "muzzle_medium_sides"}

	{extender "enumerator"
			{digit_folder "ger2"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: marder_3h.def) ---
	{volume "sticky"
		{tags "grenade_fg_target"}
		{able clear {contact} {touch}}
		{component "sticky_body"}
	}
	{Volume "body1"	;нижн€€ часть корпуса и гласис
		{component "body"}
		{tags "body"}
		{able {holed}}
		{thickness 15
			{front	50}
		;	{rear	15}
			{top	0.1}	;внутренн€€ стенка
			{bottom	8}
			{right	13}	;гласис
		}
	}
	{Volume "body2"	;передн€€ верхн€€ часть корпуса, бо
		{component "body"}
		{tags "body"}
		{able {holed}}
		{thickness 15
			{front	50}
		;	{rear	15}
			{top	8}
			{bottom	8}
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 15
		;	{front	15}
		;	{rear	15}
			{top	8}
			{bottom	8}
		}
	}
	{Volume "body4"	;рубка
		{component "body"}
		{tags "body"}
		{able {holed}}
		{thickness 11
		;	{front	11}
		;	{rear	11}
		;	{top	11}
			{bottom	8}
			{right	0.1}	;внутренн€€ стенка
		}
	}
	{volume "mantlet"
		{thickness 8
		;	{front	8}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{Volume "hole_bod1"
		{able clear {hole}}
		{component "body"}
	}
	{Volume "hole_bod2"
		{able clear {hole}}
		{component "body"}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "shieldl1"
		{component "shieldl1"}
		{thickness 3}
	}
	{Volume "shieldl1"
		{component "shieldl1"}
		{thickness 3}
	}
	; --- end Godny hitbox armor ---
	{component "sticky_body"}

	("armor_medium_custom" turret(10 10 10 10) body(50 15 15 15) body2(50 15 15 15) body3(15 15 15 15))
	("armor_engine"  t(15 15 15 15))
	("armor_mantlet" t(15))
	("ger_5x8_sight")


	("shield" args 15)
	("crew_4_human")

	{boarder
		{anm "driver"
			{forward	{begin	"board_t34_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"emit_t34_hold"} {base "close_driver"}}
		}
		{anm "charger"
			{forward	{begin	"board_su76"}}
			{reverse 	{end	"board_su76" -1}}
		}
		{anm "gunner"
			{forward	{begin	"board_su76"} {end "seat_armor"}}
			{reverse 	{end	"board_su76" -1}}
		}
		{anm "commander"
			{forward	{begin	"board_hummel"} {end "pose_seat_armor_2"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
	}

	(define "crew_human"
		{placer
			{place "%place" {group "crew"} {linkbone "%place"} {turnoff {sensor} {shadow}}}
		}
		{boarder
			{door "%door1"}
			{door "%door2"}
			{link "%door1" "%place" {anm "%place"} {forward putoff} {reverse puton}}
			{link "%door2" "%place" {anm "%place"} {forward putoff} {reverse puton}}
		}
	)

	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner" {visor "main"}}
	}
	{boarder
		{door "emit0"}
		{door "emit1"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}
	("crew_human" place(commander)	door1(emit1))
	("crew_human" place(gunner)	    door1(emit1))


	{extender "inventory"
		{box
			{item "ammo bullet75 gerp apcbc" 20}
			{item "ammo bullet75 gerp fg" 10}
			{item "ammo bullet75 gerp apcr" 4}
			{item "ammo bullet75 gerp heatb" 4}
			{item "ammo mg_mauser belt" 600}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_pak40" filling "ammo bullet75 gerp apcbc" 1}
			("abm_medium")
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "zb53" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
		}

	}

	{mass 24000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.56) len(0.3))
		{Locomotion ("locomotion")
			{maxspeed   24}
			{maxSpeedAtMaxTurn 5}
			{StartTime  25}
			{TurnStart  1.7}
			{TurnTime   15}
			{TurnRadius 10}
    			{TurnStop   0.9}
			{BrakeTime  1}
			{StopTime   2}
			{Gears      0.1 0.2 0.3 1}
			{RearGears  0.3}
		}
		{FuelBag
			{volume 220 }
			{rate	14 }
			{remain 220 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  24}
        	{Slow  24}
    	}
		{DisableMoveWhileFiring}
	}

	{Extension "marder_3h.mdl"}
	{bone "mantlet"
		{speed 0.002}
	}
	{bone "gun_rot"
		{speed 0.002}
	}
}
