{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))

	{collider "tank.light"}
	{props "light" "turret_rotator" "zenite" "vision_vehicle_low" "muzzle_zenite"}
	{targetClass "light_tank"}
	{patherId "tank.light"}
	{tag "diesel_exhaust"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: t60.def) ---
	{volume "body1"	;корпус
		{tags "body"}
		{component "body"}
		{thickness 15	;бока
			{front	35}
			{rear	25}
			{top	15}
			{bottom	10}	;дно и верхн€€ задн€€ деталь
			{right	15}	;гласис
		}
	}
	{volume "body2"	;рубка водител€
		{tags "body"}
		{component "body"}
		{thickness 15
			{front	35}
		;	{top	15}
			{bottom	0.1}	;стык body1 и body2
		}
	}
	{volume "turret1"
		{component "turret"}
		{tags "turret"}
		{able {holed}}
		{thickness 25
		;	{front	25}
		;	{rear	25}
			{top	10}
			{bottom	10}
		}
	}
	{Volume "turret2"
		{tags "turret"}
		{component "turret"}
		{able {holed}}
		{thickness 25
			{front	35}
			{rear	0.1}	;стык turret1 и turret2
			{top	10}
			{bottom	10}
		}
	}
	{volume "mantlet"
		{thickness 35
		;	{front	35}
			{rear	10}	;орудие дает небольшую броню
		}
	}
	{Volume "hole_tur"
		{able clear {hole}}
		{component "turret"}
	}
	{Volume "hole_bod"
		{able clear {hole}}
		{component "body"}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "gun1"
		{tags "gun"}
		{component "gun"}
	}
	{Volume "gun2"
		{tags "gun"}
		{component "gun"}
	}
	; --- end Godny hitbox armor ---
	{volume "body3"
		{tags "body"}
		{component "body"}
		{thickness 15}
	}
	{volume "body4"
		{tags "body"}
		{component "body"}
		{thickness 15}
	}
	("armor_light" turret(15 15 15 10) body(20 15 25 10) body2(15 15 25 10) body3(35 15 25 10) body4(10 15 25 10))
	("armor_mantlet" t(20))
	("armor_engine" t(30 15 25 10))
	("rus_2-5x_sight")

	("crew_2_human")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	{extender "inventory"
		{box
            		{item "bullet20 rus zenite ap" 200}
			{item "bullet20 rus zenite fg" 200}
			{item "ammo dt29_mag" 900}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_tns" filled}
			{charger "gunner"}
			("abm_low")
		}
		{place "mgun"
			{type "mgun_coaxial"}
			{weapon "dt_optic" filled}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}


	{mass 9800}
		{Chassis
			("tank_trace" fx("tracks_sm2") step(0.15) len(0.6))
			{Locomotion ("locomotion")
				{maxspeed   34}
				{maxSpeedAtMaxTurn 5}
				{StartTime   25}
				{TurnStart  1.1}
				{TurnTime  	 14}
				{TurnRadius  7}
    			{TurnStop   0.5}
				{BrakeTime   1}
				{StopTime    2}
				{Gears   0.1 0.2 0.3 1}
				{RearGears  0.25}
			}
			{FuelBag
				{volume 440 }
				{rate	 13 }
				{remain 440 }
				{fuel "fuel"}
			}
		{speed
        	{Normal  34}
        	{Slow  34}
    	}
		}
	{Extension "t60.mdl"}

	{bone "turret"
		{speed 0.003}
	}
	{bone "gun_rot"
		{limits 20 -10}
		{speed 0.002}
	}
}
