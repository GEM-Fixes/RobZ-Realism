{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "heavy" "turret_rotator" "vision_vehicle_maximum" "muzzle_maximum"}
	{tag "diesel_exhaust"}

	; --- Godny hitbox armor (ported from GodnyMod: kv2.def) ---
	{volume "body1"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 75
		;	{front	75}	;нлд
			{rear	70}
			{top	0.1}	;внутренн€€ стенка
			{bottom	40}
			{right	40}	;гласис
		}
	}
	{volume "body2"	;верхн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 75
		;	{front	75}	;мехвод
			{rear	10}	;внутренн€€ стенка мто
			{top	40}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 75
			{front	0.1}	;внутренн€€ стенка
			{rear	60}
			{top	30}
			{bottom	10}
		}
	}
	{volume "turret"	;верхн€€ часть башни
		{tags "turret"}
		{component "turret"}
		{able {holed}}
		{thickness 75
		;	{front	75}
		;	{rear	75}
			{top	40}
			{bottom	40}
		}
	}
	{volume "turret1"	;нижн€€ часть башни
		{tags "turret"}
		{component "turret"}
		{thickness 75
		;	{front	75}
		;	{rear	75}
			{top	0.1}	;внутренн€€ стенка
			{bottom	40}
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "turret"}
	}
	{volume "mantlet"
		{thickness 110
		;	{front	110}
			{rear	20}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	("armor_heavy" turret(75 75 75 35) body(75 75 70 30) body2(40 75 70 30) body3(75 75 70 30))
	("armor_engine"  t(30 75 30 30))
	("armor_mantlet" t(110))
	("rus_2-5x_sight")

	{extender "enumerator"}

	("crew_4_human")
	{placer
		{place "commander" {visor "back"}}
	}
	{boarder
		{anm "left"
			{forward	{begin	"board_Kv-85"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_Kv-85"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))
	("seat_human" place(seat5) bone(seat05) door(emit7)  animation(armor))
	("seat_human" place(seat6) bone(seat06) door(emit8)  animation(armor1))
	("seat_human" place(seat7) bone(seat07) door(emit9)  animation(armor))
	("seat_human" place(seat8) bone(seat08) door(emit10)  animation(armor1))
	("seat_human" place(seat9) bone(seat09) door(emit11)  animation(armor))

	{sensor
		{visor "back"
			{vision "tank_back"}
			{bone "foresight4"}
		}
	}

	{extender "inventory"
		{box
            		{item "ammo bullet152 rus ap" 8}
            		{item "ammo bullet152 rus fg" 28}
            		{item  "ammo dt29_mag" 2100}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "152mm_m10t" filling "ammo bullet152 rus fg" 1}
			("abm_direct_how")
		}
		{place "mgun3"
			{type "mgun_hull"}
			{weapon "dt" filled}
			{foresight "foresight6"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "mgun_rear"}
			{weapon "dt" filled}
			{foresight "foresight4"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
		}

	}
	{mass 52000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.3))
		{Locomotion ("locomotion")
			{MaxSpeed	25}
			{maxSpeedAtMaxTurn 3}
			{StartTime	60}
			{TurnTime	28}
			{TurnStart  2}
		{BrakeTime  3}
		{StopTime   4}
		{TurnRadius 10}
		{TurnStop   1}
		{Gears      0.1 0.18 0.25 1.0}
		{RearGears  0.1 0.2}
		}
		{FuelBag
			{volume 600 }
			{rate	35 }
			{remain 600 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  25}
        	{Slow  25}
    	}
	}

	{Extension "kv2.mdl"}

	{bone "turret"
		{speed 0.0019}
	}
	{bone "gun_rot"
		{speed 0.0005}
	}
}
