{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "heavy" "-turret" "vision_vehicle_maximum" "muzzle_maximum"}

	{extender "enumerator"}

	; --- Godny hitbox armor (ported from GodnyMod: ho-ri_1.def) ---
	{Volume "body1"	;нижн€€ часть корпуса и гласис
		{tags "body"}
		{component "body"}
		{thickness 50
			{front	100}
		;	{rear	50}
			{top	0.1}	;внутренн€€ стенка
			{bottom	20}
			{right	30}	;гласис
		}
	}
	{Volume "body2"	;верхн€€ передн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 50
			{front	100}
			{rear	0.1}	;внутренн€€ стенка
			{top	30}
			{bottom	20}
			{right	75}	;щеки
		}
	}
	{Volume "body3"	;моторное верх (середина корпуса)
		{tags "body"}
		{component "body"}
		{thickness 50
			{front	10}	;стенка моторного
			{rear	10}	;стенка моторного
			{top	30}
			{bottom	20}
		}
	}
	{Volume "body4"	;верхн€€ задн€€ часть корпуса - нижн€€ часть рубки
		{tags "body"}
		{component "body"}
		{thickness 50
			{front	0.1}	;внутренн€€ стенка
		;	{rear	50}
			{top	0.1}	;внутренн€€ стенка
			{bottom	20}
		}
	}
	{volume "body5"	;рубка (верхн€€ часть)
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 100
			{front	150}
			{rear	75}
			{top	30}
			{bottom	0.1}	;внутренн€€ стенка
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "turret"}
	}
	{Volume "mantlet1"
		{tags "gun"}
		{component "gun"}
		{thickness 70
		;	{front	70}
			{rear	0.1}	;внутренн€€ стенка
		}
	}
	{Volume "mantlet2"
		{tags "gun"}
		{component "gun"}
		{thickness 120
		;	{front	120}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	("armor_spa_heavy" armor(125 55 35 20) armor2(125 55 35 20) armor3(125 55 35 20) armor4(125 55 35 20))
	("armor_engine"  t(40 55 35 20))
	("armor_mantlet" t(250))

	("crew_4_human")

	("crew_4_human")
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{boarder
		{anm "left"
			{forward	{begin	"board_Kv"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}

		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	{extender "inventory"
		{box
			{item "ammo bullet105 japl aphe" 25}
			{item "ammo bullet105 japl fg" 27}
			{item "ammo bullet37 jap aphe" 30}
			{item "ammo bullet37 jap fg" 30}
			{item "ammo type97_mag" 3500}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "105mm_type6" filling "ammo bullet105 japl aphe" 1}
			("abm_medium")
		}
		{place "gun2"
			{type "secondary_main"}
			{weapon "37mm_hori" filling "bullet37 jap aphe" 1}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_medium")
			{basic}
		}
		{place "mgun"
			{type "mgun_hull"}
			{weapon "type97_mg" filled}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 71700}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.15))
		{Locomotion ("locomotion")
			{maxspeed   26}
			{maxSpeedAtMaxTurn 2.5}
			{StartTime   50}
			{BrakeTime  2.5}
			{StopTime   3.5}
			{TurnStart  2.5}
			{TurnTime    30}
			{TurnStop     1}
			{TurnRadius   14}
			{Gears     0.1 0.2 0.3 1.0}
			{RearGears 0.1 0.2}
		}
		{FuelBag
			{volume 950 }
			{rate	105 }
			{remain 950 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  26}
        	{Slow  26}
    	}
	}
	{Extension "ho-ri_1.mdl"}
	{bone "gun_rot2"
		{speed 0.001}
	}
	{bone "gun_rot"
		{speed 0.001}
	}
}

