{game_entity
	(include "/properties/cannon_mgun_1.ext")
	{props "vision_cannon_minimum"}
	{simulation {able 1}}

	("armor_light" args 0.7)

	; --- Godny hitbox armor (ported from GodnyMod: mg34_tower.def) ---
	{Volume "touch"
		{able clear {touch}}
	}
	{Volume "body"
		{tags "body"}
		{able{obstacle 0}} ;{blast 0}
		{thickness 2}
		{component "body"}
	}
	{Volume "body1"
		{tags "body"}
		{able{obstacle 0}{blast 0}}
		{thickness 2}
		{component "body"}
	}
	{Volume "body2"
		{tags "body"}
		{able{obstacle 0}{blast 0}}
		{thickness 2}
		{component "body"}
	}
	{Volume "body3"
		{tags "body"}
		{able{obstacle 0}{blast 0}}
		{thickness 2}
		{component "body"}
	}
	{volume "shield" {thickness 10}}
	; --- end Godny hitbox armor ---
	{sensor
		{visor "main"
			{vision "watchtower"}
		}
	}

	{placer	{place "gunner" {visor "main"}}}
	{boarder
		{anm "gunner"
			{forward	{end "pose_mgun_stan1"}}
		}
	}
	{extender "cannon"
		{animation
			{aim ""}
			{reload "mgun_stan_charger1"}
		}
		{move {workers clear} {obstacle "close"}}
		{attack {workers "gunner"} {obstacle "open"}}
	}
	{extender "inventory"
		{box
			{item "ammo mg_mauser drum" 500}
		}
	}
	{Weaponry
		{place "mgun"
			{type "mgun_main"}
			{weapon "mg34_tower" filled}
			{charger "gunner"}
		}
	}

	{Extension "mg34_tower.mdl"}
	{bone "turret"
	      {limits}
	}
	{extender "shield"
		{on}
	}
}
