{game_enitity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{props "vehicle" "armored_car" "tank" "zenite" "turret" "wheeled" "with_gun" "vision_vehicle_low" "muzzle_zenite" "switch_mgun"}
	{targetClass "armoredcar" "ap bullet"}
	{targetSelector "tank"}
	{PatherId "vehicle.small"}

	{extender "enumerator"
		{digit_folder "ger"}
	}
	{extension "crew.ext"}
	
	; --- Godny hitbox armor (ported from GodnyMod: sdkfz222.def) ---
	{volume "body1"	;верхн€€ часть бо
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	15}
			{bottom	5}
		}
	}
	{volume "body2"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	15}
			{bottom	5}
		}
	}
	{Volume "body3"	;дно, рама
		{tags "body"}
		{component "body"}
		{thickness 8}
	}
	{Volume "body4"	;моторное
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	5}
			{bottom	5}
		}
	}
	{volume "turret"
		{thickness 8
			{front	15}
		}
	}
	{Volume "Gun"
		{tags "no_target"}
		{able {Visible 0} {Obstacle 0} {Contact 0}}
		{thickness 10}
	}
	{volume "engine"
		{thickness 10}
	}
	{Volume "box"
		{component "box"}
		{thickness 6}
	}
	; --- end Godny hitbox armor ---
	{Volume "doorturret1"
		{thickness 3}
	}
	{Volume "doorturret"
		{thickness 3}
	}
	("armor_medium" args 1.2)

	{extender "inventory"
		{box
			{item "ammo mg_mauser belt" 700}
            		{item "ammo bullet20 ger zenite ap" 80}
            		{item "ammo bullet20 ger zenite apcr" 40}
	    		{item "ammo bullet20 ger zenite fg" 80}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_kwk30" filling "ammo bullet20 ger zenite" 10}
			{charger "gunner"}
			("abm_zenite")
		}
		{place "mgun"
			{type "mgun_coaxial"}
			{weapon "mg34_optic" filled}
			{LinkBone "mgun"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}
	{sensor
		{visor "main"
			{bone "gun"}
		}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{mass 4800}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	41}
	  		{maxSpeedAtMaxTurn 6}		
			{StartTime	25}
			{BrakeTime	1.5}	
			{StopTime	3}
			{TurnRadius	5}
     			{Gears  0.1 0.2 0.3 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 110}
			{rate	10} 
			{remain 110 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  41}
        	{Slow  41}
    	}
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}
	{Extension "sdkfz222.mdl"}
	{bone "turret"
		{speed 0.005}
	}
	{bone "gun_rot"
		{speed 0.003}
	}
}
