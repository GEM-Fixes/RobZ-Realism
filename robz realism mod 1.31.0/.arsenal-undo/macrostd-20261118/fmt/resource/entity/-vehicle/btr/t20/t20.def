	{patherId "tank.light"}
 {tag "heavy_tow"}

	
	("armor_medium" turret(0) body(10 10 10 7))
	("armor_engine"  t(10 10 10 7))

	; --- Godny hitbox armor (ported from GodnyMod: t20.def) ---
