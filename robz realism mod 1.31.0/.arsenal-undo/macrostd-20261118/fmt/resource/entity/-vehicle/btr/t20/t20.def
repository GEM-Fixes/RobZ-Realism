		;	{bottom	7}
		}
	}
	{volume "body2"	;корпус под кабиной, гласис
		{tags "body"}
		{component "body"}
		{thickness 7
			{front	10}
		;	{rear	7}	;стенка моторного
			{top	0.1}
			{bottom	17}	;днище усилено 7+10мм?
		;	{right	7}
		}
	}
	{volume "body3"	;нижн€€ задн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 7
			{front	0.1}
		;	{rear	7}
			{top	0.1}
			{bottom	17}	;днище усилено 7+10мм?
		;	{right	7}
		}
