{game_entity
	;© 2009 Zeke Wolff & Ngvede.
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{collider "tank.heavy"}
	{props "medium" "-turret" "opened" "vision_vehicle_high" "muzzle_maximum_nodust" "gun_mode_change_art"}


	{PatherId "tank"}
	;{targetSelector "tank_sup"}


        {extender "enumerator"}



	{Volume "Body1"
		{tags "body"}
		{component "body"}
	}
	{Volume "Body2"
		{tags "body"}
		{component "body"}
	}

	{volume "turret"
		{tags "turret"}
		{component "turret"}
	}
	
	("armor_light" turret(20 20 20 20) body(40 20 20 10))
	("armor_engine"  t(10 32 32 20))

	("crew_4_human")
	
	{boarder
		{anm "left"
			{forward	{begin	"board_kv"} {end "seat_willysat_driver"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "seat_willysat_driver"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
	}

	("crew_human" place(commander)	door1(emit1) door2(emit2) visor(driver))
	("crew_human" place(driver)		door1(emit1) door2(emit2) visor(driver))
	("crew_human_visible" place(charger) 	door1(emit1) door2(emit2) visor(main))
	("crew_human_visible" place(gunner)	door1(emit1) door2(emit2) visor(main))
	
	{placer 
		{place "charger" {openForCrush 0}}
		{place "gunner" {openForCrush 0}}
	}

	{extender "inventory"
		{box
			{item "ammo bullet149_ita fg" 20}

		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{weapon "149mm_obice_vet" filling "bullet149_ita fg" 3}
			{Rotate}
			{StationaryFiring}
			("abm_howitzer")
		}
	}	
	{mass 18300}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.4) len(0.4))
		{Locomotion ("locomotion")
			{maxspeed   22}
			{maxSpeedAtMaxTurn 4.5}
			{StartTime  30}
			{TurnStart  1.8}			
			{TurnTime   17}
			{TurnRadius 9} 
    		{TurnStop   0.5}
			{BrakeTime  1}
			{StopTime   2}
			{Gears  0.1 0.2 0.3 1}
			{RearGears   0.25}
		}
		{FuelBag
			{volume 230 }	
			{rate	24 }   
			{remain 230 }
			{fuel "fuel"}
		}
		{speed
        	{Normal  22}
        	{Slow  22}
    	}
        {DisableMoveWhileFiring}

	}

	{Extension "m149.mdl"}

        {bone "turret"
		{limits -10 10}
		{speed 0.0005}
	}
	{bone "gun_rot"
		;{limits -45 5}
		{speed 0.0005}
	}
}
