{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "turret_rotator" "vision_vehicle_medium" "muzzle_medium"}
	
	{volume "body1"
		{component "body"}
		{tags "body"}
	}
	{volume "body2"
		{component "body"}
		{tags "body"}
	}
	{volume "engine"
		{component "engine"}
	}
	{Volume "gun"
		{component "gun"}
		{tags "gun"}
	}
	{Volume "mantlet"
		{component "mantlet"}
		{tags "mantlet"}
	}
	{Volume "turret"
		{component "turret"}
		{tags "turret"}
	}
	
	("armor_medium" turret(50 25 25 10) body(50 25 25 22))
	("armor_engine"  t(25 25 20 22))
	("armor_mantlet" t(50))
	("shield" args 10)

	
	{extender "shield"
		{on}
	}
	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldl4" {tags "shield"}}
	{component "shieldl5" {tags "shield"}}
	{component "shieldl6" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}
	{component "shieldr4" {tags "shield"}}
	{component "shieldr5" {tags "shield"}}
	{component "shieldr6" {tags "shield"}}
	{component "shieldr7" {tags "shield"}}
	{extender "enumerator"
		{digit_folder "ger"}
	}
	
	{sensor
		{visor "hullmg"
			{bone "foresight4"}
			{vision "tank_driver"}
		}
	}
	("crew_5_human")
	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
	}
	{extender "inventory"
		{box
            		{item "ammo bullet75_hun ap" 35}
			{item "ammo bullet75_hun fg" 25}
            		{item "ammo gabauer_belt" 3150}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_41m_vet" filling "ammo bullet75_hun ap" 1}
			("abm_veteran")
		}
		{place "mgun1"
			{type "mgun_hull"}
			{weapon "gebauer" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
		}
		{place "mgun2"
			{type "mgun_coaxial"}
			{weapon "gebauer_optic" filled}
			{foresight "foresight5"}
			("abm_mgun")
            			{basic}
		}
	}
	{mass 19200}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1))
		{Locomotion ("locomotion")
			{MaxSpeed   32}
			{maxSpeedAtMaxTurn 11}
			{StartTime 30}
			{TurnStart  1.7}			
			{TurnTime 18}
			{TurnRadius 8} 
    		{TurnStop   0.7}
			{BrakeTime  1.5}
			{StopTime   2.5}
			{Gears 0.1 0.25 0.75}
			{RearGears  0.15}		
		}
		{FuelBag
			{volume 165 }	
			{rate	40 }   
			{remain 165 }
			{fuel "fuel"}
		}
		{speed
			{Normal  10}
			{Slow  16}
		}
	}
	{Extension "turan2.mdl"}
	{bone "turret"
		{speed 0.0045} 
	}
	;("ger_1_sight")
}
