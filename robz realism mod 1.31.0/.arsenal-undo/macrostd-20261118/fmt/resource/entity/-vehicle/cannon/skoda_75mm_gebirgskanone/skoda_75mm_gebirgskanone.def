{entity
	(include "/properties/cannon.ext")
	{props "vehicle" "cannon" "cannon_small" "wheeled" "vision_cannon_medium" "round_sandbag2" "muzzle_medium" "gun_mode_change" "medium_weapons"}
	
{PatherID "cannon.small"}
	("armor_medium")
	{collider "cannon_small"}

	("wheel" args "wheelright")
	("wheel" args "wheelleft")

	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward	{end "pose_pak40_gunlayer" 10}}
		}
		{anm "commander"
			{forward	{end "pose_pak40_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon1_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon1_right" 10}}
		}
	}
	(mod "mp" 
		("crew_human" place(commander1)		bone(commander1)		door(emit2) animation(commander1))
		("crew_human" place(commander2)		bone(commander2)		door(emit3) animation(commander2))
		("crew_human" place(driver3)		bone(driver3)			door(emit3) animation(driver3))
		("crew_human" place(driver4)		bone(driver4)			door(emit4) animation(driver4))
		{boarder
			{anm "commander1"
				{forward	{end "pose_squat_watch_binocular" 10}}
			}
			{anm "commander2"
				{forward	{end "pose_m8_charger" 10}}
			}
			{anm "driver3"
				{forward {end "mgun_browning_driver_l" 10}}
			}
			{anm "driver4"
				{forward {end "mgun_browning_driver_r" 10}}
			}
		}
		{placer
			{place "commander1" {group "crew"}}
			{place "commander2" {group "crew"}}
		}
	)

	{extender "inventory"
		{box
			{item "bullet75 gerlg fg" 6}
			{item "bullet75 gerlg heat" 5}
			{item "sandbag_kit2"}
		}
	}

	{Weaponry
		{place "gun"
			{weapon "skoda_75mm_gebirgskanone" filling "bullet75 gerlg fg" 1}
			{Rotate}
			("abm_field_gun")
		}
		{place "gun1_2"
                        {type "gun_change_arty"}
			{weapon "skoda_75mm_gebirgskanone_2"}
			{basic}
	                {Rotate}
			{charger "gunner"}
			{StationaryFiring}
			{Rotate}
			("abm_howitzer")
		}
	}
	{mass 800}
	{Extension "skoda_75mm_gebirgskanone.mdl"}
	(include "/properties/selection/cannon.inc" scale(0.7))
	{bone "basis"
		{limits}
		{speed 0.0007}
	}
	{bone "gun_rot"
		{speed 0.0005}
	}

        {extender "cannon"
		{animation
			{switch "close"}
			{move "cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim "cannon_pak40_gunlayer" ""}
			{fire  "Cannon_gunlayer_fire-alert" "cannon_zis3_charger_fire"}
			{reload  "" "cannon_pak40_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		(mod "mp" {rotate_ik_Limit 12})
	}

	
	{Chassis "track"
		("car_trace" fx("tracewheel05") step(0.07) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("loco_small")
	}
	}
