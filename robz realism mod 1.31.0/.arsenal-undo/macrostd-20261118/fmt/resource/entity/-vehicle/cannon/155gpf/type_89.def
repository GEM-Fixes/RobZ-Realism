{game_entity
	(include "/properties/cannon.ext")
	{props "vehicle" "cannon" "wheeled" "vision_cannon_maximum" "round_sandbag2" "muzzle_maximum" "gun_mode_change_art"}
	{PatherID  "cannon.large"}
	; --- Godny hitbox armor (ported from GodnyMod: 155gpf.def) ---
	
	; --- end Godny hitbox armor ---
	("armor_heavy")
	("wheel" args "wheelright")
	("wheel" args "wheelleft")

	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward	{end "pose_155gpf_gunlayer" 10}}
		}
		{anm "commander"
			{forward	{end "pose_155gpf_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon_right" 10}}
		}

	}

	{extender "inventory"
		{box
			{item "bullet150 jap fg" 6}
		}
	}
	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "150mm_type_89" filling "bullet150 jap fg" 3}
			{Rotate}
			{StationaryFiring} 
			{charger "gunner"}
			("abm_howitzer")
		}
		{place "gun1_2"
			{type "gun_change_direct"}
			{weapon "150mm_type_89_2" filled}
			{basic}
			{rotate}
			{charger "gunner"}
			("abm_field_gun")
		}
	}
	{mass 4000}
	{Extension "155gpf.mdl"}
	(include "/properties/selection/cannon.inc"  scale(0.7))

	{bone "basis"
		{limits}
		{speed 0.005}
	}
	{bone "turret"
		{limits -5 5}
		{speed 0.0005}
	}
	{bone "gun_rot"
		{limits -6 45}
		{speed 0.0005}
	}

	{extender "cannon"
		{animation
			{switch "close"}
			{move	"cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim	"cannon_155gpf_gunlayer" ""}
			{fire	"Cannon_gunlayer_fire-alert" "cannon_zis3_charger_fire"}
			{reload	"" "Cannon_155gpf_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
		(mod "mp" {rotate_ik_Limit 0})
	}
	{Chassis "track"
		("car_trace" fx("tracks_sm") step(0.4) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("loco_big")
	}
	{sensor
		{visor "main"
			{vision "cannon_main"}
		}
	}
;	{bone "basis"
;    		{speed 0.003}
;    	}
	{bone "turret"
		{speed 0.0005}
	}
	{bone "gun_rot"
		{speed 0.0005}
	}
	(mod "mp"
		{brain
			{properties
				{fire_mode hold}
			}
		}
	)
}