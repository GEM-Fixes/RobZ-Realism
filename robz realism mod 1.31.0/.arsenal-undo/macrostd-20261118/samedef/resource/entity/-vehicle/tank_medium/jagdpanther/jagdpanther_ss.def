{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.heavy"}
	{props "heavy" "-turret" "vision_vehicle_high" "muzzle_large_sides" "vehicle_camo_2var2"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}

	; --- Godny hitbox armor (ported from GodnyMod: jagdpanther.def) ---
	{volume "body1"	;нижн€€ часть корпуса
		{tags "body"}
		{component "body"}
		{thickness 40	;нижний борт 40мм
			{front	80}	;влд
			;	{rear	40}
			{top	0.1}	;внутренн€€ стенка
			{bottom	30}
			{right	60}	;нлд
		}
	}
	{volume "body2"	;верхн€€ часть корпуса - рубка
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 50
			{front	80}
			{rear	40}
			{top	25}
			{bottom	17}
			{right	10}	;внутренн€€ стенка мто
		}
	}
	{volume "body3"	;моторное верх
		{tags "body"}
		{component "body"}
		{thickness 50
			{front	10}	;внутренн€€ стенка
			{rear	40}
			{top	17}
			{bottom	17}
		}
	}
	{Volume "hole_man"
		{able clear {hole}}
		{component "body"}
	}
	{volume "mantlet"
		{thickness 100
			;	{front	100}
			{rear	15}	;орудие дает небольшую броню
		}
	}
	{volume "engine"
		{thickness 10}
	}
	; --- end Godny hitbox armor ---
	("armor_spa_heavy" armor(80 50 40 25))
	("armor_mantlet" t(100))
	("shield" args 10)
	("ger_5x8_sight")

	{extender "shield"
		{on}
	}

	{component "shieldl1" {tags "shield"}}
	{component "shieldl2" {tags "shield"}}
	{component "shieldl3" {tags "shield"}}
	{component "shieldl4" {tags "shield"}}
	{component "shieldl5" {tags "shield"}}
	{component "shieldr1" {tags "shield"}}
	{component "shieldr2" {tags "shield"}}
	{component "shieldr3" {tags "shield"}}
	{component "shieldr4" {tags "shield"}}
	{component "shieldr5" {tags "shield"}}

	("crew_4_human")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_right"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	{sensor
		{visor "main"
			{vision "tank_main-h"}
			{bone "gun"}
		}
	}

	;	("gunner_visible")

	("seat_human" place(seat1) bone(seat01) door(emit5)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit6)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit3)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit4)  animation(armor1))

	{extender "inventory"
		{box
			{item "bullet88 gerl apcbc" 29}
			{item "bullet88 gerl fg" 27}
			{item "bullet88 gerl apcr" 4}
			{item "bullet88 gerl heat" 5}
			{item "ammo mg_mauser belt" 600}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_pak43" filling "ammo bullet88 gerl apcbc" 1}
			("abm_high")
		}
		{place "mgun"
			{type "mgun_hull"}
			{weapon "mg34_optic" filled}
			{foresight "foresight3"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 45500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.18))
		{Locomotion ("locomotion")
			{MaxSpeed   34}
			{maxSpeedAtMaxTurn 4}
			{StartTime  50}
			{TurnStart  1.8}
			{TurnTime   20}
			{TurnRadius 10}
			{TurnStop   1}
			{BrakeTime  2}
			{StopTime   3}
			{Gears   0.1 0.2 0.3 1}
			{RearGears  0.12}
		}
		{FuelBag
			{volume 720}
			{rate	75}
			{remain 720}
			{fuel "fuel"}
		}
		{speed
			{Normal  34}
			{Slow  34}
		}
	}

	{Extension "jagdpanther.mdl"}

	{bone "gun_rot1"
		{speed 0.001}
	}
	{bone "turret"
		{speed 0.001}
	}
	{bone "mgun"
		{speed2 80}
	}
}
