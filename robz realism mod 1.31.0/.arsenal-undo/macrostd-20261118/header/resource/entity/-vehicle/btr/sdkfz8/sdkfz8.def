(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "vehicle" "armored_car" "tank" "turret" "turret_rotator" "wheeled_8" "explosion_throw_crew" "vision_vehicle_medium" "muzzle_large_nodust" "gun_mode_change"}

	{Extension "crew.ext"}

	(define "abm_howitzer"
		("accuracy_by_motion"
			max_linear(10) accuracy_by_linear(0.9)
			max_angular(4) accuracy_by_angular(0.9)
			disorder_time(1.2) order_time(1.0)
		)
	)
	{extender "enumerator"
		{digit_folder "ger"}
	}
	{sensor
		{visor "main"
			{vision "tank_main_ger_5x8"}
			{bone "turret"}
		}
	}

	; --- Godny hitbox armor (ported from GodnyMod: sdkfz8.def) ---
	("vol_sticky_grenade_target" name(sticky))
	{volume "body"	;рама и дно
		{tags "body"}
		{component "body"}
		{thickness 8
			;	{front	8}
			;	{rear	8}
			{top	6}
			{bottom	6}
		}
	}
	{volume "body1"	;моторное
		{tags "body"}
		{component "body"}
		{thickness 8
			{front	14}
			;	{rear	8}
			;	{top	8}
			{bottom	6}
		}
	}
	{volume "body2"	;кабина
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			{front	0.1}	;внутренняя стенка
			;	{rear	8}
			;	{top	8}
			{bottom	6}
		}
	}
	{volume "body3"	;водитель
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			;	{front	8}
			;	{rear	8}
			{top	6}
			{bottom	0.1}	;внутренняя стенка
		}
	}
	{volume "body4"	;водитель
		{tags "body"}
		{component "body"}
		{able {holed}}
		{thickness 8
			;	{front	8}
			;	{rear	8}
			{top	6}
			{bottom	0.1}	;внутренняя стенка
		}
	}
	{volume "body5"	;пол кузова
		{tags "body"}
		{component "body"}
		{thickness 3}
	}
	("vol_body_hole_only" name(hole_bod1))
	("vol_body_hole_only" name(hole_bod2))
	{Volume "Gun"
		{thickness 10}
		{tags "no_target"}
		{able {Visible 0} {Obstacle 0} {Contact 0}}
	}
	{volume "turret"
		{thickness 10}
	}
	{volume "engine"
		{thickness 2}
	}
	{volume "inventory"
		{thickness 2}
	}
	{volume "detail3"
		{tags "explosive"}
		{able clear {bullet} {blast} {contact} {NoWoundDecal}}
		{thickness 2}
	}
	; --- end Godny hitbox armor ---
	{component "Gun"
		{RepairTime 20}
	}

	{extender "shield"
		{on}
	}

	{volume "shield"
		{component "gun"}
		{tags "gun"}
		{thickness 25}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")

	{component "sticky_body"}

	("armor_medium" args 1.0)

	{extender "inventory"
		{box
			{item "bullet88 ger apcbc" 16}
			{item "bullet88 ger fg" 15}
			{item "bullet88 ger apcr" 4}
			{item "bullet88 ger heat" 5}
		}
	}

	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_flak37" filling "bullet88 ger apcbc" 1}
			("abm_low_v2")
		}
		{place "gun1_2"
			{type "gun_change_arty"}
			{weapon "88mm_flak37_2"}
			{basic}
			{StationaryFiring}
			("abm_howitzer")
		}
	}

	{mass 14700}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	28}
			{maxSpeedAtMaxTurn 6}
			{StartTime	20}
			{BrakeTime	1.5}
			{StopTime	2.5}
			{TurnRadius	8}
			{Gears  0.1 0.2 0.35 1}
			{RearGears  0.25}
		}
		{FuelBag
			{volume 250}
			{rate	14}
			{remain 250}
			{fuel "fuel"}
		}
		{speed
			{Normal  28}
			{Slow  28}
		}
		; left track must be first
		("tank_trace" fx("tracks_mid") step(0.5) len(0.86) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
	}

	{Extension "sdkfz8.mdl"}

	(mod "mp"
		{brain
			{properties
				{fire_mode hold}
			}
		}
	)

	{bone "gun_rot1"		;horizontal gun
		{limits -120 120}	;gun min right to max left
		{speed 0.002}
	}
	{bone "gun_rot"			;vertical gun
		{speed 0.0005}
	}
}
