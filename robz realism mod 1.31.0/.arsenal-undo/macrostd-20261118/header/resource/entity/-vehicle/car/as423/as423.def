(include "/properties/robz/volumes.inc")
{game_entity
	;© 2011 Zeke Wolff & Ngvede.
	(include "/properties/car.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{props "vehicle" "car" "wheeled" "turret" "with_gun" "turn_over" "explosion_throw_crew" "muzzle_minimum" "vision_vehicle_medium"}
	{able "emit_passengers_on_enemy"}
	{PatherId "vehicle.small"}
	("armor_medium" args 1.0)
	{collider "truck"}

	("vol_body_plate_lower" name(body1) mm(15))
	("vol_body_plate_lower" name(body2) mm(15))
	("vol_body_plate_lower" name(body3) mm(15))
	{volume "body4"
		{tags "body"}
		{component "engine"}
		{thickness 15		}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")
	{boarder
		{anm "driver"
			{forward	{begin	"board_tank_left"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "gunner"
			{forward	{begin	"board_SdKfz251-1"} {end "cannon_m5_gunlayer"}}
			{reverse 	{end	"emit_body" 1}}
		}
		{anm "charger"
			{forward	{begin	"board_SdKfz251-1"} {end "cannon_m5_gunlayer"}}
			{reverse 	{end	"emit_body" 1}}
		}
		{anm "commander"
			{forward	{begin	"board_tank_left"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "passenger1"
			{forward	{begin	"board_tank_left"} {end "seat_passenger"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "passenger2"
			{forward	{begin	"board_tank_left"} {end "seat_passenger"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
	}
	(define "crew_human_no_bone"
		{placer
			{place "%place" {group "crew"} {linkbone "%place"} {turnoff {sensor} {shadow}}}
		}
		{boarder
			{door "%door"}
			{link "%door" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		}
	)
	{placer
		{place "driver" {visor "driver"}}
		{place "gunner" {visor "main"}}
		{place "charger" {visor "main"}}
		{place "commander" {visor "mgun1"}}
	}
	("crew_human_no_bone" place(driver)		door(emit1) group(crew)		animation(driver))
	("crew_human_no_bone" place(gunner)		door(emit2) group(crew)	    animation(gunner))
	("crew_human_no_bone" place(charger)	door(emit2) group(crew)	    animation(charger))
	("crew_human_no_bone" place(commander)	door(emit3) group(crew)		animation(commander))
	("crew_human_no_bone" place(passenger1) bone(seat01) door(emit4) 	animation(passenger1))
	("crew_human_no_bone" place(passenger2) bone(seat02) door(emit5) 	animation(passenger2))
	{volume "crew"
		{able {contact_ground 0}}
	}
	{sensor
		{visor "driver"
			{vision "human"}
			{bone "visor2"}
		}
		{visor "main"
			{vision "human"}
			{bone "foresight1"}
		}
		{visor "mgun1"
			{vision "human"}
			{bone "visor4"}
		}
	}
	{extender "inventory"
		{box
			{item "repair_kit"}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "can" filled}
			{item "ammo bredam38_belt" 1100}
			{item "bullet47_ita ap" 20}
			{item "bullet47_ita fg" 20}
		}
	}
	{Weaponry
		{place "gun"
			{weapon "47mm_m47_40" filling "bullet47_ita ap" 1}
			{foresight "foresight1"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_low")
		}
		{place "mgun1"
			{weapon "breda_38" filled}
			{foresight "foresight4"}
			{type "mgun_hull"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun1"}
			{LinkAnimation "off"}
			{basic}
		}
	}
	{mass 4500}
	{Chassis
		{Locomotion ("locomotion")
			{TurnRadius	4}
			{maxspeed   36}
			{StartTime 16}
			{maxSpeedAtMaxTurn 17}
		}
		{FuelBag
			{volume	145}
			{rate	4.8}
			{remain	145}
			{fuel "fuel"}
		}
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}
	{Extension "as423.mdl"}
;("turret_speed_medium")
}
