(include "/properties/robz/volumes.inc")
{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	{Extension "sdkfz251_10.mdl"}
	{extension "crew1.ext"}
	{props "vehicle" "armored_car" "tank" "turret" "wheeled" "explosion_throw_crew" "vision_cannon_medium" "muzzle_minimum" "open_door2"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}
	("vol_body_plate_lower" name(body) mm(15))
	("vol_body_plate_lower" name(body2) mm(15))
	("vol_body_plate_lower" name(body3) mm(15))
	("vol_body_plate_lower" name(body4) mm(15))
	("vol_body_plate_lower" name(body5) mm(15))
	("vol_body_plate_lower" name(body6) mm(15))
	("vol_body_plate_lower" name(body7) mm(15))
	("vol_body_plate_lower" name(body8) mm(15))
	("vol_body_plate_lower" name(body9) mm(15))
	("vol_body_plate_lower" name(body10) mm(15))
	("vol_body_plate_lower" name(body11) mm(15))
	("vol_body_plate_lower" name(body12) mm(15))
	("vol_body_plate_lower" name(body13) mm(15))
	{volume "engine"
		{tags "engine"}
		{component "engine"}
		{thickness 15}
	}
	("vol_body_plate" name(body_l) mm(10))
	("vol_body_plate" name(body_r) mm(10))
	("vol_body_plate" name(mgun_turret) mm(10))
	{Volume "turret"
		{tags "turret"}
		{component "turret"}
		{thickness 15}
	}
	{component "body"
		{RepairTime 15}
	}
	{component "engine"
		{RepairTime 20}
	}
	{component "turret"
		{RepairTime 10}
	}
	{component "gun"
		{RepairTime 10}
	}
	("armor_medium" args 1.0)
	{Placer
		{place "attach01"
			{entity "can"}
			{Linkbone "attach01"}
			{handlebone "basis"}
			{obstacle disable}
		}
	}
	(define "define_place_squat_lie_ger_bullet"
		{placer
			{place "%place"
				{linkbone "%place"}
				{attach squat_lie}
				{turnoff {shadow}}
				{obstacle disable}
			}
		}
		{Volume "%place"
			{tags "attach" "attach_%place"}
			{able clear {ger_bullet 0} {touch 1}}
		}
	)
	{extender "inventory"
		{box
			{item "bullet37_ger ap" 100}
			{item "bullet37_ger apcr" 8}
			{item "bullet37_ger fg" 52}
			{item "7x57" "ammo" 1000}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_pak35" filled}
			{RestoreIKAfterAim}
			{charger "gunner"}
			("abm_low_v2")
			{basic}
		}
		{place "mgun"
			{type "mgun_main"}
			{weapon "mg34" filled}
			{LinkBone "mgun1"}
			{LinkAnimation "off"}
			{charger "gunner1"}
			{gunner "gunner1"}
			{foresight "foresight3"}
			("abm_mgun")
			{basic}
		}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks")
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	33}
			{maxSpeedAtMaxTurn 16}
			{StartTime 20}
			{BrakeTime	1.5}
			{StopTime	2.5}
			{TurnRadius	8}
		}
		{FuelBag
			{volume 160}
			{rate	40}
			{remain 160 }
			{fuel "fuel"}
		}
		{speed
			{Normal  12}
			{Slow  20}
		}
		; left track must be first
		("tank_trace" fx("tracks_mid") step(0.5) len(0.86) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
	}
	{mass 8500}
	("turret_speed_medium35")
	("ger_1x11_sight_visor1")
}
