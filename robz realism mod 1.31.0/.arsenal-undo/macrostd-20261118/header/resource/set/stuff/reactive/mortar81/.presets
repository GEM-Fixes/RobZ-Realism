(include "/properties/robz/weapon.inc")

(define "fg_minimum+"
	; anti-tank
	{damage blastwave
		{energy (* %0 1.15)}
		{area 0.25 0.35}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.35}
		{area (* 0.6 (+ %0 5)) (* 1 (+ %0 5))}
	}
	{damage add blastwave
		{energy 0.1}
		{area (* 1.2 (+ %0 5)) (* 1.2 (+ %0 5))}
	}
)



(define "fg_heavy_v2"
	; anti-tank
	{damage blastwave
		{energy %0}
		{area 1 2}
	}
	; anti-apc
	{damage add blastwave
		{energy (* %0 0.2)}
		{area 5.5 6}
	}
	; anti-personel
	{damage add blastwave
		{energy 1.5}
		{area (* 0.65 (+ %0 5)) (* 1.0 (+ %0 5))}
	}
	{damage add blastwave
		{energy 0.1}
		{area (* 1.2 (+ %0 5)) (* 1.2 (+ %0 5))}
	}
)
