; actionbar/* : keys this mod changed or added
; mod part
; changed from vanilla
{"hedgehog" "Deploy a anti-vehicle hedgehog"}
{"hedgehog"
{"usage" "After clicking the button, click the location to place an anti-vehicle hedgehog.(only stops light tanks and smaller)"}
}
; new
{"smoke_launcher" "Smoke launcher"}
{"smoke_launcher"
{"action" "Will launch a smoke grenade from the selected vehicle"}
}
{"enginetoggle" "Engine ON/OFF toggle"}
{"enginetoggle"
{"action" "Toggle the engine on and off"}
}
{"call_84_smoke" "25LB Smoke Barrage"}
{"call_84_smoke"
{"action" "Click once in position to call off map battery of 8 25LB guns each firing 3 smoke shells each"}
}
{"hatch" "Commander mode"}
{"hatch"
{"action" "Switches the commander in or out of the hatch"}
{"usage" "Has three modes. up: commander is always up. down: commander is always down. active: commander goes down under fire, but is otherwise up"}
}
{"gun_mode" "Direct/Indirect fire mode"}
{"gun_mode"
{"action" "Switch the main gun to direct or indirect firemode"}
{"usage" "After switching gun use the direct / indirect main gun in the secondary weapon slot."}
}
{"burst_mode" "Burst/full auto fire mode"}
{"burst_mode"
{"action" "Switch the main gun(autocannon) and MGs from full auto to burst mode"}
{"usage" "For full auto/burst mode: Forces the gun to use bursts or allow full auto when firing"}
}
{"trench_bighole" "Big foxhole"}
{"trench_bighole"
{"action" "Build a foxhole big enough to fit several soldiers (to place: hold right mouse button and drag in the direction you want it to face)"}
}
{"trench_deep" "Deep foxhole"}
{"trench_deep"
{"action" "Build a deep foxhole for one soldier to sit in (to place: hold right mouse button and drag in the direction you want it to face)"}
}
{"trench_low" "Shallow foxhole"}
{"trench_low"
{"action" "Build a shallow foxhole for one soldier to lie in (to place: select soldiers and click anywhere and they will build to individual place and orientation.)"}
}
{"scrape" "Shallow foxhole"}
{"scrape"
{"action" "Build a shallow foxhole for one soldier to lie in (to place: select soldiers and click anywhere and they will build to individual place and orientation.)"}
}
{"trench_long" "Long trench"}
{"trench_long"
{"action" "Build a long trench for several soldiers (to place: hold right mouse button and drag in the direction you want it to face)"}
}
{"tunnel" "Tunnel"}
{"tunnel"
{"action" "Build a tunnel 300m in length to appear behind the enemy. One directional, enter one side building point and go to the other, then exit. (to place: hold right mouse button and drag in the OPPOSITE direction you want it to face)"}
}
{"tree_line" "Camouflaged Trees"}
{"tree_line"
{"action" "Build a line of 5 trees with camoflauged positions up high. (to place: hold right mouse button and drag in the direction you want it to face)"}
}
{"hedgehog_big" "Deploy a anti-tank hedgehog"}
{"hedgehog_big"
{"usage" "After clicking the button, click the location to place an anti-tank hedgehog. (hold shift and left click to deploy in a queue)"}
}
